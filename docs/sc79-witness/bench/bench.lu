//! sc79 cost witness, not a test: median native time per call of
//! `p256.verify` (the baseline), `rsa.verify_pkcs1` at 2048 and 4096
//! bits (SHA-256, e = 65537), `rsa.verify_pss` at 2048 bits and
//! `p384.verify_der` (SHA-384). One warm-up batch of 32 calls per
//! function, then five timed batches of 32, the functions interleaved
//! batch by batch so host drift lands on all of them. The inputs are
//! the first valid case of each vendored Wycheproof file (tcIds
//! 1, 1, 1 and 1); the P-256 signature is made by
//! `p256.sign` before any timing. Run against the branch's own `std/`
//! with `wolf run --std-root`, under taskset.

use std.hex
use std.time
use std.x.crypto.p256
use std.x.crypto.p384
use std.x.crypto.rsa

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn median(xs: List[int]) -> int {
    for x in xs {
        var below: int = 0
        var at_or_below: int = 0
        for y in xs {
            if y < x {
                below = below + 1
            }
            if y <= x {
                at_or_below = at_or_below + 1
            }
        }
        if 2 * below < xs.len && 2 * at_or_below > xs.len {
            return x
        }
    }
    0
}

fn name(which: int) -> str {
    if which == 0 {
        return "p256.verify"
    }
    if which == 1 {
        return "rsa2048.verify_pkcs1"
    }
    if which == 2 {
        return "rsa4096.verify_pkcs1"
    }
    if which == 3 {
        return "rsa2048.verify_pss"
    }
    "p384.verify_der"
}

struct In {
    p256_pk: List[byte],
    p256_msg: List[byte],
    p256_sig: List[byte],
    k2048: rsa.PublicKey,
    m2048: List[byte],
    s2048: List[byte],
    k4096: rsa.PublicKey,
    m4096: List[byte],
    s4096: List[byte],
    mpss: List[byte],
    spss: List[byte],
    p384_pk: List[byte],
    p384_msg: List[byte],
    p384_sig: List[byte],
}

fn call(which: int, i: In) -> bool {
    if which == 0 {
        return p256.verify(i.p256_pk, i.p256_msg, i.p256_sig)
    }
    if which == 1 {
        return rsa.verify_pkcs1(i.k2048, rsa.hash_sha256(), i.m2048, i.s2048)
    }
    if which == 2 {
        return rsa.verify_pkcs1(i.k4096, rsa.hash_sha256(), i.m4096, i.s4096)
    }
    if which == 3 {
        return rsa.verify_pss(i.k2048, rsa.hash_sha256(), i.mpss, i.spss, 32)
    }
    p384.verify_der(i.p384_pk, i.p384_msg, i.p384_sig)
}

fn batch(which: int, i: In) -> int {
    let t0 = time.monotonic_ns()
    var ok: int = 0
    var k: int = 0
    while k < 32 {
        if call(which, i) {
            ok = ok + 1
        }
        k = k + 1
    }
    let t1 = time.monotonic_ns()
    if ok != 32 {
        print("FAIL bench-verdict {name(which)}")
    }
    t1 - t0
}

fn main() -> int {
    let d = bytes_of("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")
    let pmsg = "sample".bytes()
    let k2 = rsa.parse_public_key(
        bytes_of(
            "",
        ),
    ) else |_| {
        return 2
    }
    let k4 = rsa.parse_public_key(
        bytes_of(
            "",
        ),
    ) else |_| {
        return 2
    }
    let i = In {
        p256_pk: p256.public_key(d),
        p256_msg: copy pmsg,
        p256_sig: p256.sign(d, pmsg),
        k2048: k2,
        m2048: bytes_of(""),
        s2048: bytes_of(
            "",
        ),
        k4096: k4,
        m4096: bytes_of(""),
        s4096: bytes_of(
            "",
        ),
        mpss: bytes_of(""),
        spss: bytes_of(
            "",
        ),
        p384_pk: bytes_of(
            "0429bdb76d5fa741bfd70233cb3a66cc7d44beb3b0663d92a8136650478bcefb61ef182e155a54345a5e8e5e88f064e5bc9a525ab7f764dad3dae1468c2b419f3b62b9ba917d5e8c4fb1ec47404a3fc76474b2713081be9db4c00e043ada9fc4a3",
        ),
        p384_msg: bytes_of(""),
        p384_sig: bytes_of(
            "3064023032401249714e9091f05a5e109d5c1216fdc05e98614261aa0dbd9e9cd4415dee29238afbd3b103c1e40ee5c9144aee0f02304326756fb2c4fd726360dd6479b5849478c7a9d054a833a58c1631c33b63c3441336ddf2c7fe0ed129aae6d4ddfeb753",
        ),
    }
    let n = 5
    var w: int = 0
    while w < n {
        let ns = batch(w, i)
        print("warmup {name(w)} ns={ns}")
        w = w + 1
    }
    var times = List[List[int]]()
    w = 0
    while w < n {
        (mut times).push(List[int]())
        w = w + 1
    }
    var b: int = 1
    while b <= 5 {
        w = 0
        while w < n {
            let ns = batch(w, i)
            (mut times[w]).push(ns)
            print("batch {b} {name(w)} ns={ns} ns_per_call={ns / 32}")
            w = w + 1
        }
        b = b + 1
    }
    let base = median(times[0])
    w = 0
    while w < n {
        let m = median(times[w])
        print("MEDIAN {name(w)} ns_per_call={m / 32} ratio_to_p256_x1000={m * 1000 / base}")
        w = w + 1
    }
    0
}
