//! sc79's interop probe: one TLS 1.3 handshake with std.x.tls.client
//! against a peer the harness names, then one HTTP/1.0 request. Not a
//! rig test (it needs a server); `docs/sc79-witness/interop/run.py`
//! builds and drives it.
//!
//! The caller supplies everything the client takes: the address, the
//! name the chain must certify, the roots (concatenated DER), the time
//! (compact `yyyymmddhhmmss`, UTC), and the 32-byte random and X25519
//! scalar. Prints `complete: <host> application bytes=<n>` on success
//! and `complete=<row>` (or the failing step) otherwise, exiting 1.

use std.net
use std.x.tls.cert
use std.x.tls.client

/// The compact time from its fourteen digits.
fn compact(s: str) -> int {
    var v: int = 0
    for b in s.bytes() {
        let d = b as int - 48
        if d >= 0 {
            if d <= 9 {
                v = v * 10 + d
            }
        }
    }
    v
}

fn main() -> int {
    let addr = env_get("SC79_ADDR") else "127.0.0.1:4433"
    let host = env_get("SC79_HOST") else "localhost"
    let roots_path = env_get("SC79_ROOTS") else "roots.der"
    let now_text = env_get("SC79_NOW") else "20270601000000"
    let random_path = env_get("SC79_RANDOM") else "random.bin"
    let scalar_path = env_get("SC79_SCALAR") else "scalar.bin"
    let now = compact(now_text)
    if now < cert.timestamp(2000, 1, 1, 0, 0, 0) {
        eprint("now={now_text}")
        return 1
    }
    let roots = fs_read_bytes(roots_path) else |e| {
        print("roots={e}")
        return 1
    }
    let random = fs_read_bytes(random_path) else |e| {
        print("random={e}")
        return 1
    }
    let scalar = fs_read_bytes(scalar_path) else |e| {
        print("scalar={e}")
        return 1
    }
    var sock = net.connect(addr) else |e| {
        print("connect={e}")
        return 1
    }
    net.set_deadline(mut sock, 20000) else |e| {
        print("deadline={e}")
        return 1
    }
    let pending = client.begin(take sock, host, roots, now, random, scalar) else |e| {
        print("begin={e}")
        return 1
    }
    var tls = client.complete(take pending) else |e| {
        print("complete={e}")
        return 1
    }
    client.write(mut tls, "GET / HTTP/1.0\r\nHost: {host}\r\n\r\n".bytes()) else |e| {
        print("write={e}")
        return 1
    }
    let reply = client.read(mut tls) else |e| {
        print("read={e}")
        return 1
    }
    print("complete: {host} application bytes={reply.len}")
    client.close(take tls) else |_| {}
    0
}
