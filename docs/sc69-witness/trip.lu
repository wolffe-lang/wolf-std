//! sc69's witness program for the round trip (docs/sc69-witness/pty.py
//! runs it on a pty). Uses only what std.term had before sc69 (`mode`,
//! `set_mode`, `pack`, `unpack`), so the same file runs against trunk
//! e036bec's std and against the head's. SC69_TTY names the terminal,
//! SC69_STEP the step: `trip` reads the mode and sets it back through
//! unpack and pack; `back` sets the mode SC69_SAVED names (a packed int).
//! The terminal is read from outside, with `stty -a`, by the parent.

use std.env
use std.fmt
use std.fs
use std.term

fn set_row(tty: fs.File, m: term.Mode) -> str {
    term.set_mode(tty, m) else |e| {
        return match e {
            unsupported => "unsupported",
            invalid => "invalid",
            io => "io",
        }
    }
    "ok"
}

fn main() -> !int {
    let path = env.get("SC69_TTY") else |_| { "" }
    let step = env.get("SC69_STEP") else |_| { "trip" }
    var tty = fs.stdin()
    if path != "" {
        tty = fs.open(path) else |_| {
            print("open failed")
            return 4
        }
    }
    let m = term.mode(tty) else |e| {
        let w = match e {
            unsupported => "unsupported",
            io => "io",
        }
        print("mode={w}")
        return 5
    }
    print("read={term.pack(m)} runtime={os_term_mode(tty.fd) else -1}")
    if step == "back" {
        let s = env.get("SC69_SAVED") else |_| {
            print("no SC69_SAVED")
            return 3
        }
        let v = fmt.parse_int(s) else |_| {
            print("bad SC69_SAVED")
            return 3
        }
        print("set={set_row(tty, term.unpack(v))}")
        return 0
    }
    print("set={set_row(tty, m)}")
    0
}
