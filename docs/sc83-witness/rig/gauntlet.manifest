# Final released-pin take. Run --keep-going with
# --preflight 'bash "$GAUNTLET_RIG_DIR/step.sh" release-preflight'.
# Host facts/digests must identify the published archives, never a dev build.
engine podman --env PATH=/opt/s263-rust/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin --memory 256m
floor 35
rig lib.sh committed=../../..:HEAD:docs/sc83-witness/rig/lib.sh
rig step.sh committed=../../..:HEAD:docs/sc83-witness/rig/step.sh
rig gauntlet.manifest committed=../../..:HEAD:docs/sc83-witness/rig/gauntlet.manifest
rig ../rows.py committed=../../..:HEAD:docs/sc83-witness/rows.py
rig ../test_rows.py committed=../../..:HEAD:docs/sc83-witness/test_rows.py
step row-runner-unit image=localhost/r41-toolchain:1 tools=python3 script=step.sh -- row-unit
step toolchain image=localhost/r41-toolchain:1 tools=python3,git,sha256sum script=step.sh -- toolchain
step doctor needs=toolchain image=localhost/r41-toolchain:1 script=step.sh -- xtask doctor
step sc83-rows needs=doctor,row-runner-unit image=localhost/r41-toolchain:1 tools=python3,sh,sleep script=step.sh -- rows
step fmt image=localhost/r41-toolchain:1 script=step.sh -- cargo fmt --all --check
step clippy image=localhost/r41-toolchain:1 script=step.sh -- cargo clippy --workspace --all-targets -- -D warnings
step test image=localhost/r41-toolchain:1 script=step.sh -- cargo test --workspace
step sync-pin image=localhost/r41-toolchain:1 tools=git script=step.sh -- xtask sync-pin
step ledger-check image=localhost/r41-toolchain:1 script=step.sh -- xtask ledger-check
step lint-conventions image=localhost/r41-toolchain:1 script=step.sh -- xtask std-test --lint-conventions
step fmt-lu needs=doctor image=localhost/r41-toolchain:1 script=step.sh -- xtask fmt-lu
step gen-vectors needs=doctor image=localhost/r41-toolchain:1 script=step.sh -- xtask gen-vectors --check
step time-oracle needs=doctor image=localhost/r41-toolchain:1 tools=date script=step.sh -- xtask time-oracle
step ulp needs=doctor image=localhost/r41-toolchain:1 script=step.sh -- xtask ulp
step std-test needs=doctor,ledger-check image=localhost/r41-toolchain:1 script=step.sh -- xtask std-test
step doc-examples needs=doctor image=localhost/r41-toolchain:1 script=step.sh -- xtask doc-examples
