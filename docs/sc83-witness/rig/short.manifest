# Development and plant take; does not claim a released-pin doctor pass.
engine podman --env PATH=/opt/s263-rust/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin --memory 256m
floor 35
rig lib.sh committed=../../..:HEAD:docs/sc83-witness/rig/lib.sh
rig step.sh committed=../../..:HEAD:docs/sc83-witness/rig/step.sh
rig short.manifest committed=../../..:HEAD:docs/sc83-witness/rig/short.manifest
rig ../rows.py committed=../../..:HEAD:docs/sc83-witness/rows.py
step toolchain image=localhost/r41-toolchain:1 tools=python3,git,sha256sum script=step.sh -- toolchain
step sc83-rows needs=toolchain image=localhost/r41-toolchain:1 tools=python3,sh,sleep script=step.sh -- rows
