engine ./linux-engine.sh --env=PATH=/opt/s263-rust/bin:/usr/local/bin:/usr/bin:/bin
floor 35 ../..
rig prepare.manifest committed=../..:HEAD:docs/sc86-witness/prepare.manifest
rig linux-engine.sh committed=../..:HEAD:docs/sc86-witness/linux-engine.sh
rig linux-step.sh committed=../..:HEAD:docs/sc86-witness/linux-step.sh
rig linux-inner.sh committed=../..:HEAD:docs/sc86-witness/linux-inner.sh
rig linux-preflight.sh committed=../..:HEAD:docs/sc86-witness/linux-preflight.sh
rig wiring.sh committed=../..:HEAD:docs/sc86-witness/wiring.sh
rig ../../xtask/unicode/size.py committed=../..:HEAD:xtask/unicode/size.py
rig ../../xtask/unicode/generate.py committed=../..:HEAD:xtask/unicode/generate.py
rig ../../xtask/unicode/generate-test.py committed=../..:HEAD:xtask/unicode/generate-test.py
step ci-wiring tools=python3,git script=wiring.sh
step width-binary-size image=localhost/r41-toolchain:1 tools=bash,python3,clang,size,nm,setsid script=linux-step.sh -- size
step rig-checks image=localhost/r41-toolchain:1 tools=bash,python3,git,cargo,rustc,rustfmt,cargo-clippy,clang,gcc,setsid script=linux-step.sh -- quick
