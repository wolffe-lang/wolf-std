//! sc62's witness program (docs/sc62-witness/pty.py runs it on a pty):
//! listen for `resize()`, write the file SC62_MARK names (the parent
//! acts only after it exists), then `signal.wait_fd` (ruling #82) on standard input
//! with `resize()`. A meaning is answered as its number and the size is
//! read again; 0 (input ready) is followed by a one-byte read, which
//! shows the wait read nothing.

use std.env
use std.fs
use std.signal
use std.term

fn main() -> !int {
    // SC62_TTY names the pty when the machine gives the program no
    // terminal on standard input (`conform-run --native` / `--release`).
    let path = env.get("SC62_TTY") else |_| { "" }
    var tty = fs.stdin()
    if path != "" {
        tty = fs.open(path)?
    }
    signal.listen(signal.resize())?
    let mark = env.get("SC62_MARK") else |_| { "" }
    if mark != "" {
        fs.write_text(mark, "waiting")?
    }
    let m = signal.wait_fd(tty, signal.resize()) else |e| {
        let w = match e {
            unsupported => "unsupported",
            io => "io",
        }
        print("wait={w}")
        return 5
    }
    print("answer={m}")
    if m == signal.resize() {
        let s = term.size(tty)?
        print("rows={s.rows} columns={s.columns}")
    } else if m == 0 {
        let b = fs.read(mut tty, 1)?
        print("read={b}")
    }
    0
}
