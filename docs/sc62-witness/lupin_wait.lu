//! sc62's witness program for lupin alone: `signal.wait_fd` with a
//! well-formed set and no listen (lupin resolves no `os_signal_listen`),
//! so its refusal names `os_signal_wait_fd` itself.

use std.fs
use std.signal

fn main() -> !int {
    let m = signal.wait_fd(fs.stdin(), signal.resize())?
    print("answer={m}")
    0
}
