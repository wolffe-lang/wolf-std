# sc84: the generated-code gate on an arm64 Mac (Mach-O, LLVM objdump).
floor 16 ../..
rig mac.manifest committed=../..:HEAD:docs/sc84-witness/mac.manifest
rig mac-step.sh committed=../..:HEAD:docs/sc84-witness/mac-step.sh
rig ci-wiring.sh committed=../..:HEAD:docs/sc84-witness/ci-wiring.sh
step ci-wiring tools=python3,git script=ci-wiring.sh
step codegen tools=bash,cargo,objdump,nm,clang script=mac-step.sh -- codegen
