//! member: true
//!
//! std.term — the controlling terminal: whose turn it is, and how it reads.
//! Stability tier: core. The facade over wolf-lang's `[os.term]` (s219).
//!
//! **Whose turn.** One process group at a time is the terminal's
//! FOREGROUND: the group its Ctrl-C, Ctrl-\ and Ctrl-Z signal and the only
//! one that may read it. A job-control shell hands the foreground to a job
//! (`std.process.start_job` does it in the child, before the job runs) and
//! takes it back with `set_foreground(tty, group())` when the job ends.
//! The setters block `SIGTTOU` for their own duration, so a shell outside
//! the foreground is not stopped for taking its terminal back.
//!
//! **How it reads.** A `Mode` is the things an interactive program
//! changes: `canonical` (a line at a time, with the terminal's own
//! editing), `echo`, `signals` (Ctrl-C, Ctrl-\ and Ctrl-Z become signals),
//! `flow` (Ctrl-S and Ctrl-Q pause and resume output and never reach the
//! program), `extended` (the host's extended input: literal next, word
//! erase, reprint, discard) and, when not canonical, how a read waits —
//! `min` bytes, or `time` tenths of a second. Every other setting is left
//! as found, so a mode read and set back restores exactly what was
//! changed. Nothing restores it for you at exit: save it, change it, put
//! it back (`term.set_mode(tty, saved)`).
//!
//! **`flow` and `extended` before wolf 0.2.30.** The runtime gained the
//! two bits in wolf 0.2.30 (s234); from then a mode without them turns
//! flow control and extended input off. Before it the runtime never
//! reports them (`mode` answers both `false`) and refuses a mode that
//! carries them (`invalid`), and a set leaves both as found. A mode read
//! and set back is therefore exact on either side; a `Mode` built by hand
//! says what it wants of both.
//!
//! **What a line editor asks of it** (wolf 0.2.30, s234, ruling #73):
//! the window's `size` (and `signal.resize()` when it changes) and the
//! keys the user chose for erase, kill, interrupt and the rest (`chars`)
//! — spellings ruled #82. The wait that a key or a signal ends is
//! `signal.wait_fd` (ruling #82: the signal family's, and any descriptor
//! serves), so an editor blocks there instead of in a read a signal
//! cannot tear. Nothing here sets
//! the special characters, and nothing restores the mode when a program
//! dies of a signal it cannot catch.
//!
//! **Errors are rows.** A handle that is closed, forged or not a terminal
//! is `io`; a mode outside the bits is `invalid` (unreachable through
//! `Mode`, whose fields are clamped, but for `flow` or `extended` before
//! wolf 0.2.30); every call is `unsupported` on windows. lupin answers
//! the shape rows and declines every call that reaches the terminal by
//! name.
//!
//! **Capability:** `foreground`, `mode`, `set_mode`, `size` and `chars`
//! are `io` (they act on a descriptor the program holds, as
//! `io.is_terminal`); `set_foreground` is `exec` (process control) and
//! `group` `env` (process context).
//! `pack`, `unpack`, `raw`, `chars_from` and `char_disabled` are pure,
//! comptime-safe.

use std.fs

/// The terminal's mode, unpacked (`[os.term.mode]`).
pub struct Mode {
    canonical: bool,
    echo: bool,
    signals: bool,
    flow: bool,
    extended: bool,
    min: int,
    time: int,
}

fn clamp(n: int) -> int {
    if n < 0 {
        return 0
    }
    if n > 255 {
        return 255
    }
    n
}

/// The packed int the builtin reads: canonical=1, echo=2, signals=4,
/// flow=8, extended=16, `min` in bits 8..15, `time` in bits 16..23
/// (`[os.term.mode]`). `pack(unpack(v)) == v` for every mode the runtime
/// reports.
pub fn pack(m: Mode) -> int {
    var v = 0
    if m.canonical {
        v = v + 1
    }
    if m.echo {
        v = v + 2
    }
    if m.signals {
        v = v + 4
    }
    if m.flow {
        v = v + 8
    }
    if m.extended {
        v = v + 16
    }
    v + clamp(m.min) * 256 + clamp(m.time) * 65536
}

/// The `Mode` a packed int names.
pub fn unpack(v: int) -> Mode {
    Mode {
        canonical: v % 2 == 1,
        echo: v / 2 % 2 == 1,
        signals: v / 4 % 2 == 1,
        flow: v / 8 % 2 == 1,
        extended: v / 16 % 2 == 1,
        min: v / 256 % 256,
        time: v / 65536 % 256,
    }
}

/// The terminal's mode now.
pub fn mode(tty: fs.File) -> Mode ! {unsupported, io} {
    unpack(os_term_mode(tty.fd)?)
}

/// Set the terminal's mode (output already written drains first; input
/// already typed is kept).
pub fn set_mode(tty: fs.File, m: Mode) -> () ! {unsupported, invalid, io} {
    os_term_set_mode(tty.fd, pack(m))?
}

/// `m` with input a key at a time: not canonical, no echo, no flow
/// control and no extended input, one byte per read, no timer, so Ctrl-S,
/// Ctrl-Q, Ctrl-V and Ctrl-O arrive as keys, as `cfmakeraw(3)` leaves
/// them. `signals` is kept, so Ctrl-C still interrupts (ruling #81:
/// `raw` clears `flow` and `extended`). Before wolf 0.2.30 the runtime
/// cannot clear the two, so there they stay as found.
pub fn raw(m: Mode) -> Mode {
    Mode {
        canonical: false,
        echo: false,
        signals: m.signals,
        flow: false,
        extended: false,
        min: 1,
        time: 0,
    }
}

/// The terminal's foreground process group.
pub fn foreground(tty: fs.File) -> int ! {unsupported, io} {
    os_term_foreground(tty.fd)?
}

/// Make `group_id` the terminal's foreground process group.
pub fn set_foreground(tty: fs.File, group_id: int) -> () ! {unsupported, io} {
    os_term_set_foreground(tty.fd, group_id)?
}

/// This process's own process group.
pub fn group() -> int ! {unsupported} {
    os_pgid()?
}

/// The terminal's window size (`[os.term.size]`): `rows` lines of
/// `columns` cells each.
pub struct Size {
    rows: int,
    columns: int,
}

/// The window's size as the terminal holds it: what the emulator last
/// told it, or what `stty rows … cols …` set (`TIOCGWINSZ`).
///
/// A size the terminal was never told is 0 (a pseudo-terminal nobody
/// sized): fall back on `COLUMNS` or 80, as without the call. When the
/// window changes, the foreground group hears `signal.resize()`, and the
/// next call answers the new size.
///
/// Rows: `io` for a handle that is closed, forged or not a terminal;
/// `unsupported` on windows. Never traps. lupin declines by name (it has
/// no `ioctl`), so the example is prose: `term.size(tty)?.columns` is the
/// width an editor lays a line out in.
///
/// Capability `io` (uncharged, as `mode`). Delegates to `os_term_size`.
/// Spelling ruled #82 (`Size`'s named fields over the builtin's pair).
pub fn size(tty: fs.File) -> Size ! {unsupported, io} {
    let (r, c) = os_term_size(tty.fd)?
    Size { rows: r, columns: c }
}

/// The terminal's special characters (`[os.term.chars]`): the byte the
/// user chose for each (`stty erase ^H`), or `char_disabled()` for one
/// that is disabled (`stty intr undef`). `word_erase`, `literal_next`,
/// `reprint` and `discard` are not POSIX's; both hosts have them, and
/// they act only with `Mode.extended` on.
pub struct Chars {
    erase: int,
    kill: int,
    interrupt: int,
    quit: int,
    suspend: int,
    end_of_file: int,
    word_erase: int,
    literal_next: int,
    start: int,
    stop: int,
    reprint: int,
    discard: int,
}

/// The word `Chars` holds for a character that is disabled: -1, the
/// builtin's own (`[os.term.chars]`; the host's disabled value never
/// reaches the program). Total and pure.
///
/// ```wolf-doc-example
/// term.char_disabled() == 0 - 1
/// ```
pub fn char_disabled() -> int {
    -1
}

fn char_at(v: List[int], i: int) -> int {
    var k = 0
    for c in v {
        if k == i {
            return c
        }
        k = k + 1
    }
    -1
}

/// The `Chars` a list in `[os.term.chars]`'s order names: erase, kill,
/// interrupt, quit, suspend, end of file, word erase, literal next,
/// start, stop, reprint, discard. An entry the list does not reach is
/// `char_disabled()`; entries past the twelfth are not read (the
/// builtin's list grows only at its end). Total and pure.
///
/// ```wolf-doc-example
/// var v = List[int]()
/// (mut v).push(127)
/// (mut v).push(21)
/// (mut v).push(3)
/// let c = term.chars_from(v)
/// c.erase == 127 && c.interrupt == 3 && c.discard == term.char_disabled()
/// ```
pub fn chars_from(v: List[int]) -> Chars {
    Chars {
        erase: char_at(v, 0),
        kill: char_at(v, 1),
        interrupt: char_at(v, 2),
        quit: char_at(v, 3),
        suspend: char_at(v, 4),
        end_of_file: char_at(v, 5),
        word_erase: char_at(v, 6),
        literal_next: char_at(v, 7),
        start: char_at(v, 8),
        stop: char_at(v, 9),
        reprint: char_at(v, 10),
        discard: char_at(v, 11),
    }
}

/// The terminal's special characters now. A line editor that turns
/// `canonical` and `signals` off reads these first, so erase, kill,
/// interrupt and end of file keep the keys the user set. Nothing here
/// sets them (`stty` does).
///
/// Rows: `io` for a handle that is closed, forged or not a terminal;
/// `unsupported` on windows. Never traps. lupin declines by name (it has
/// no `tcgetattr`); the example is prose: `term.chars(tty)?.erase` is
/// the key that deletes a character.
///
/// Capability `io` (uncharged, as `mode`). Delegates to `os_term_chars`.
/// Spelling ruled #82 (`Chars`' named fields, with `chars_from` and
/// `char_disabled`).
pub fn chars(tty: fs.File) -> Chars ! {unsupported, io} {
    chars_from(os_term_chars(tty.fd)?)
}
