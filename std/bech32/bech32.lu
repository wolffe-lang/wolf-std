//! member: true
//!
//! std.bech32 — BIP-173 checksummed base32. Stability tier: core.
//! The checksum is Bech32 (constant 1), NOT Bech32m. This module has
//! no Bitcoin address or witness-version semantics. Generic data are
//! 5-bit words in List[byte]; the byte helpers additionally check exact
//! decoded length and canonical 8-to-5 padding for native age keys.
//! BIP-173's 90-character bound applies here. Native X25519 age keys
//! fit; this is not the age extension for arbitrarily long PQ keys.
//! Decoders reject mixed case and normalize HRPs to lowercase. Encoders
//! produce lowercase; callers may uppercase the WHOLE result for an age
//! identity's presentation. Neither direction corrects errors or renders
//! input in an error. All failures are `parse`, not traps. Pure,
//! comptime-safe.
//!
//! **No division, branch or table index on a data character (sc84,
//! wolf-std#151).** An age identity is a secret key in this encoding, so
//! the codec treats every data character and word as secret: the
//! alphabet is read by a constant 32-step pass with an arithmetic match
//! (`value`, `char_of`), case is folded by arithmetic flags, each
//! checksum step selects its generator terms by masks, the 8-to-5 and
//! 5-to-8 regroupings are shifts and masks on a `wrapping[u64]` word,
//! and an invalid character is remembered and refused after the whole
//! string has been read. What still branches: lengths, the HRP (public
//! by format), the position of the last `1`, and the final verdicts
//! (checksum, padding, length, mixed case), whose outcome is the
//! published answer. This is a source-level statement plus a
//! generated-code gate: `cargo xtask codegen` fails on any division
//! instruction in this module's default or release objects on the host
//! target. It is not a timing measurement, and the compiler is not
//! audited. One encoder and one decoder serve every caller, secret or
//! public; there is no separate fast path to choose by mistake.

/// A validated lowercase HRP and 5-bit data words, excluding checksum.
/// The words are encoding data, not necessarily whole or canonical bytes.
pub struct Decoded {
    hrp: str,
    data: List[byte],
}

fn alphabet() -> str { "qpzry9x8gf2tvdw0s3jn54khce6mua7l" }

// 1 when a == b, else 0, for a and b in 0..255, without a branch:
// (a ^ b) - 1 is negative exactly when they are equal, and a floor
// shift by 8 maps it to -1 there and to 0 elsewhere.
fn same(a: int, b: int) -> int { 0 - ((a ^ b) - 1 >> 8) }

// 1 when lo <= v <= hi, else 0, for v, lo and hi in 0..255, without a
// branch: each difference shifts to 0 when non-negative, -1 when not.
fn within(v: int, lo: int, hi: int) -> int { 1 + (v - lo >> 8) + (hi - v >> 8) }

// BIP-173 Specification / Checksum: one bech32_polymod iteration. Each
// generator term is selected by a mask of its state bit (all ones or
// zero), never by a branch on the data-derived state.
fn step(chk: wrapping[u64], v: int) -> wrapping[u64] {
    let top = chk >> 25
    var next = (chk & 0x1ffffff) << 5 ^ v as wrapping[u64]
    next = next ^ 0 - (top & 1) & 0x3b6a57b2
    next = next ^ 0 - (top >> 1 & 1) & 0x26508e6d
    next = next ^ 0 - (top >> 2 & 1) & 0x1ea119fa
    next = next ^ 0 - (top >> 3 & 1) & 0x3d4233dd
    next = next ^ 0 - (top >> 4 & 1) & 0x2a1462b3
    next
}

fn hrp_state(hrp: List[byte]) -> wrapping[u64] {
    var chk: wrapping[u64] = 1
    for c in hrp { chk = step(chk, c as int >> 5) }
    chk = step(chk, 0)
    for c in hrp { chk = step(chk, c as int & 31) }
    chk
}

// The alphabet index of c, or -1: all 32 entries are compared and the
// match accumulated, so neither the trip count nor a branch depends on c.
// (The scan this replaces returned at the match; the x86-64 release tier
// compiled it to a jump table indexed by the character.)
fn value(c: byte) -> int {
    let v = c as int
    var found: int = 0
    var i: int = 0
    for a in alphabet().bytes() {
        found = found | same(a as int, v) * (i + 1)
        i = i + 1
    }
    found - 1
}

// The alphabet character of word w (0..31), by the same constant pass:
// no load is indexed by w.
fn char_of(w: int) -> byte {
    var pick: int = 0
    var i: int = 0
    for a in alphabet().bytes() {
        pick = pick | same(i, w) * a as int
        i = i + 1
    }
    pick as byte
}

/// BIP-173 encoding of 5-bit `data` words. HRP must be 1..83 printable
/// ASCII characters; uppercase letters are normalized to lowercase.
/// Raises `parse` on invalid HRP, a word above 31, or total length above
/// 90 characters. Total over its input types; pure, comptime-safe.
///
/// ```wolf-doc-example
/// bech32.encode("a", List[byte]())? == "a12uel5l"
/// ```
pub fn encode(hrp: str, data: List[byte]) -> str ! {parse} {
    if hrp.len < 1 || hrp.len > 83 { return parse }
    if data.len > 90 - hrp.len - 7 { return parse }
    var h = List[byte]()
    for c in hrp.bytes() {
        let v = c as int
        if v < 33 || v > 126 { return parse }
        (mut h).push((v + 32 * within(v, 65, 90)) as byte)
    }
    var chk = hrp_state(h)
    var out = copy h
    (mut out).push(49 as byte)
    var over: int = 0
    for d in data {
        let v = d as int
        over = over | v >> 5
        chk = step(chk, v & 31)
        (mut out).push(char_of(v & 31))
    }
    if over != 0 { return parse }
    for _ in 0..6 { chk = step(chk, 0) }
    chk = chk ^ 1
    for i in 0..6 {
        let shift = (5 * (5 - i)) as wrapping[u64]
        (mut out).push(char_of((chk >> shift & 31) as int))
    }
    str_from_utf8(out) else ""
}

/// Validates BIP-173 syntax/case/checksum and returns lowercase HRP and
/// 5-bit data excluding checksum. Raises `parse` on any failure, including
/// non-ASCII, missing/empty HRP, short checksum and length outside 8..90.
/// Uses the LAST separator. No correction, no input in diagnostics.
/// Total over UTF-8; pure, comptime-safe.
///
/// ```wolf-doc-example
/// let d = bech32.decode("A12UEL5L")?
/// d.hrp == "a"
/// d.data.len == 0
/// ```
pub fn decode(s: str) -> Decoded ! {parse} {
    if s.len < 8 || s.len > 90 { return parse }
    var text = List[byte]()
    var bad: int = 0
    var uppers: int = 0
    var lowers: int = 0
    var sep: int = 0 - 1
    var i: int = 0
    for c in s.bytes() {
        let v = c as int
        let upper = within(v, 65, 90)
        bad = bad | 1 - within(v, 33, 126)
        uppers = uppers | upper
        lowers = lowers | within(v, 97, 122)
        sep = sep + same(v, 49) * (i - sep)
        (mut text).push((v + 32 * upper) as byte)
        i = i + 1
    }
    if bad != 0 || uppers & lowers == 1 { return parse }
    if sep < 1 || sep > 83 || text.len - sep - 1 < 6 { return parse }
    let h = text[0..sep]
    var chk = hrp_state(h)
    var data = List[byte]()
    i = sep + 1
    while i < text.len {
        let v = value(text[i])
        bad = bad | v >> 8 & 1
        chk = step(chk, v & 31)
        if i < text.len - 6 { (mut data).push((v & 31) as byte) }
        i = i + 1
    }
    if bad != 0 || chk != 1 { return parse }
    Decoded { hrp: str_from_utf8(h) else "", data: data }
}

/// Encodes bytes as MSB-first 5-bit words with zero padding, then Bech32.
/// Rows/traps as `encode`; the output must fit BIP-173's 90 characters.
/// Native age uses HRP `age` or `age-secret-key-`, and 32 input bytes.
/// Pure, comptime-safe. No division, branch or table index on the bytes
/// (see the module header); never log a real identity.
///
/// ```wolf-doc-example
/// let s = bech32.encode_bytes("age", "x".bytes())?
/// bech32.decode_bytes(s, "age", 1)?.len == 1
/// ```
pub fn encode_bytes(hrp: str, b: List[byte]) -> str ! {parse} {
    // At most 51 whole bytes can fit even under the shortest HRP.
    if b.len > 51 { return parse }
    var words = List[byte]()
    var acc: wrapping[u64] = 0
    var bits: int = 0
    for v in b {
        acc = acc << 8 | v as int as wrapping[u64]
        bits = bits + 8
        while bits >= 5 {
            bits = bits - 5
            let shift = bits as wrapping[u64]
            (mut words).push((acc >> shift & 31) as int as byte)
            acc = acc & (1 as wrapping[u64] << shift) - 1
        }
    }
    if bits > 0 {
        (mut words).push((acc << (5 - bits) as wrapping[u64] & 31) as int as byte)
    }
    encode(hrp, words)?
}

/// Decodes canonical MSB-first bytes with exactly `n` bytes and the
/// specified lowercase `hrp`. Raises `parse` for any Bech32 failure,
/// a different HRP/length, negative n, five or more residual bits, or
/// nonzero residual bits. A valid checksum alone is NOT enough.
/// Pure, comptime-safe; total, no traps, no input in errors.
///
/// ```wolf-doc-example
/// let s = bech32.encode_bytes("age", "x".bytes())?
/// let b = bech32.decode_bytes(s, "age", 1)?
/// b.len == 1
/// ```
pub fn decode_bytes(s: str, hrp: str, n: int) -> List[byte] ! {parse} {
    if n < 0 { return parse }
    let decoded = decode(s)?
    if decoded.hrp != hrp { return parse }
    var out = List[byte]()
    var acc: wrapping[u64] = 0
    var bits: int = 0
    for v in decoded.data {
        acc = acc << 5 | v as int as wrapping[u64]
        bits = bits + 5
        if bits >= 8 {
            bits = bits - 8
            let shift = bits as wrapping[u64]
            (mut out).push((acc >> shift & 255) as int as byte)
            acc = acc & (1 as wrapping[u64] << shift) - 1
        }
    }
    if bits >= 5 || acc != 0 || out.len != n { return parse }
    out
}
