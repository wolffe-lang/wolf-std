//! member: true
//!
//! std.poll — one wait over files, sockets and signals, answering every
//! ready entry once. Stability tier: core.
//!
//! Keep one owned Waiter across the server loop: open, add_file,
//! add_socket and add_listener; modify interests as output queues fill or
//! empty; remove entries before closing their handles; close the waiter.
//! Files and sockets share one wait with signal meanings and a monotonic
//! deadline. A meaning never hides ready handles.
//!
//! The readiness set opens lazily on the first valid add or wait. Native
//! Linux and macOS hold it in the kernel: O(ready) per wait, plus O(polled)
//! for descriptors the kernel set cannot hold (regular files included).
//! The checked machine keeps a set of its own and scans O(N). Where set
//! opening answers unsupported, a list feeds os_wait_ready: O(N), up to
//! two elements per entry. Results follow runtime order, unspecified for
//! a persistent set and key order for the list fallback. A persistent-set
//! wait neither sorts results nor scans the held keys.
//!
//! A waiter holds at most 256 entries, matching the smallest serving
//! runtime's set bound. Registration 257 answers io without changing it;
//! shape and duplicate errors still answer invalid first. The capacity
//! refusal makes no host call and does not replace os_error's last result.
//! A runtime handle
//! close removes its registration; remove before close to release std's
//! bookkeeping and reuse its key.
//!
//! READ and WRITE are interests and facts; HANGUP and ERROR are real host
//! facts, returned with the applicable interest. A read loop tests READ
//! and lets its read name the end: eof, closed, or a pty master's io on
//! Linux. A non-blocking writer uses fs.write_some or net.write_some,
//! retains unsent bytes and enables WRITE only while its queue has bytes.
//! busy means wait for room and retry, never discard the unsent bytes.
//!
//! Linux and macOS serve every combination. Windows preserves its narrow
//! sockets-only READ wait, no meanings, through net.wait (only READ facts
//! known there), and its empty deadline-only waits with no meanings.
//! Other fallback combinations use os_wait_ready and its host refusal.
//! PAX uses the static Linux binary. lupin 0.1.62 refuses readiness calls
//! at run by builtin name, not a caught unsupported error mark.
//!
//! Capability exec for sets/waits, net for the Windows narrow fallback;
//! refused at comptime. open, len and constants are pure. modify/remove
//! retain {invalid, io}: unsupported from a set change is explicitly
//! handled as io. A set that opened cannot meet it on that same host;
//! tests/poll/set_mutation.lu holds that fact.

use std.fs
use std.net
use std.signal
use std.time

/// Interest and fact: a read or accept would not park, including an end.
///
/// ```wolf-doc-example
/// poll.READ == 1
/// ```
pub const READ: int = 1

/// Interest and fact: room for a byte, or a write that would fail at once.
///
/// ```wolf-doc-example
/// poll.WRITE == 2
/// ```
pub const WRITE: int = 2

/// Fact: the other end hung up, accompanied by an applicable interest.
///
/// ```wolf-doc-example
/// poll.HANGUP == 4
/// ```
pub const HANGUP: int = 4

/// Fact: a host error, accompanied by the requested interest.
///
/// ```wolf-doc-example
/// poll.ERROR == 8
/// ```
pub const ERROR: int = 8

const FREE: int = 0
const FILE: int = 1
const SOCKET: int = 2
const LISTENER: int = 3
const NET: int = 2305843009213693952
const HANDLE_MAX: int = 2305843009213693951
const MEANINGS_MAX: int = 1048575
const CAPACITY: int = 256

/// An owned waiter holding at most 256 entries, named by stable keys.
/// Fields are bookkeeping, not an API for constructing a waiter: set is
/// -1 before acquisition, -2 for the list fallback, else a runtime set.
/// Entry handles remain the caller's.
pub struct Waiter {
    set: int,
    kinds: List[int],
    handles: List[int],
    interests: List[int],
    count: int,
}

/// One ready entry: its key and READ/WRITE/HANGUP/ERROR facts.
pub struct Ready {
    key: int,
    facts: int,
}

/// Every ready entry once, in runtime order (unspecified for a set), and
/// one meaning taken off the queue, or 0. Both may arrive together.
/// Empty ready and meaning 0 means the deadline passed.
pub struct Events {
    meaning: int,
    ready: List[Ready],
}

/// A new empty waiter; acquire its host set lazily at add/wait. Pure,
/// comptime-safe. The reserved io row stays unchanged; acquisition failures
/// are reported by the first add or wait, not this constructor.
///
/// ```wolf-doc-example
/// var w = poll.open()?
/// poll.len(w) == 0
/// poll.close(take w)?
/// ```
pub fn open() -> Waiter ! {io} {
    Waiter {
        set: -1,
        kinds: List[int](),
        handles: List[int](),
        interests: List[int](),
        count: 0,
    }
}

/// The number of entries added and not removed. Total and pure.
pub fn len(w: Waiter) -> int {
    w.count
}

/// Close the set, consuming w, leaving its entry handles open. io for a
/// failed close or forged set. Capability exec when acquired; comptime
/// refuses the host call. A never-acquired or fallback waiter has no set.
pub fn close(take w: Waiter) -> () ! {io} {
    if w.set >= 0 {
        os_ready_close(w.set)?
    }
}

fn is_net(kind: int) -> bool {
    kind == SOCKET || kind == LISTENER
}

fn marked(kind: int, h: int) -> int {
    if is_net(kind) { return h + NET }
    h
}

fn acquire(mut w: Waiter) -> () ! {io} {
    if w.set == -1 {
        w.set = os_ready_open() else |e| match e {
            unsupported => -2,
            io => { return io },
        }
    }
}

fn find(w: Waiter, kind: int, h: int) -> int {
    var k = 0
    for kd in w.kinds {
        if kd != FREE && is_net(kd) == is_net(kind) && w.handles[k] == h {
            return k
        }
        k = k + 1
    }
    -1
}

fn add(mut w: Waiter, kind: int, h: int, interest: int) -> int ! {invalid, io, unsupported} {
    if interest < READ || interest > READ + WRITE || h < 0 || h > HANDLE_MAX {
        return invalid
    }
    if find(w, kind, h) >= 0 { return invalid }
    if w.count >= CAPACITY { return io }
    var k = 0
    while k < w.kinds.len && w.kinds[k] != FREE { k = k + 1 }
    acquire(mut w)?
    if w.set >= 0 {
        os_ready_set(w.set, marked(kind, h), interest, k)?
    }
    // Publish the key only after the runtime accepted the registration.
    if k < w.kinds.len {
        w.kinds[k] = kind
        w.handles[k] = h
        w.interests[k] = interest
    } else {
        (mut w.kinds).push(kind)
        (mut w.handles).push(h)
        (mut w.interests).push(interest)
    }
    w.count = w.count + 1
    k
}

/// Add f with READ, WRITE or both; return the lowest free key, stable
/// until removal. invalid for duplicates, invalid interest, negative or
/// wait-marked handles. io for capacity (256), a closed/forged handle or
/// host failure; unsupported where registration is unsupported. Remove
/// before closing f. Capability exec; refused at comptime.
pub fn add_file(mut w: Waiter, f: fs.File, interest: int) -> int ! {invalid, io, unsupported} {
    add(mut w, FILE, f.fd, interest)?
}

/// Add a TCP or Unix stream with READ, WRITE or both. Keys and rows are
/// add_file's; file and net handle numbers belong to separate tables.
/// Capability exec; refused at comptime.
pub fn add_socket(mut w: Waiter, s: net.Socket, interest: int) -> int ! {invalid, io, unsupported} {
    add(mut w, SOCKET, s.fd, interest)?
}

/// Add l with READ (a pending connection). Keys and rows are add_file's.
/// Capability exec; refused at comptime.
pub fn add_listener(mut w: Waiter, l: net.Listener) -> int ! {invalid, io, unsupported} {
    add(mut w, LISTENER, l.fd, READ)?
}

fn live(w: Waiter, key: int) -> bool {
    key >= 0 && key < w.kinds.len && w.kinds[key] != FREE
}

fn change(w: Waiter, key: int, interest: int) -> () ! {invalid, io} {
    if w.set >= 0 {
        os_ready_set(w.set, marked(w.kinds[key], w.handles[key]), interest, key) else |e| {
            match e {
                invalid => { return invalid },
                io => { return io },
                // A set opens only on a serving host; its set calls cannot
                // become unsupported on that same host. Handle this
                // unreachable outcome explicitly to retain the public row.
                unsupported => { return io },
            }
        }
    }
}

/// Change key's interest to READ, WRITE or both. invalid for a non-live
/// key, bad interest, or WRITE on a listener; io for a runtime failure.
/// An opened set cannot answer unsupported on this host; that delegate
/// outcome is handled as io. Capability exec when acquired; refused at
/// comptime. No host call is needed on the list fallback.
pub fn modify(mut w: Waiter, key: int, interest: int) -> () ! {invalid, io} {
    if !live(w, key) || interest < READ || interest > READ + WRITE {
        return invalid
    }
    if w.kinds[key] == LISTENER && interest != READ { return invalid }
    change(w, key, interest)?
    w.interests[key] = interest
}

/// Remove key before closing its handle; the key becomes free. invalid
/// for a non-live key; io for a runtime failure, including an already
/// closed handle removed by the runtime. An opened set cannot answer
/// unsupported on this host; that delegate outcome is handled as io.
/// Capability exec when acquired; refused at comptime.
pub fn remove(mut w: Waiter, key: int) -> () ! {invalid, io} {
    if !live(w, key) { return invalid }
    change(w, key, 0)?
    w.kinds[key] = FREE
    w.handles[key] = -1
    w.interests[key] = 0
    w.count = w.count - 1
}

fn events(flat: List[int], meaning: int) -> Events {
    var ready = List[Ready]()
    var i = 0
    while i < flat.len {
        (mut ready).push(Ready { key: flat[i], facts: flat[i + 1] })
        i = i + 2
    }
    Events { meaning: meaning, ready: ready }
}

/// Wait for every ready entry and one signal meaning, together. meanings
/// is 0 or a set listened for through std.signal; deadline_ms is 0 for a
/// look, -1 for no deadline, otherwise monotonic milliseconds, never
/// answered early. Level-triggered: readiness remains until consumed.
///
/// invalid for a deadline below -1, a non-listenable meaning bit, or an
/// empty waiter with no meanings and no deadline. io for a host failure;
/// unsupported where the host or tier does not serve the call. Linux and
/// macOS serve files+sockets, signals+sockets, socket WRITE and files
/// without meanings. Windows retains its narrow socket READ case and
/// empty no-meaning deadline waits. Capability exec (net on that narrow
/// fallback); refused at comptime. Never traps for a host failure.
///
/// ```wolf-doc-example
/// var w = poll.open()?
/// let ev = poll.wait(mut w, 0, 0)?
/// poll.close(take w)?
/// ev.ready.len == 0
/// ev.meaning == 0
/// ```
pub fn wait(mut w: Waiter, meanings: int, deadline_ms: int) -> Events ! {invalid, io, unsupported} {
    if deadline_ms < -1 || meanings < 0 || meanings > MEANINGS_MAX { return invalid }
    if w.count == 0 && meanings == 0 && deadline_ms == -1 { return invalid }
    acquire(mut w)?
    if w.set >= 0 {
        let (flat, meaning) = os_ready_wait(w.set, meanings, deadline_ms)?
        return events(flat, meaning)
    }
    if os_name() == "windows" && meanings == 0 {
        if w.count == 0 {
            if deadline_ms > 0 { time.sleep(time.millis(deadline_ms)) }
            return Events { meaning: 0, ready: List[Ready]() }
        }
        var narrow = true
        for kd in w.kinds {
            if kd == FILE { narrow = false }
        }
        for interest in w.interests {
            if interest & WRITE != 0 { narrow = false }
        }
        if narrow { return sockets_path(w, deadline_ms)? }
    }
    one_shot(w, meanings, deadline_ms)?
}

// Preserve Windows' old sockets-only READ wait, which knows no fact bits.
fn sockets_path(w: Waiter, deadline_ms: int) -> Events ! {io} {
    var fds = List[int]()
    var keys = List[int]()
    var k = 0
    for kd in w.kinds {
        if is_net(kd) {
            (mut fds).push(w.handles[k])
            (mut keys).push(k)
        }
        k = k + 1
    }
    let got = net.wait(fds, deadline_ms)?
    var ready = List[Ready]()
    var i = 0
    for h in got {
        while i < fds.len && fds[i] != h { i = i + 1 }
        if i < fds.len {
            (mut ready).push(Ready { key: keys[i], facts: READ })
            i = i + 1
        }
    }
    Events { meaning: 0, ready: ready }
}

fn one_shot(w: Waiter, meanings: int, deadline_ms: int) -> Events ! {invalid, io, unsupported} {
    var elems = List[int]()
    var keys = List[int]()
    var k = 0
    for kd in w.kinds {
        if kd != FREE {
            let h = marked(kd, w.handles[k])
            if w.interests[k] & READ != 0 {
                (mut elems).push(h)
                (mut keys).push(k)
            }
            if w.interests[k] & WRITE != 0 {
                (mut elems).push(h + signal.WAIT_WRITE)
                (mut keys).push(k)
            }
        }
        k = k + 1
    }
    let (flat, meaning) = os_wait_ready(elems, meanings, deadline_ms)?
    var ready = List[Ready]()
    var i = 0
    while i < flat.len {
        let key = keys[flat[i]]
        let facts = flat[i + 1]
        let last = ready.len - 1
        // The one-shot promises element order and an entry's read/write
        // elements are adjacent, so coalescing needs no key scan or map.
        if last >= 0 && ready[last].key == key {
            ready[last] = Ready { key: key, facts: ready[last].facts | facts }
        } else {
            (mut ready).push(Ready { key: key, facts: facts })
        }
        i = i + 2
    }
    Events { meaning: meaning, ready: ready }
}
