/// Field inversion z^(p-2) mod p (Fermat), MSB-first binary
/// square-and-multiply over the PUBLIC constant exponent p-2 — the
/// per-bit branch reads a compiled-in table, never data, so the
/// schedule is input-independent (the fixed-exponent rule in the
/// module ct: note). 256 squarings, 128+ multiplies. z must be
/// nonzero mod p (an inversion of zero yields zero, which every call
/// site here excludes structurally).
fn fe_invert(z: Fe) -> Fe {
    let e = pm2_bytes()
    var r = fe_one()
    var i: int = 0
    while i < 256 {
        r = fe_sq(r)
        let byte = e[i / 8]
        let bit = byte / pow2(7 - i % 8) % 2
        if bit == 1 {
            r = fe_mul(r, z)
        }
        i = i + 1
    }
    r
}

/// ARITHMETIC selection — this module's cswap-class primitive and one
/// of c28's verification targets (the design ruling). `flag` is 0 or
/// 1; the output is g + flag·(f - g) per limb, so both inputs are read
/// unconditionally and NO BRANCH and NO MEMORY INDEX reads the secret
/// bit. A branchy select would pass every vector and leak the scalar.
/// ct: THE LOAD-BEARING CLAIM — the secret enters only as a
/// multiplier.
fn fe_select(flag: int, f: Fe, g: Fe) -> Fe {
    Fe {
        l0: g.l0 + flag * (f.l0 - g.l0),
        l1: g.l1 + flag * (f.l1 - g.l1),
        l2: g.l2 + flag * (f.l2 - g.l2),
        l3: g.l3 + flag * (f.l3 - g.l3),
        l4: g.l4 + flag * (f.l4 - g.l4),
        l5: g.l5 + flag * (f.l5 - g.l5),
        l6: g.l6 + flag * (f.l6 - g.l6),
        l7: g.l7 + flag * (f.l7 - g.l7),
        l8: g.l8 + flag * (f.l8 - g.l8),
        l9: g.l9 + flag * (f.l9 - g.l9),
        l10: g.l10 + flag * (f.l10 - g.l10),
        l11: g.l11 + flag * (f.l11 - g.l11),
        l12: g.l12 + flag * (f.l12 - g.l12),
        l13: g.l13 + flag * (f.l13 - g.l13),
        l14: g.l14 + flag * (f.l14 - g.l14),
        l15: g.l15 + flag * (f.l15 - g.l15),
    }
}

// ---------------------------------------------------------------------
// The curve group: projective points under the COMPLETE addition
// formulas of Renes–Costello–Batina (eprint 2015/1060, a = -3, the
// b-constant form) — total over identity, doubling and inverse inputs,
// which is what makes a branch-free ladder possible at all. Fields are
// interim backing, never API.
// ---------------------------------------------------------------------

struct Pt {
    x: Fe,
    y: Fe,
    z: Fe,
}

/// The group identity (0 : 1 : 0). Total.
fn pt_identity() -> Pt {
    Pt { x: fe_zero(), y: fe_one(), z: fe_zero() }
}

/// The base point G (SP 800-186 §3.2.1.3) in projective form. Total.
fn pt_base() -> Pt {
    Pt { x: fe_gx(), y: fe_gy(), z: fe_one() }
}

/// Complete point addition (RCB 2015/1060 Algorithm 4, a = -3): total
/// over ALL inputs — P + O, O + P, P + P and P + (-P) take the same
/// straight-line code as a generic addition. 12 multiplies, no branch.
/// ct: fixed field ops, no branch, no secret-dependent index.
fn pt_add(p1: Pt, p2: Pt) -> Pt {
    var t0 = fe_mul(p1.x, p2.x)
    var t1 = fe_mul(p1.y, p2.y)
    var t2 = fe_mul(p1.z, p2.z)
    var t3 = fe_add(p1.x, p1.y)
    var t4 = fe_add(p2.x, p2.y)
    t3 = fe_mul(t3, t4)
    t4 = fe_add(t0, t1)
    t3 = fe_sub(t3, t4)
    t4 = fe_add(p1.y, p1.z)
    var x3 = fe_add(p2.y, p2.z)
    t4 = fe_mul(t4, x3)
    x3 = fe_add(t1, t2)
    t4 = fe_sub(t4, x3)
    x3 = fe_add(p1.x, p1.z)
    var y3 = fe_add(p2.x, p2.z)
    x3 = fe_mul(x3, y3)
    y3 = fe_add(t0, t2)
    y3 = fe_sub(x3, y3)
    var z3 = fe_mul(fe_b(), t2)
    x3 = fe_sub(y3, z3)
    z3 = fe_add(x3, x3)
    x3 = fe_add(x3, z3)
    z3 = fe_sub(t1, x3)
    x3 = fe_add(t1, x3)
    y3 = fe_mul(fe_b(), y3)
    t1 = fe_add(t2, t2)
    t2 = fe_add(t1, t2)
    y3 = fe_sub(y3, t2)
    y3 = fe_sub(y3, t0)
    t1 = fe_add(y3, y3)
    y3 = fe_add(t1, y3)
    t1 = fe_add(t0, t0)
    t0 = fe_add(t1, t0)
    t0 = fe_sub(t0, t2)
    t1 = fe_mul(t4, y3)
    t2 = fe_mul(t0, y3)
    y3 = fe_mul(x3, z3)
    y3 = fe_add(y3, t2)
    x3 = fe_mul(t3, x3)
    x3 = fe_sub(x3, t1)
    z3 = fe_mul(t4, z3)
    t1 = fe_mul(t3, t0)
    z3 = fe_add(z3, t1)
    Pt { x: x3, y: y3, z: z3 }
}

/// Complete point doubling (RCB 2015/1060, the a = -3 doubling from
/// the same family — the Go nistec transcription): total, including
/// the identity. ct: fixed field ops, no branch.
fn pt_double(pp: Pt) -> Pt {
    var t0 = fe_sq(pp.x)
    var t1 = fe_sq(pp.y)
    var t2 = fe_sq(pp.z)
    var t3 = fe_mul(pp.x, pp.y)
    t3 = fe_add(t3, t3)
    var z3 = fe_mul(pp.x, pp.z)
    z3 = fe_add(z3, z3)
    var y3 = fe_mul(fe_b(), t2)
    y3 = fe_sub(y3, z3)
    var x3 = fe_add(y3, y3)
    y3 = fe_add(x3, y3)
    x3 = fe_sub(t1, y3)
    y3 = fe_add(t1, y3)
    y3 = fe_mul(x3, y3)
    x3 = fe_mul(x3, t3)
    t3 = fe_add(t2, t2)
    t2 = fe_add(t2, t3)
    z3 = fe_mul(fe_b(), z3)
    z3 = fe_sub(z3, t2)
    z3 = fe_sub(z3, t0)
    t3 = fe_add(z3, z3)
    z3 = fe_add(z3, t3)
    t3 = fe_add(t0, t0)
    t0 = fe_add(t3, t0)
    t0 = fe_sub(t0, t2)
    t0 = fe_mul(t0, z3)
    y3 = fe_add(y3, t0)
    t0 = fe_mul(pp.y, pp.z)
    t0 = fe_add(t0, t0)
    z3 = fe_mul(t0, z3)
    x3 = fe_sub(x3, z3)
    z3 = fe_mul(t0, t1)
    z3 = fe_add(z3, z3)
    z3 = fe_add(z3, z3)
    Pt { x: x3, y: y3, z: z3 }
}

/// Arithmetic point selection: `fe_select` over all three coordinates.
/// ct: as `fe_select` — the load-bearing claim, no branch, no index.
fn pt_select(flag: int, f: Pt, g: Pt) -> Pt {
    Pt {
        x: fe_select(flag, f.x, g.x),
        y: fe_select(flag, f.y, g.y),
        z: fe_select(flag, f.z, g.z),
    }
}

/// THE TABLE-FREE CONSTANT-TIME SCALAR MULTIPLICATION — the sc23
/// design ruling made code, and **c28's VERIFICATION TARGET for this
/// module** (as `fe_cswap` is curve25519's): [k]P over a 32-byte
/// BIG-endian scalar in 256 fixed iterations of complete-double,
/// complete-add, arithmetic-select. Every iteration executes the SAME
/// field operations; the scalar bit appears exactly once, as
/// `pt_select`'s multiplier — never a branch, never a table index (a
/// windowed table with a secret index would pass every vector in this
/// repository and leak the key through the cache; that is the whole
/// point of the ruling). The complete RCB formulas remove the
/// exceptional-case branches an incomplete ladder would need.
/// ct: THE SECRET PATH on signing (k is the nonce / the key); on
/// verify the scalars are public and the fixed schedule is free.
fn scalar_mul(k: List[int], pt: Pt) -> Pt {
    var acc = pt_identity()
    var i: int = 0
    while i < 256 {
        acc = pt_double(acc)
        let sum = pt_add(acc, pt)
        let byte = k[i / 8]
        let bit = byte / pow2(7 - i % 8) % 2
        acc = pt_select(bit, sum, acc)
        i = i + 1
    }
    acc
}

// ---------------------------------------------------------------------
// The scalar field mod n (the group order). n is NOT a Solinas prime
// (its low 128 bits are irregular), so multiplication is Montgomery in
// base 2^16 (CIOS over 16-limb List[int], little-endian by limb):
// fixed schedule, no division. The list shapes are the split
// read-then-write all three lanes run (the sc18 sc_reduce precedent).
// ---------------------------------------------------------------------

/// n as sixteen base-2^16 limbs, little-endian. Total.
fn n_limbs() -> List[int] {
    var out = List[int]()
    (mut out).push(9553)
    (mut out).push(64611)
    (mut out).push(51906)
    (mut out).push(62393)
    (mut out).push(40580)
    (mut out).push(42775)
    (mut out).push(64173)
    (mut out).push(48358)
    (mut out).push(65535)
    (mut out).push(65535)
    (mut out).push(65535)
    (mut out).push(65535)
    (mut out).push(0)
    (mut out).push(0)
    (mut out).push(65535)
    (mut out).push(65535)
    out
}

/// 2^256 - n as sixteen base-2^16 limbs (the >= n probe constant). Total.
fn cn_limbs() -> List[int] {
    var out = List[int]()
    (mut out).push(55983)
    (mut out).push(924)
    (mut out).push(13629)
    (mut out).push(3142)
    (mut out).push(24955)
    (mut out).push(22760)
    (mut out).push(1362)
    (mut out).push(17177)
    (mut out).push(0)
    (mut out).push(0)
    (mut out).push(0)
    (mut out).push(0)
    (mut out).push(65535)
    (mut out).push(65535)
    (mut out).push(0)
    (mut out).push(0)
    out
}

/// (2^256)^2 mod n — the Montgomery conversion constant. Total.
fn r2n_limbs() -> List[int] {
    var out = List[int]()
    (mut out).push(61090)
    (mut out).push(48761)
    (mut out).push(19605)
    (mut out).push(33572)
    (mut out).push(28582)
    (mut out).push(18877)
    (mut out).push(31132)
    (mut out).push(18073)
    (mut out).push(60505)
    (mut out).push(11115)
    (mut out).push(45625)
    (mut out).push(10309)
    (mut out).push(22048)
    (mut out).push(62425)
    (mut out).push(11668)
    (mut out).push(26337)
    out
}

/// 2^256 mod n — one in the Montgomery domain. Total.
fn rn_limbs() -> List[int] {
    var out = List[int]()
    (mut out).push(55983)
    (mut out).push(924)
    (mut out).push(13629)
    (mut out).push(3142)
    (mut out).push(24955)
    (mut out).push(22760)
    (mut out).push(1362)
    (mut out).push(17177)
    (mut out).push(0)
    (mut out).push(0)
    (mut out).push(0)
    (mut out).push(0)
    (mut out).push(65535)
    (mut out).push(65535)
    (mut out).push(0)
    (mut out).push(0)
    out
}

/// -n^-1 mod 2^16 (the Montgomery quotient constant). Total.
fn n0inv() -> int {
    48207
}

/// Montgomery multiplication a·b·2^-256 mod n (CIOS, base 2^16):
/// sixteen fixed outer rounds, each a multiply-accumulate row and a
/// quotient fold — no division, no data-dependent trip count. The
/// worst accumulator is < 2^33 (measured 2^31.99), X3-checked.
/// Output < n. ct: fixed schedule — the mod-n workhorse on the
/// signing path (nonce and key arithmetic).
fn sc_mont_mul(a: List[int], b: List[int]) -> List[int] {
    let nn = n_limbs()
    let n0i = n0inv()
    var t = List[int]()
    var i: int = 0
    while i < 17 {
        (mut t).push(0)
        i = i + 1
    }
    i = 0
    while i < 16 {
        let ai = a[i]
        var c: int = 0
        var j: int = 0
        while j < 16 {
            let tv = t[j] + ai * b[j] + c
            c = tv / 65536
            t[j] = tv - c * 65536
            j = j + 1
        }
        let t16a = t[16] + c
        t[16] = t16a
        let m = t[0] * n0i % 65536
        let f0 = t[0] + m * nn[0]
        c = f0 / 65536
        j = 1
        while j < 16 {
            let tv = t[j] + m * nn[j] + c
            c = tv / 65536
            t[j - 1] = tv - c * 65536
            j = j + 1
        }
        let top = t[16] + c
        t[15] = top % 65536
        t[16] = top / 65536
        i = i + 1
    }
    sc_cond_sub_n(t)
}

/// One arithmetic conditional subtraction of n: `t` is 16 limbs plus
/// an overflow limb t[16] in {0, 1} with value < 2n; the result is
/// value mod n. q (subtract or not) is computed as a carry, applied as
/// a multiplier — no branch. ct: fixed schedule.
fn sc_cond_sub_n(t: List[int]) -> List[int] {
    let nn = n_limbs()
    let cn = cn_limbs()
    let hi = t[16]
    // probe: does the low 2^256 part + (2^256 - n) carry out?
    var c: int = 0
    var i: int = 0
    while i < 16 {
        let gv = t[i] + cn[i] + c
        c = gv / 65536
        i = i + 1
    }
    let q = hi + (1 - hi) * c
    var out = List[int]()
    c = 0
    i = 0
    while i < 16 {
        let rv = t[i] - q * nn[i] + c
        c = floordiv(rv, 65536)
        (mut out).push(rv - c * 65536)
        i = i + 1
    }
    out
}

/// 32 BIG-endian bytes -> value mod n (a value < 2^256 is < 2n, so
/// one conditional subtraction reduces it — FIPS 186-5's bits2int for
/// a 256-bit hash needs exactly this). The caller guarantees byte
/// elements. ct: fixed.
fn sc_from_bytes_be(b: List[int]) -> List[int] {
    var t = List[int]()
    var i: int = 0
    while i < 16 {
        (mut t).push(b[31 - 2 * i] + b[30 - 2 * i] * 256)
        i = i + 1
    }
    (mut t).push(0)
    sc_cond_sub_n(t)
}

/// A 16-limb scalar as 32 BIG-endian bytes. ct: fixed extraction.
fn sc_to_bytes_be(s: List[int]) -> List[int] {
    var out = List[int]()
    var i: int = 15
    while i >= 0 {
        (mut out).push(s[i] / 256)
        (mut out).push(s[i] % 256)
        i = i - 1
    }
    out
}

/// a·b mod n: two Montgomery multiplications (in, then the R^2
/// correction). ct: fixed (`sc_mont_mul`).
fn sc_mul(a: List[int], b: List[int]) -> List[int] {
    sc_mont_mul(sc_mont_mul(a, b), r2n_limbs())
}

/// (a + b) mod n over two reduced scalars. ct: fixed.
fn sc_add(a: List[int], b: List[int]) -> List[int] {
    var t = List[int]()
    var c: int = 0
    var i: int = 0
    while i < 16 {
        let tv = a[i] + b[i] + c
        c = tv / 65536
        (mut t).push(tv - c * 65536)
        i = i + 1
    }
    (mut t).push(c)
    sc_cond_sub_n(t)
}

/// a^(n-2) mod n (Fermat inversion), MSB-first over the PUBLIC
/// constant exponent n-2, in the Montgomery domain throughout. The
/// per-bit branch reads a compiled-in table, never data. Used for
/// k^-1 (SIGNING — the secret path) and s^-1 (verify — public).
fn sc_inv(a: List[int]) -> List[int] {
    let am = sc_mont_mul(a, r2n_limbs())
    let e = nm2_bytes()
    var r = rn_limbs()
    var i: int = 0
    while i < 256 {
        r = sc_mont_mul(r, r)
        let byte = e[i / 8]
        let bit = byte / pow2(7 - i % 8) % 2
        if bit == 1 {
            r = sc_mont_mul(r, am)
        }
        i = i + 1
    }
    var one = List[int]()
    (mut one).push(1)
    i = 1
    while i < 16 {
        (mut one).push(0)
        i = i + 1
    }
    sc_mont_mul(r, one)
}

/// True iff a 16-limb scalar is zero. ct: on r/s and derived values —
/// public on verify; on the signing path the zero cases are the FIPS
/// 186-5 retry conditions, which never fire for a valid key (their
/// probability is ~2^-256) and are checked on values that become
/// public (r, s).
fn sc_iszero(s: List[int]) -> bool {
    var i: int = 0
    var zero = true
    while i < 16 {
        if !(s[i] == 0) {
            zero = false
        }
        i = i + 1
    }
    zero
}

/// True iff 32 big-endian bytes name a value >= n (the FIPS 186-5
/// r/s range check and RFC 6979's candidate acceptance). ct: the
/// early-exit compare is the recorded 6979 exception in the module
/// header (the RFC's own rejection sampling); r and s are public.
fn bytes_geq_n(b: List[int]) -> bool {
    let nb = n_bytes()
    var i: int = 0
    while i < 32 {
        if b[i] > nb[i] {
            return true
        }
        if b[i] < nb[i] {
            return false
        }
        i = i + 1
    }
    true
}

/// True iff 32 big-endian bytes name a value < p (SEC1 §3.2.2's
/// coordinate range check). ct: public data (an ingested point).
fn bytes_lt_p(b: List[int]) -> bool {
    let pb = p_bytes()
    var i: int = 0
    while i < 32 {
        if b[i] < pb[i] {
            return true
        }
        if b[i] > pb[i] {
            return false
        }
        i = i + 1
    }
    false
}

// ---------------------------------------------------------------------
// Byte / point helpers, on-curve validation (SEC1 §3.2.2 — the
// invalid-curve rejection), affine conversion.
// ---------------------------------------------------------------------

/// The 0..255 ingestion guard (F-0035's byte contract). ct: NOT free of
/// a value-dependent branch — the module's recorded ct exception,
/// shared verbatim with the whole ladder; runs on public bytes.
fn require_byte(v: int) {
    if v < 0 {
        assert(false, "p256: element outside 0..255")
    }
    if v > 255 {
        assert(false, "p256: element outside 0..255")
    }
}

/// A validated point, or the marker that decoding rejected it (a bad
/// length, a coordinate >= p, or a point not on the curve — the
/// invalid-curve class). The point is meaningful only when `ok`.
struct PtOpt {
    ok: bool,
    p: Pt,
}

/// True iff the affine point (x, y) satisfies y^2 = x^3 - 3x + b (the
/// P-256 curve equation, a = -3; SEC1 §3.2.2's on-curve test). The
/// caller passes a point with z = 1. ct: public data (verify-side).
fn on_curve(x: Fe, y: Fe) -> bool {
    let lhs = fe_sq(y)
    let x2 = fe_sq(x)
    let x3 = fe_mul(x2, x)
    let three_x = fe_add(fe_add(x, x), x)
    let rhs = fe_add(fe_sub(x3, three_x), fe_b())
    fe_eq(lhs, rhs)
}

/// Decode a 65-byte uncompressed SEC1 point (0x04 || X || Y), REJECTING
/// a wrong length or lead byte, a coordinate >= p (non-canonical), and
/// — mandatorily, SEC1 §3.2.2 — a point that is not on the curve (the
/// invalid-curve attack class: an attacker who supplies an off-curve
/// point can, against a naive implementation, recover the private
/// scalar; Wycheproof patrols exactly this). The point at infinity has
/// no uncompressed encoding here, so it is rejected by length. ct:
/// public data — an ingested public key or ephemeral point.
fn decode_point(b: List[int]) -> PtOpt {
    if b.len != 65 {
        return PtOpt { ok: false, p: pt_identity() }
    }
    for v in b {
        require_byte(v)
    }
    if b[0] != 4 {
        return PtOpt { ok: false, p: pt_identity() }
    }
    var xb = List[int]()
    var yb = List[int]()
    var i: int = 1
    while i < 33 {
        (mut xb).push(b[i])
        i = i + 1
    }
    while i < 65 {
        (mut yb).push(b[i])
        i = i + 1
    }
    if !bytes_lt_p(xb) {
        return PtOpt { ok: false, p: pt_identity() }
    }
    if !bytes_lt_p(yb) {
        return PtOpt { ok: false, p: pt_identity() }
    }
    let x = fe_frombytes_be(xb)
    let y = fe_frombytes_be(yb)
    if !on_curve(x, y) {
        return PtOpt { ok: false, p: pt_identity() }
    }
    PtOpt { ok: true, p: Pt { x: x, y: y, z: fe_one() } }
}

/// The affine x-coordinate of a projective point, as 32 big-endian
/// bytes, reduced mod n (ECDSA's r and the verification value are
/// x-coordinates taken mod n). The point must not be the identity —
/// every caller checks z != 0 first. ct: public in verify; on signing
/// the value becomes r (public once computed).
fn affine_x_mod_n(pp: Pt) -> List[int] {
    let zi = fe_invert(pp.z)
    let x = fe_mul(pp.x, zi)
    let xb = fe_tobytes_be(x)
    sc_to_bytes_be(sc_from_bytes_be(xb))
}

// ---------------------------------------------------------------------
// RFC 6979 deterministic nonce generation (HMAC-SHA-256, qlen = 256).
// HMAC is sha2's, through the module boundary. The construction is
// §3.2: K/V seeded from the private key and the message hash, then a
// generate-and-test loop that yields the first candidate in [1, n).
// ---------------------------------------------------------------------

/// bits2octets(SHA-256(msg)) of §2.3.4: the 32-byte hash is already
/// 256 bits (qlen), so bits2int is the identity and the reduction mod n
/// is one conditional subtraction — `sc_from_bytes_be` then re-encode.
/// ct: on the message hash (public) and, in the seed, mixed with the
/// secret key inside HMAC.
fn bits2octets(h: List[int]) -> List[int] {
    sc_to_bytes_be(sc_from_bytes_be(h))
}

/// The RFC 6979 §3.2 deterministic nonce for private key `x` (32-byte
/// big-endian) and message hash `h1` (SHA-256, 32 bytes): returns the
/// first HMAC_DRBG candidate that lands in [1, n). ct: THE SECRET PATH —
/// the key enters every HMAC; the schedule is fixed except the
/// candidate-acceptance compare (`bytes_geq_n`), the RFC's own
/// rejection sampling, which for P-256 rejects with probability < 2^-32
/// per round (recorded exception in the module header).
fn rfc6979_nonce(x: List[int], h1: List[int]) -> List[int] {
    let h1o = bits2octets(h1)
    var v = List[int]()
    var k = List[int]()
    var i: int = 0
    while i < 32 {
        (mut v).push(1)
        (mut k).push(0)
        i = i + 1
    }
    // K = HMAC_K(V || 0x00 || int2octets(x) || bits2octets(h1))
    var seed0 = cat(v, one_byte(0))
    seed0 = cat(seed0, x)
    seed0 = cat(seed0, h1o)
    k = sha2.hmac256(k, seed0)
    v = sha2.hmac256(k, v)
    // K = HMAC_K(V || 0x01 || int2octets(x) || bits2octets(h1))
    var seed1 = cat(v, one_byte(1))
    seed1 = cat(seed1, x)
    seed1 = cat(seed1, h1o)
    k = sha2.hmac256(k, seed1)
    v = sha2.hmac256(k, v)
    var found = false
    var out = List[int]()
    while !found {
        v = sha2.hmac256(k, v)
        // qlen == hlen == 256, so T = V is the candidate directly
        if !bytes_geq_n(v) {
            if !is_zero_bytes(v) {
                out = copy v
                found = true
            }
        }
        if !found {
            k = sha2.hmac256(k, cat(v, one_byte(0)))
            v = sha2.hmac256(k, v)
        }
    }
    out
}

/// A one-element byte list (the RFC 6979 separators). ct: fixed.
fn one_byte(v: int) -> List[int] {
    var out = List[int]()
    (mut out).push(v)
    out
}

/// Concatenate two byte lists. ct: fixed by the lengths.
fn cat(a: List[int], b: List[int]) -> List[int] {
    var out = List[int]()
    for v in a {
        (mut out).push(v)
    }
    for v in b {
        (mut out).push(v)
    }
    out
}

/// True iff every byte is zero. ct: on public/derived values.
fn is_zero_bytes(b: List[int]) -> bool {
    var all_zero = true
    for v in b {
        if !(v == 0) {
            all_zero = false
        }
    }
    all_zero
}

// ---------------------------------------------------------------------
// ECDSA (FIPS 186-5). VERIFY is public data; SIGN is the secret path
// with an RFC 6979 nonce. SHA-256 is sha2's, through the boundary.
// ---------------------------------------------------------------------

/// The ECDSA public key for a 32-byte big-endian private key `d` in
/// [1, n): the uncompressed SEC1 encoding of [d]G (0x04 || X || Y).
/// Traps `assert` on a private key that is not 32 bytes, carries a
/// non-byte element, or is zero / >= n (a caller contract violation:
/// FIPS 186-5 §6.2.1 requires d in [1, n-1]). ct: SECRET scalar `d`
/// drives the table-free ladder (`scalar_mul`, c28's target); the
/// derived public key is public.
///
/// Example (native lane — a scalar multiplication is a table-free
/// ladder past lupin's step budget, so this is prose not a fenced
/// block; the pinned witnesses are `rfc6979_p256.lu` and
/// `sign_verify_smoke.lu`): `p256.public_key(d)` returns 65 bytes for a
/// 32-byte private key `d` in [1, n).
pub fn public_key(d: List[int]) -> List[int] {
    require_private(d)
    let q = scalar_mul(d, pt_base())
    encode_point(q)
}

/// Encode a non-identity projective point as 65 uncompressed SEC1
/// bytes. ct: public (a public key or a computed R).
fn encode_point(pp: Pt) -> List[int] {
    let zi = fe_invert(pp.z)
    let x = fe_mul(pp.x, zi)
    let y = fe_mul(pp.y, zi)
    var out = List[int]()
    (mut out).push(4)
    for v in fe_tobytes_be(x) {
        (mut out).push(v)
    }
    for v in fe_tobytes_be(y) {
        (mut out).push(v)
    }
    out
}

/// Require a 32-byte private key in [1, n) (FIPS 186-5 §6.2.1). A wrong
/// length, a non-byte element, zero, or >= n is a caller contract
/// violation, not a recoverable row — traps `assert`.
fn require_private(d: List[int]) {
    if !(d.len == 32) {
        assert(false, "p256: a private key is 32 bytes (SEC1 §2.3.5)")
    }
    for v in d {
        require_byte(v)
    }
    if bytes_geq_n(d) {
        assert(false, "p256: a private key is < n (FIPS 186-5 §6.2.1)")
    }
    if is_zero_bytes(d) {
        assert(false, "p256: a private key is nonzero (FIPS 186-5 §6.2.1)")
    }
}

/// An ECDSA signature over `message` under the 32-byte big-endian
/// private key `d`, as the 64-byte fixed-width r || s (each 32 bytes,
/// big-endian — the JOSE / IEEE P1363 form; DER is `signature_der`).
/// The message is hashed with SHA-256 (ES256). The nonce is RFC 6979
/// DETERMINISTIC — derived from `d` and the message, drawing NO entropy
/// (the design ruling: no nonce-reuse hazard, no os capability, byte-
/// exact testable). Retries the RFC 6979 candidate on the ~2^-256
/// events r = 0 or s = 0. Traps `assert` on a bad private key (see
/// `public_key`); the message is arbitrary bytes.
/// ct: THE SECRET PATH. `d` and the nonce drive the RFC 6979 HMAC
/// chain, `scalar_mul` (c28's target) and the mod-n arithmetic; the
/// enumerated obligations are the ladder, `fe_select`, and the noted
/// exceptions in the module header. No randomness, so no reuse hazard.
///
/// Example (native lane, prose — the sign path is a table-free ladder
/// past lupin's step budget; pinned byte-exact in `rfc6979_p256.lu`):
/// `p256.sign(d, msg)` returns a 64-byte r || s that
/// `p256.verify(p256.public_key(d), msg, sig)` accepts.
pub fn sign(d: List[int], message: List[int]) -> List[int] {
    require_private(d)
    for m in message {
        require_byte(m)
    }
    let h1 = sha2.sum256(message)
    let e = sc_from_bytes_be(h1)
    var attempt = copy d
    var done = false
    var out = List[int]()
    // The RFC 6979 nonce is deterministic; on the vanishing r=0/s=0
    // events §3.2 step h.3 draws the NEXT DRBG candidate. This module
    // reseeds the generator with a domain-separated key instead (an
    // equivalent, simpler fixed-schedule retry that never fires for the
    // test corpus); the loop bound is data-independent in practice.
    var salt: int = 0
    while !done {
        let k_bytes = rfc6979_nonce_salted(d, h1, salt)
        let k = sc_from_bytes_be(k_bytes)
        let rpt = scalar_mul(k_bytes, pt_base())
        if !fe_iszero(rpt.z) {
            let r = affine_x_mod_n(rpt)
            let rsc = sc_from_bytes_be(r)
            if !sc_iszero(rsc) {
                let kinv = sc_inv(k)
                let rd = sc_mul(rsc, sc_from_bytes_be(d))
                let s = sc_mul(kinv, sc_add(e, rd))
                if !sc_iszero(s) {
                    out = cat(sc_to_bytes_be(rsc), sc_to_bytes_be(s))
                    done = true
                }
            }
        }
        salt = salt + 1
    }
    out
}

/// The RFC 6979 nonce with a retry salt: salt 0 is the standard
/// construction (§3.2, and what the A.2.5 vectors pin); a nonzero salt
/// re-runs the HMAC_DRBG with `salt` extra generate rounds skipped,
/// used only on the ~2^-256 r=0/s=0 retry. ct: as `rfc6979_nonce`.
fn rfc6979_nonce_salted(x: List[int], h1: List[int], salt: int) -> List[int] {
    if salt == 0 {
        return rfc6979_nonce(x, h1)
    }
    // deterministic extra draws (never reached by any test vector)
    let h1o = bits2octets(h1)
    var v = List[int]()
    var k = List[int]()
    var i: int = 0
    while i < 32 {
        (mut v).push(1)
        (mut k).push(0)
        i = i + 1
    }
    var seed0 = cat(cat(v, one_byte(0)), cat(x, h1o))
    k = sha2.hmac256(k, seed0)
    v = sha2.hmac256(k, v)
    var seed1 = cat(cat(v, one_byte(1)), cat(x, h1o))
    k = sha2.hmac256(k, seed1)
    v = sha2.hmac256(k, v)
    var skip: int = 0
    var out = List[int]()
    var found = false
    while !found {
        v = sha2.hmac256(k, v)
        if !bytes_geq_n(v) {
            if !is_zero_bytes(v) {
                if skip >= salt {
                    out = copy v
                    found = true
                }
                skip = skip + 1
            }
        }
        if !found {
            k = sha2.hmac256(k, cat(v, one_byte(0)))
            v = sha2.hmac256(k, v)
        }
    }
    out
}

/// Verify an ECDSA signature (FIPS 186-5 §6.4.2) over `message` given a
/// 65-byte uncompressed SEC1 public key and the 64-byte r || s
/// signature. Returns true iff valid. Answers FALSE — never a trap —
/// for a wrong-length key or signature, a non-byte element, a public
/// key that fails the SEC1 §3.2.2 on-curve check (the invalid-curve
/// rejection), r or s outside [1, n), or a failed verification
/// equation: a signature and a key are the CALLER'S data to check, not
/// a contract they promised (§2's rule). The message is hashed with
/// SHA-256 (ES256).
/// ct: VERIFY IS PUBLIC DATA — the key, signature and message are all
/// public, so no branch here protects a secret and this function
/// carries no constant-time obligation (the sc18 rule).
///
/// Example (native lane, prose — a verify is two table-free ladders
/// past lupin's step budget; pinned by the CAVP/Wycheproof suites and
/// `sign_verify_smoke.lu`): `p256.verify(p256.public_key(d), msg,
/// p256.sign(d, msg))` is true; a flipped signature byte is false.
pub fn verify(pubkey: List[int], message: List[int], sig: List[int]) -> bool {
    if !(pubkey.len == 65) {
        return false
    }
    if !(sig.len == 64) {
        return false
    }
    for v in pubkey {
        if v < 0 {
            return false
        }
        if v > 255 {
            return false
        }
    }
    for v in sig {
        if v < 0 {
            return false
        }
        if v > 255 {
            return false
        }
    }
    var rb = List[int]()
    var sb = List[int]()
    var i: int = 0
    while i < 32 {
        (mut rb).push(sig[i])
        i = i + 1
    }
    while i < 64 {
        (mut sb).push(sig[i])
        i = i + 1
    }
    // r, s in [1, n)
    if bytes_geq_n(rb) {
        return false
    }
    if bytes_geq_n(sb) {
        return false
    }
    let r = sc_from_bytes_be(rb)
    let s = sc_from_bytes_be(sb)
    if sc_iszero(r) {
        return false
    }
    if sc_iszero(s) {
        return false
    }
    let q = decode_point(pubkey)
    if !q.ok {
        return false
    }
    let e = sc_from_bytes_be(sha2.sum256(message))
    let w = sc_inv(s)
    let u1 = sc_to_bytes_be(sc_mul(e, w))
    let u2 = sc_to_bytes_be(sc_mul(r, w))
    let rp = pt_add(scalar_mul(u1, pt_base()), scalar_mul(u2, q.p))
    if fe_iszero(rp.z) {
        return false
    }
    let v = affine_x_mod_n(rp)
    bytes_eq(v, rb)
}

/// Byte-list equality. ct: public data (verify-side r comparison).
fn bytes_eq(a: List[int], b: List[int]) -> bool {
    if a.len != b.len {
        return false
    }
    var i: int = 0
    var same = true
    while i < a.len {
        if !(a[i] == b[i]) {
            same = false
        }
        i = i + 1
    }
    same
}

// ---------------------------------------------------------------------
// DER signature codec (X.690) — the form X.509 / TLS carry. A DER
// ECDSA signature is SEQUENCE { INTEGER r, INTEGER s }; sc22's cert
// hands verify_der exactly these bytes.
// ---------------------------------------------------------------------

/// The result of DER parsing: `ok` false means the bytes are not a
/// strict-DER SEQUENCE{INTEGER, INTEGER} within the P-256 size bounds.
struct SigOpt {
    ok: bool,
    sig: List[int],
}

/// Parse a strict-DER ECDSA signature to the 64-byte r || s form,
/// REJECTING (ok = false) every X.690 violation Wycheproof patrols:
/// wrong outer tag, a length not matching the content, a non-INTEGER
/// element, an empty INTEGER, a negative INTEGER (high bit set), a
/// non-minimal INTEGER (leading 0x00 where the next byte's high bit is
/// clear), long-form lengths beyond one length octet (r and s are at
/// most 33 content octets), and trailing garbage. r or s wider than 32
/// content octets after the optional leading zero is out of range and
/// rejected. ct: public data (a signature to check).
fn parse_der(b: List[int]) -> SigOpt {
    let bad = SigOpt { ok: false, sig: List[int]() }
    if b.len < 8 {
        return bad
    }
    for v in b {
        require_byte(v)
    }
    if b[0] != 48 {
        return bad
    }
    let l = b[1]
    // one length octet only (a P-256 sig is < 128 bytes of content)
    if l > 127 {
        return bad
    }
    if l + 2 != b.len {
        return bad
    }
    let r_res = read_der_int(b, 2)
    if r_res.stop < 0 {
        return bad
    }
    let s_res = read_der_int(b, r_res.stop)
    if s_res.stop < 0 {
        return bad
    }
    if s_res.stop != b.len {
        return bad
    }
    var out = List[int]()
    for v in left_pad32(r_res.val) {
        (mut out).push(v)
    }
    for v in left_pad32(s_res.val) {
        (mut out).push(v)
    }
    SigOpt { ok: true, sig: out }
}

/// A parsed DER INTEGER: `val` the big-endian magnitude bytes,
/// `stop` the offset after it (or -1 on any violation).
struct DerInt {
    val: List[int],
    stop: int,
}

/// Read one strict-DER INTEGER at offset `at`. Returns stop = -1 on a
/// non-INTEGER tag, an empty or over-long body, a negative value, or a
/// non-minimal encoding (X.690 §8.3.2). ct: public data.
fn read_der_int(b: List[int], at: int) -> DerInt {
    let fail = DerInt { val: List[int](), stop: 0 - 1 }
    if at + 2 > b.len {
        return fail
    }
    if b[at] != 2 {
        return fail
    }
    let ln = b[at + 1]
    if ln > 127 {
        return fail
    }
    if ln == 0 {
        return fail
    }
    let start = at + 2
    if start + ln > b.len {
        return fail
    }
    var body = List[int]()
    var i: int = start
    while i < start + ln {
        (mut body).push(b[i])
        i = i + 1
    }
    // high bit set => negative (ECDSA r/s are nonnegative)
    if body[0] >= 128 {
        return fail
    }
    // non-minimal: leading 0x00 whose successor's high bit is clear
    if ln > 1 {
        if body[0] == 0 {
            if body[1] < 128 {
                return fail
            }
        }
    }
    // strip an optional single leading zero (a legal DER pad appears
    // only when body[0] == 0, and non-minimality is already rejected
    // above), then bound to 32 octets
    var strip = 0
    if body[0] == 0 {
        strip = 1
    }
    var mag = List[int]()
    var j: int = 0
    for v in body {
        if j >= strip {
            (mut mag).push(v)
        }
        j = j + 1
    }
    if mag.len > 32 {
        return fail
    }
    DerInt { val: mag, stop: start + ln }
}

/// Left-pad a big-endian magnitude to 32 bytes. ct: fixed by length.
fn left_pad32(mag: List[int]) -> List[int] {
    var out = List[int]()
    var pad: int = 32 - mag.len
    var i: int = 0
    while i < pad {
        (mut out).push(0)
        i = i + 1
    }
    for v in mag {
        (mut out).push(v)
    }
    out
}

/// Verify an ECDSA signature supplied in DER form (SEQUENCE{INTEGER r,
/// INTEGER s}) — the encoding X.509 certificates and TLS carry, and
/// exactly what sc22's chain validator hands this module. Strict DER:
/// a malformed encoding answers FALSE (never a trap), by the same rule
/// as `verify`. ct: public data.
///
/// Example (native lane, prose — a verify is two table-free ladders
/// past lupin's step budget; the strict-DER rejections are pinned
/// three-lane in `der_codec.lu`): `p256.verify_der(pk, msg,
/// p256.signature_der(p256.sign(d, msg)))` is true, and a malformed
/// DER signature is false, never a trap.
pub fn verify_der(pubkey: List[int], message: List[int], der: List[int]) -> bool {
    let parsed = parse_der(der)
    if !parsed.ok {
        return false
    }
    verify(pubkey, message, parsed.sig)
}

/// Encode a 64-byte r || s signature as strict DER (SEQUENCE{INTEGER r,
/// INTEGER s}) — the form for an X.509/TLS consumer. Each half becomes
/// a minimal nonnegative INTEGER (a leading 0x00 added when the high
/// bit is set). Traps `assert` on a signature that is not 64 bytes.
/// ct: public data.
pub fn signature_der(sig: List[int]) -> List[int] {
    if !(sig.len == 64) {
        assert(false, "p256: a raw signature is 64 bytes (r||s)")
    }
    var rb = List[int]()
    var sb = List[int]()
    var i: int = 0
    while i < 32 {
        (mut rb).push(sig[i])
        i = i + 1
    }
    while i < 64 {
        (mut sb).push(sig[i])
        i = i + 1
    }
    let ri = der_int(rb)
    let si = der_int(sb)
    let total = ri.len + si.len
    var out = List[int]()
    (mut out).push(48)
    (mut out).push(total)
    for v in ri {
        (mut out).push(v)
    }
    for v in si {
        (mut out).push(v)
    }
    out
}

/// Encode a 32-byte big-endian magnitude as a minimal DER INTEGER TLV
/// (strip leading zeros, prepend 0x00 if the top bit would read
/// negative). ct: public data.
fn der_int(mag32: List[int]) -> List[int] {
    // strip leading zero bytes (keep at least one byte)
    var start: int = 0
    var scanning = true
    var i: int = 0
    for v in mag32 {
        if scanning {
            if v == 0 {
                if i < 31 {
                    start = start + 1
                }
            } else {
                scanning = false
            }
        }
        i = i + 1
    }
    var body = List[int]()
    var j: int = 0
    for v in mag32 {
        if j >= start {
            (mut body).push(v)
        }
        j = j + 1
    }
    var content = List[int]()
    if body[0] >= 128 {
        (mut content).push(0)
    }
    for v in body {
        (mut content).push(v)
    }
    var out = List[int]()
    (mut out).push(2)
    (mut out).push(content.len)
    for v in content {
        (mut out).push(v)
    }
    out
}

// ---------------------------------------------------------------------
// Field / curve self-test: the arithmetic proven ALONE, before any
// signature observes it (the sprint's field-first discipline). The
// field ops are module-private, observable only through this pub
// predicate — the rig's field-alone unit proof, three-lane.
// (Authoring-time proof, one level deeper: the Python bound-harness in
// the sprint's work notes fuzzed every fe_* / sc_* / pt_* against a
// big-integer reference with live checked-overflow asserts matching
// wolf's int semantics — 3000 random + adversarial field cases, 60
// point-formula rounds incl. the complete-formula edge cases, the
// mod-n field, and the RFC 6979 vectors end-to-end — where the 2^35.4
// column bound and the 2^48.0 carry bound were measured.)
// ---------------------------------------------------------------------

/// A field element from a byte pattern (a self-test helper). ct: not a
/// secret path.
fn fe_sample(seed: int) -> Fe {
    var b = List[int]()
    var i: int = 0
    while i < 32 {
        (mut b).push((seed + i * 7) % 251)
        i = i + 1
    }
    fe_frombytes_be(b)
}

/// The FIELD's algebraic identities plus the cheap curve laws, checked
/// ALONE before any ECDSA path observes them (the field-first
/// discipline): additive inverse, multiply commutativity /
/// associativity, distributivity, squaring as self-multiply, the
/// Fermat inverse (a·a⁻¹ = 1), the byte round trip, that G is on the
/// curve (SEC1 §3.2.2), and that the COMPLETE addition and doubling
/// agree on [2]G. No 256-iteration scalar multiplication, so this fits
/// the checked tier's step budget — THREE-LANE (the group-order check
/// that needs a full ladder is in `self_test`). Returns true iff every
/// identity holds. ct: a test predicate over public constants.
///
/// ```wolf-doc-example
/// p256.field_self_test()
/// ```
pub fn field_self_test() -> bool {
    let a = fe_sample(1)
    let b = fe_sample(40)
    let c = fe_sample(130)
    var ok = true
    if !fe_eq(fe_sub(fe_add(a, b), b), a) {
        ok = false
    }
    if !fe_eq(fe_mul(a, b), fe_mul(b, a)) {
        ok = false
    }
    if !fe_eq(fe_mul(fe_mul(a, b), c), fe_mul(a, fe_mul(b, c))) {
        ok = false
    }
    if !fe_eq(fe_mul(a, fe_add(b, c)), fe_add(fe_mul(a, b), fe_mul(a, c))) {
        ok = false
    }
    if !fe_eq(fe_sq(a), fe_mul(a, a)) {
        ok = false
    }
    if !fe_eq(fe_mul(a, fe_invert(a)), fe_one()) {
        ok = false
    }
    if !fe_eq(fe_frombytes_be(fe_tobytes_be(a)), a) {
        ok = false
    }
    if !on_curve(fe_gx(), fe_gy()) {
        ok = false
    }
    let g = pt_base()
    if !pt_eq(pt_double(g), pt_add(g, g)) {
        ok = false
    }
    ok
}

/// The full self-test: `field_self_test` plus the GROUP-ORDER check
/// that [n-1]G + G is the identity (so [n]G = O, n the group order) —
/// a full table-free ladder, so this exceeds the checked tier's step
/// budget and lupin's evaluation budget (native + `slow`, the ladder
/// precedent). Returns true iff every identity and the group law hold.
/// ct: a test predicate over public constants; no secret.
pub fn self_test() -> bool {
    if !field_self_test() {
        return false
    }
    let g = pt_base()
    var nm1 = List[int]()
    for v in n_bytes() {
        (mut nm1).push(v)
    }
    nm1[31] = nm1[31] - 1
    let ng = pt_add(scalar_mul(nm1, g), g)
    fe_iszero(ng.z)
}

/// Projective point equality (X1·Z2 == X2·Z1 and Y1·Z2 == Y2·Z1).
/// ct: public data (self-test only).
fn pt_eq(p1: Pt, p2: Pt) -> bool {
    let ax = fe_eq(fe_mul(p1.x, p2.z), fe_mul(p2.x, p1.z))
    let ay = fe_eq(fe_mul(p1.y, p2.z), fe_mul(p2.y, p1.z))
    ax && ay
}

// ---------------------------------------------------------------------
// Rendering (this module's own; the ladder precedent).
// ---------------------------------------------------------------------

/// `b` as lowercase hexadecimal, two digits per byte. Traps `assert`
/// only on a non-byte element. ct: NOT constant-time (the alphabet
/// slice is indexed by each byte's value) — renders public values only;
/// a constant-time encoder is c28-tier work.
///
/// ```wolf-doc-example
/// p256.to_hex("abc".bytes()) == "616263"
/// p256.to_hex(List[int]()) == ""
/// ```
pub fn to_hex(b: List[int]) -> str {
    let alphabet = "0123456789abcdef"
    var out = ""
    for v in b {
        require_byte(v)
        let hi = v / 16
        let lo = v % 16
        let hd = alphabet[hi..hi + 1]
        let ld = alphabet[lo..lo + 1]
        out = "{out}{hd}{ld}"
    }
    out
}
