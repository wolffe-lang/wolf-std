/// The field's additive identity. Total.
fn fe_zero() -> Fe {
    Fe {
        l0: 0,
        l1: 0,
        l2: 0,
        l3: 0,
        l4: 0,
        l5: 0,
        l6: 0,
        l7: 0,
        l8: 0,
        l9: 0,
        l10: 0,
        l11: 0,
        l12: 0,
        l13: 0,
        l14: 0,
        l15: 0,
    }
}

/// The field's multiplicative identity. Total.
fn fe_one() -> Fe {
    Fe {
        l0: 1,
        l1: 0,
        l2: 0,
        l3: 0,
        l4: 0,
        l5: 0,
        l6: 0,
        l7: 0,
        l8: 0,
        l9: 0,
        l10: 0,
        l11: 0,
        l12: 0,
        l13: 0,
        l14: 0,
        l15: 0,
    }
}

/// Floor division (wolf's `/` truncates toward zero; the signed carry
/// passes need floor — the sc10/sc18 correction). ct: the sign test is
/// the recorded exception shared with sc18's scalar reduction; in
/// aggregate the carry schedule is fixed.
fn floordiv(a: int, b: int) -> int {
    let q = a / b
    if a - q * b < 0 {
        return q - 1
    }
    q
}

/// 2^k for k in 0..7 (the ladder's bit selector; a shift on plain
/// `int` costs the checked lane, F-0026). ct: fixed.
fn pow2(k: int) -> int {
    if k == 0 {
        return 1
    }
    if k == 1 {
        return 2
    }
    if k == 2 {
        return 4
    }
    if k == 3 {
        return 8
    }
    if k == 4 {
        return 16
    }
    if k == 5 {
        return 32
    }
    if k == 6 {
        return 64
    }
    128
}

/// The Solinas carry tail. Adds the constant 2^32·p (so any signed
/// fold output becomes nonnegative in total — K·p > |input| for every
/// input this module produces, measured at 2^48 worst limb), then four
/// base-2^16 carry passes; after each of the first three, the carry out
/// of limb 15 (the 2^256 overflow) re-enters through the identity
/// 2^256 ≡ 2^224 - 2^192 - 2^96 + 1 (mod p): +c at limb 0, -c at limb
/// 6 (2^96), -c at limb 12 (2^192), +c at limb 14 (2^224). The fourth
/// pass's carry is zero by the convergence argument in the module
/// header's bound proof (value < 2^256 after three folds), fuzz-checked
/// against a big-integer reference. Output limbs in [0, 2^16), value
/// < 2^256 (NOT canonical — `fe_freeze` canonicalizes).
/// ct: fixed schedule, data-independent (floordiv's noted exception).
fn fe_carry(f: Fe) -> Fe {
    let kp0: int = 0
    let kp1: int = 0
    let kp2: int = 65535
    let kp3: int = 65535
    let kp4: int = 65535
    let kp5: int = 65535
    let kp6: int = 65535
    let kp7: int = 65535
    let kp8: int = 0
    let kp9: int = 0
    let kp10: int = 0
    let kp11: int = 0
    let kp12: int = 0
    let kp13: int = 0
    let kp14: int = 1
    let kp15: int = 281474976645120
    var d0: int = f.l0 + kp0
    var d1: int = f.l1 + kp1
    var d2: int = f.l2 + kp2
    var d3: int = f.l3 + kp3
    var d4: int = f.l4 + kp4
    var d5: int = f.l5 + kp5
    var d6: int = f.l6 + kp6
    var d7: int = f.l7 + kp7
    var d8: int = f.l8 + kp8
    var d9: int = f.l9 + kp9
    var d10: int = f.l10 + kp10
    var d11: int = f.l11 + kp11
    var d12: int = f.l12 + kp12
    var d13: int = f.l13 + kp13
    var d14: int = f.l14 + kp14
    var d15: int = f.l15 + kp15
    var c: int = 0
    var v: int = 0
    // carry pass 1
    v = d0
    c = floordiv(v, 65536)
    d0 = v - c * 65536
    v = d1 + c
    c = floordiv(v, 65536)
    d1 = v - c * 65536
    v = d2 + c
    c = floordiv(v, 65536)
    d2 = v - c * 65536
    v = d3 + c
    c = floordiv(v, 65536)
    d3 = v - c * 65536
    v = d4 + c
    c = floordiv(v, 65536)
    d4 = v - c * 65536
    v = d5 + c
    c = floordiv(v, 65536)
    d5 = v - c * 65536
    v = d6 + c
    c = floordiv(v, 65536)
    d6 = v - c * 65536
    v = d7 + c
    c = floordiv(v, 65536)
    d7 = v - c * 65536
    v = d8 + c
    c = floordiv(v, 65536)
    d8 = v - c * 65536
    v = d9 + c
    c = floordiv(v, 65536)
    d9 = v - c * 65536
    v = d10 + c
    c = floordiv(v, 65536)
    d10 = v - c * 65536
    v = d11 + c
    c = floordiv(v, 65536)
    d11 = v - c * 65536
    v = d12 + c
    c = floordiv(v, 65536)
    d12 = v - c * 65536
    v = d13 + c
    c = floordiv(v, 65536)
    d13 = v - c * 65536
    v = d14 + c
    c = floordiv(v, 65536)
    d14 = v - c * 65536
    v = d15 + c
    c = floordiv(v, 65536)
    d15 = v - c * 65536
    // fold the 2^256 overflow: c·(2^224 - 2^192 - 2^96 + 1)
    d0 = d0 + c
    d6 = d6 - c
    d12 = d12 - c
    d14 = d14 + c
    // carry pass 2
    v = d0
    c = floordiv(v, 65536)
    d0 = v - c * 65536
    v = d1 + c
    c = floordiv(v, 65536)
    d1 = v - c * 65536
    v = d2 + c
    c = floordiv(v, 65536)
    d2 = v - c * 65536
    v = d3 + c
    c = floordiv(v, 65536)
    d3 = v - c * 65536
    v = d4 + c
    c = floordiv(v, 65536)
    d4 = v - c * 65536
    v = d5 + c
    c = floordiv(v, 65536)
    d5 = v - c * 65536
    v = d6 + c
    c = floordiv(v, 65536)
    d6 = v - c * 65536
    v = d7 + c
    c = floordiv(v, 65536)
    d7 = v - c * 65536
    v = d8 + c
    c = floordiv(v, 65536)
    d8 = v - c * 65536
    v = d9 + c
    c = floordiv(v, 65536)
    d9 = v - c * 65536
    v = d10 + c
    c = floordiv(v, 65536)
    d10 = v - c * 65536
    v = d11 + c
    c = floordiv(v, 65536)
    d11 = v - c * 65536
    v = d12 + c
    c = floordiv(v, 65536)
    d12 = v - c * 65536
    v = d13 + c
    c = floordiv(v, 65536)
    d13 = v - c * 65536
    v = d14 + c
    c = floordiv(v, 65536)
    d14 = v - c * 65536
    v = d15 + c
    c = floordiv(v, 65536)
    d15 = v - c * 65536
    // fold the 2^256 overflow: c·(2^224 - 2^192 - 2^96 + 1)
    d0 = d0 + c
    d6 = d6 - c
    d12 = d12 - c
    d14 = d14 + c
    // carry pass 3
    v = d0
    c = floordiv(v, 65536)
    d0 = v - c * 65536
    v = d1 + c
    c = floordiv(v, 65536)
    d1 = v - c * 65536
    v = d2 + c
    c = floordiv(v, 65536)
    d2 = v - c * 65536
    v = d3 + c
    c = floordiv(v, 65536)
    d3 = v - c * 65536
    v = d4 + c
    c = floordiv(v, 65536)
    d4 = v - c * 65536
    v = d5 + c
    c = floordiv(v, 65536)
    d5 = v - c * 65536
    v = d6 + c
    c = floordiv(v, 65536)
    d6 = v - c * 65536
    v = d7 + c
    c = floordiv(v, 65536)
    d7 = v - c * 65536
    v = d8 + c
    c = floordiv(v, 65536)
    d8 = v - c * 65536
    v = d9 + c
    c = floordiv(v, 65536)
    d9 = v - c * 65536
    v = d10 + c
    c = floordiv(v, 65536)
    d10 = v - c * 65536
    v = d11 + c
    c = floordiv(v, 65536)
    d11 = v - c * 65536
    v = d12 + c
    c = floordiv(v, 65536)
    d12 = v - c * 65536
    v = d13 + c
    c = floordiv(v, 65536)
    d13 = v - c * 65536
    v = d14 + c
    c = floordiv(v, 65536)
    d14 = v - c * 65536
    v = d15 + c
    c = floordiv(v, 65536)
    d15 = v - c * 65536
    // fold the 2^256 overflow: c·(2^224 - 2^192 - 2^96 + 1)
    d0 = d0 + c
    d6 = d6 - c
    d12 = d12 - c
    d14 = d14 + c
    // carry pass 4
    v = d0
    c = floordiv(v, 65536)
    d0 = v - c * 65536
    v = d1 + c
    c = floordiv(v, 65536)
    d1 = v - c * 65536
    v = d2 + c
    c = floordiv(v, 65536)
    d2 = v - c * 65536
    v = d3 + c
    c = floordiv(v, 65536)
    d3 = v - c * 65536
    v = d4 + c
    c = floordiv(v, 65536)
    d4 = v - c * 65536
    v = d5 + c
    c = floordiv(v, 65536)
    d5 = v - c * 65536
    v = d6 + c
    c = floordiv(v, 65536)
    d6 = v - c * 65536
    v = d7 + c
    c = floordiv(v, 65536)
    d7 = v - c * 65536
    v = d8 + c
    c = floordiv(v, 65536)
    d8 = v - c * 65536
    v = d9 + c
    c = floordiv(v, 65536)
    d9 = v - c * 65536
    v = d10 + c
    c = floordiv(v, 65536)
    d10 = v - c * 65536
    v = d11 + c
    c = floordiv(v, 65536)
    d11 = v - c * 65536
    v = d12 + c
    c = floordiv(v, 65536)
    d12 = v - c * 65536
    v = d13 + c
    c = floordiv(v, 65536)
    d13 = v - c * 65536
    v = d14 + c
    c = floordiv(v, 65536)
    d14 = v - c * 65536
    v = d15 + c
    c = floordiv(v, 65536)
    d15 = v - c * 65536
    Fe {
        l0: d0,
        l1: d1,
        l2: d2,
        l3: d3,
        l4: d4,
        l5: d5,
        l6: d6,
        l7: d7,
        l8: d8,
        l9: d9,
        l10: d10,
        l11: d11,
        l12: d12,
        l13: d13,
        l14: d14,
        l15: d15,
    }
}

/// Field addition (carried, not canonical). ct: fixed.
fn fe_add(f: Fe, g: Fe) -> Fe {
    fe_carry(Fe {
        l0: f.l0 + g.l0,
        l1: f.l1 + g.l1,
        l2: f.l2 + g.l2,
        l3: f.l3 + g.l3,
        l4: f.l4 + g.l4,
        l5: f.l5 + g.l5,
        l6: f.l6 + g.l6,
        l7: f.l7 + g.l7,
        l8: f.l8 + g.l8,
        l9: f.l9 + g.l9,
        l10: f.l10 + g.l10,
        l11: f.l11 + g.l11,
        l12: f.l12 + g.l12,
        l13: f.l13 + g.l13,
        l14: f.l14 + g.l14,
        l15: f.l15 + g.l15,
    })
}

/// Field subtraction. Limb differences may be negative; `fe_carry`'s
/// 2^32·p constant dominates them (the module header's bound proof), so
/// checked arithmetic never sees an out-of-range value. ct: fixed.
fn fe_sub(f: Fe, g: Fe) -> Fe {
    fe_carry(Fe {
        l0: f.l0 - g.l0,
        l1: f.l1 - g.l1,
        l2: f.l2 - g.l2,
        l3: f.l3 - g.l3,
        l4: f.l4 - g.l4,
        l5: f.l5 - g.l5,
        l6: f.l6 - g.l6,
        l7: f.l7 - g.l7,
        l8: f.l8 - g.l8,
        l9: f.l9 - g.l9,
        l10: f.l10 - g.l10,
        l11: f.l11 - g.l11,
        l12: f.l12 - g.l12,
        l13: f.l13 - g.l13,
        l14: f.l14 - g.l14,
        l15: f.l15 - g.l15,
    })
}

/// Field multiplication mod p: 16x16 schoolbook into 31 columns, a
/// nonnegative pre-carry to 32 sub-2^16 limbs, the descending Solinas
/// fold (limb k >= 16 re-enters at k-16, k-10, k-4, k-2 with signs
/// +,-,-,+ — SP 800-186's fast reduction, limb-aligned because
/// 96/192/224 are multiples of 16), then the carry tail.
///
/// THE BOUND PROOF (why checked `int` cannot trap): a carried limb is
/// < 2^16, one product < 2^32, a column sums at most 16 products —
/// < 2^36 (measured 2^35.4). The pre-carry leaves 32 limbs < 2^16, so
/// each descending fold adds at most four sub-2^16 terms amplified
/// through at most three in-edges per column: worst folded limb
/// measured 2^18.4, and the carry tail's 2^32·p constant tops out at
/// 2^48.0 on limb 15 — 32768x under int_max, X3-enforced at every op.
/// ct: fixed schedule, no branch, no secret-dependent index.
fn fe_mul(f: Fe, g: Fe) -> Fe {
    let f0: int = f.l0
    let f1: int = f.l1
    let f2: int = f.l2
    let f3: int = f.l3
    let f4: int = f.l4
    let f5: int = f.l5
    let f6: int = f.l6
    let f7: int = f.l7
    let f8: int = f.l8
    let f9: int = f.l9
    let f10: int = f.l10
    let f11: int = f.l11
    let f12: int = f.l12
    let f13: int = f.l13
    let f14: int = f.l14
    let f15: int = f.l15
    let g0: int = g.l0
    let g1: int = g.l1
    let g2: int = g.l2
    let g3: int = g.l3
    let g4: int = g.l4
    let g5: int = g.l5
    let g6: int = g.l6
    let g7: int = g.l7
    let g8: int = g.l8
    let g9: int = g.l9
    let g10: int = g.l10
    let g11: int = g.l11
    let g12: int = g.l12
    let g13: int = g.l13
    let g14: int = g.l14
    let g15: int = g.l15
    var m0: int = f0 * g0
    var m1: int = f0 * g1 + f1 * g0
    var m2: int = f0 * g2 + f1 * g1 + f2 * g0
    var m3: int = f0 * g3 + f1 * g2 + f2 * g1 + f3 * g0
    var m4: int = f0 * g4 + f1 * g3 + f2 * g2 + f3 * g1 + f4 * g0
    var m5: int = f0 * g5 + f1 * g4 + f2 * g3 + f3 * g2 + f4 * g1 + f5 * g0
    var m6: int = f0 * g6 + f1 * g5 + f2 * g4 + f3 * g3 + f4 * g2 + f5 * g1 + f6 * g0
    var m7: int = f0 * g7 + f1 * g6 + f2 * g5 + f3 * g4 + f4 * g3 + f5 * g2 + f6 * g1 + f7 * g0
    var m8: int = f0 * g8 +
        f1 * g7 +
        f2 * g6 +
        f3 * g5 +
        f4 * g4 +
        f5 * g3 +
        f6 * g2 +
        f7 * g1 +
        f8 * g0
    var m9: int = f0 * g9 +
        f1 * g8 +
        f2 * g7 +
        f3 * g6 +
        f4 * g5 +
        f5 * g4 +
        f6 * g3 +
        f7 * g2 +
        f8 * g1 +
        f9 * g0
    var m10: int = f0 * g10 +
        f1 * g9 +
        f2 * g8 +
        f3 * g7 +
        f4 * g6 +
        f5 * g5 +
        f6 * g4 +
        f7 * g3 +
        f8 * g2 +
        f9 * g1 +
        f10 * g0
    var m11: int = f0 * g11 +
        f1 * g10 +
        f2 * g9 +
        f3 * g8 +
        f4 * g7 +
        f5 * g6 +
        f6 * g5 +
        f7 * g4 +
        f8 * g3 +
        f9 * g2 +
        f10 * g1 +
        f11 * g0
    var m12: int = f0 * g12 +
        f1 * g11 +
        f2 * g10 +
        f3 * g9 +
        f4 * g8 +
        f5 * g7 +
        f6 * g6 +
        f7 * g5 +
        f8 * g4 +
        f9 * g3 +
        f10 * g2 +
        f11 * g1 +
        f12 * g0
    var m13: int = f0 * g13 +
        f1 * g12 +
        f2 * g11 +
        f3 * g10 +
        f4 * g9 +
        f5 * g8 +
        f6 * g7 +
        f7 * g6 +
        f8 * g5 +
        f9 * g4 +
        f10 * g3 +
        f11 * g2 +
        f12 * g1 +
        f13 * g0
    var m14: int = f0 * g14 +
        f1 * g13 +
        f2 * g12 +
        f3 * g11 +
        f4 * g10 +
        f5 * g9 +
        f6 * g8 +
        f7 * g7 +
        f8 * g6 +
        f9 * g5 +
        f10 * g4 +
        f11 * g3 +
        f12 * g2 +
        f13 * g1 +
        f14 * g0
    var m15: int = f0 * g15 +
        f1 * g14 +
        f2 * g13 +
        f3 * g12 +
        f4 * g11 +
        f5 * g10 +
        f6 * g9 +
        f7 * g8 +
        f8 * g7 +
        f9 * g6 +
        f10 * g5 +
        f11 * g4 +
        f12 * g3 +
        f13 * g2 +
        f14 * g1 +
        f15 * g0
    var m16: int = f1 * g15 +
        f2 * g14 +
        f3 * g13 +
        f4 * g12 +
        f5 * g11 +
        f6 * g10 +
        f7 * g9 +
        f8 * g8 +
        f9 * g7 +
        f10 * g6 +
        f11 * g5 +
        f12 * g4 +
        f13 * g3 +
        f14 * g2 +
        f15 * g1
    var m17: int = f2 * g15 +
        f3 * g14 +
        f4 * g13 +
        f5 * g12 +
        f6 * g11 +
        f7 * g10 +
        f8 * g9 +
        f9 * g8 +
        f10 * g7 +
        f11 * g6 +
        f12 * g5 +
        f13 * g4 +
        f14 * g3 +
        f15 * g2
    var m18: int = f3 * g15 +
        f4 * g14 +
        f5 * g13 +
        f6 * g12 +
        f7 * g11 +
        f8 * g10 +
        f9 * g9 +
        f10 * g8 +
        f11 * g7 +
        f12 * g6 +
        f13 * g5 +
        f14 * g4 +
        f15 * g3
    var m19: int = f4 * g15 +
        f5 * g14 +
        f6 * g13 +
        f7 * g12 +
        f8 * g11 +
        f9 * g10 +
        f10 * g9 +
        f11 * g8 +
        f12 * g7 +
        f13 * g6 +
        f14 * g5 +
        f15 * g4
    var m20: int = f5 * g15 +
        f6 * g14 +
        f7 * g13 +
        f8 * g12 +
        f9 * g11 +
        f10 * g10 +
        f11 * g9 +
        f12 * g8 +
        f13 * g7 +
        f14 * g6 +
        f15 * g5
    var m21: int = f6 * g15 +
        f7 * g14 +
        f8 * g13 +
        f9 * g12 +
        f10 * g11 +
        f11 * g10 +
        f12 * g9 +
        f13 * g8 +
        f14 * g7 +
        f15 * g6
    var m22: int = f7 * g15 +
        f8 * g14 +
        f9 * g13 +
        f10 * g12 +
        f11 * g11 +
        f12 * g10 +
        f13 * g9 +
        f14 * g8 +
        f15 * g7
    var m23: int = f8 * g15 +
        f9 * g14 +
        f10 * g13 +
        f11 * g12 +
        f12 * g11 +
        f13 * g10 +
        f14 * g9 +
        f15 * g8
    var m24: int = f9 * g15 + f10 * g14 + f11 * g13 + f12 * g12 + f13 * g11 + f14 * g10 + f15 * g9
    var m25: int = f10 * g15 + f11 * g14 + f12 * g13 + f13 * g12 + f14 * g11 + f15 * g10
    var m26: int = f11 * g15 + f12 * g14 + f13 * g13 + f14 * g12 + f15 * g11
    var m27: int = f12 * g15 + f13 * g14 + f14 * g13 + f15 * g12
    var m28: int = f13 * g15 + f14 * g14 + f15 * g13
    var m29: int = f14 * g15 + f15 * g14
    var m30: int = f15 * g15
    // pre-carry: 31 nonnegative columns to sub-2^16 limbs + overflow limb 31
    var c: int = 0
    var v: int = 0
    v = m0
    c = v / 65536
    m0 = v - c * 65536
    v = m1 + c
    c = v / 65536
    m1 = v - c * 65536
    v = m2 + c
    c = v / 65536
    m2 = v - c * 65536
    v = m3 + c
    c = v / 65536
    m3 = v - c * 65536
    v = m4 + c
    c = v / 65536
    m4 = v - c * 65536
    v = m5 + c
    c = v / 65536
    m5 = v - c * 65536
    v = m6 + c
    c = v / 65536
    m6 = v - c * 65536
    v = m7 + c
    c = v / 65536
    m7 = v - c * 65536
    v = m8 + c
    c = v / 65536
    m8 = v - c * 65536
    v = m9 + c
    c = v / 65536
    m9 = v - c * 65536
    v = m10 + c
    c = v / 65536
    m10 = v - c * 65536
    v = m11 + c
    c = v / 65536
    m11 = v - c * 65536
    v = m12 + c
    c = v / 65536
    m12 = v - c * 65536
    v = m13 + c
    c = v / 65536
    m13 = v - c * 65536
    v = m14 + c
    c = v / 65536
    m14 = v - c * 65536
    v = m15 + c
    c = v / 65536
    m15 = v - c * 65536
    v = m16 + c
    c = v / 65536
    m16 = v - c * 65536
    v = m17 + c
    c = v / 65536
    m17 = v - c * 65536
    v = m18 + c
    c = v / 65536
    m18 = v - c * 65536
    v = m19 + c
    c = v / 65536
    m19 = v - c * 65536
    v = m20 + c
    c = v / 65536
    m20 = v - c * 65536
    v = m21 + c
    c = v / 65536
    m21 = v - c * 65536
    v = m22 + c
    c = v / 65536
    m22 = v - c * 65536
    v = m23 + c
    c = v / 65536
    m23 = v - c * 65536
    v = m24 + c
    c = v / 65536
    m24 = v - c * 65536
    v = m25 + c
    c = v / 65536
    m25 = v - c * 65536
    v = m26 + c
    c = v / 65536
    m26 = v - c * 65536
    v = m27 + c
    c = v / 65536
    m27 = v - c * 65536
    v = m28 + c
    c = v / 65536
    m28 = v - c * 65536
    v = m29 + c
    c = v / 65536
    m29 = v - c * 65536
    v = m30 + c
    c = v / 65536
    m30 = v - c * 65536
    var m31: int = c
    // descending Solinas fold: limbs 31..16 re-enter at k-16, k-10, k-4, k-2
    m15 = m15 + m31
    m21 = m21 - m31
    m27 = m27 - m31
    m29 = m29 + m31
    m14 = m14 + m30
    m20 = m20 - m30
    m26 = m26 - m30
    m28 = m28 + m30
    m13 = m13 + m29
    m19 = m19 - m29
    m25 = m25 - m29
    m27 = m27 + m29
    m12 = m12 + m28
    m18 = m18 - m28
    m24 = m24 - m28
    m26 = m26 + m28
    m11 = m11 + m27
    m17 = m17 - m27
    m23 = m23 - m27
    m25 = m25 + m27
    m10 = m10 + m26
    m16 = m16 - m26
    m22 = m22 - m26
    m24 = m24 + m26
    m9 = m9 + m25
    m15 = m15 - m25
    m21 = m21 - m25
    m23 = m23 + m25
    m8 = m8 + m24
    m14 = m14 - m24
    m20 = m20 - m24
    m22 = m22 + m24
    m7 = m7 + m23
    m13 = m13 - m23
    m19 = m19 - m23
    m21 = m21 + m23
    m6 = m6 + m22
    m12 = m12 - m22
    m18 = m18 - m22
    m20 = m20 + m22
    m5 = m5 + m21
    m11 = m11 - m21
    m17 = m17 - m21
    m19 = m19 + m21
    m4 = m4 + m20
    m10 = m10 - m20
    m16 = m16 - m20
    m18 = m18 + m20
    m3 = m3 + m19
    m9 = m9 - m19
    m15 = m15 - m19
    m17 = m17 + m19
    m2 = m2 + m18
    m8 = m8 - m18
    m14 = m14 - m18
    m16 = m16 + m18
    m1 = m1 + m17
    m7 = m7 - m17
    m13 = m13 - m17
    m15 = m15 + m17
    m0 = m0 + m16
    m6 = m6 - m16
    m12 = m12 - m16
    m14 = m14 + m16
    fe_carry(Fe {
        l0: m0,
        l1: m1,
        l2: m2,
        l3: m3,
        l4: m4,
        l5: m5,
        l6: m6,
        l7: m7,
        l8: m8,
        l9: m9,
        l10: m10,
        l11: m11,
        l12: m12,
        l13: m13,
        l14: m14,
        l15: m15,
    })
}

/// Field squaring — `fe_mul(f, f)` (a dedicated squaring saves ~45%
/// of the products and is a named follow-on, not a correctness matter —
/// the sc18 precedent). ct: as `fe_mul`.
fn fe_sq(f: Fe) -> Fe {
    fe_mul(f, f)
}

/// Canonical reduction to [0, p). A carried value is < 2^256; adding
/// 2^256 - p (= 2^224 - 2^192 - 2^96 + 1, the fold constants at
/// q = 1) carries out of bit 256 exactly when the value is >= p, so
/// that carry q selects one subtraction of p — applied as the same
/// fold of q with the final 2^256 carry dropped. All arithmetic, no
/// branch. Total. ct: fixed schedule, data-independent.
fn fe_freeze(fin: Fe) -> Fe {
    let h = fe_carry(fin)
    // probe: does value + (2^256 - p) carry out of bit 256?
    var g0: int = h.l0 + 1
    var g1: int = h.l1
    var g2: int = h.l2
    var g3: int = h.l3
    var g4: int = h.l4
    var g5: int = h.l5
    var g6: int = h.l6 - 1
    var g7: int = h.l7
    var g8: int = h.l8
    var g9: int = h.l9
    var g10: int = h.l10
    var g11: int = h.l11
    var g12: int = h.l12 - 1
    var g13: int = h.l13
    var g14: int = h.l14 + 1
    var g15: int = h.l15
    var c: int = 0
    var v: int = 0
    v = g0
    c = floordiv(v, 65536)
    g0 = v - c * 65536
    v = g1 + c
    c = floordiv(v, 65536)
    g1 = v - c * 65536
    v = g2 + c
    c = floordiv(v, 65536)
    g2 = v - c * 65536
    v = g3 + c
    c = floordiv(v, 65536)
    g3 = v - c * 65536
    v = g4 + c
    c = floordiv(v, 65536)
    g4 = v - c * 65536
    v = g5 + c
    c = floordiv(v, 65536)
    g5 = v - c * 65536
    v = g6 + c
    c = floordiv(v, 65536)
    g6 = v - c * 65536
    v = g7 + c
    c = floordiv(v, 65536)
    g7 = v - c * 65536
    v = g8 + c
    c = floordiv(v, 65536)
    g8 = v - c * 65536
    v = g9 + c
    c = floordiv(v, 65536)
    g9 = v - c * 65536
    v = g10 + c
    c = floordiv(v, 65536)
    g10 = v - c * 65536
    v = g11 + c
    c = floordiv(v, 65536)
    g11 = v - c * 65536
    v = g12 + c
    c = floordiv(v, 65536)
    g12 = v - c * 65536
    v = g13 + c
    c = floordiv(v, 65536)
    g13 = v - c * 65536
    v = g14 + c
    c = floordiv(v, 65536)
    g14 = v - c * 65536
    v = g15 + c
    c = floordiv(v, 65536)
    g15 = v - c * 65536
    let q = c
    // value - q·p == value + q·(2^256 - p) - q·2^256 (the carry is dropped)
    var r0: int = h.l0 + q
    var r1: int = h.l1
    var r2: int = h.l2
    var r3: int = h.l3
    var r4: int = h.l4
    var r5: int = h.l5
    var r6: int = h.l6 - q
    var r7: int = h.l7
    var r8: int = h.l8
    var r9: int = h.l9
    var r10: int = h.l10
    var r11: int = h.l11
    var r12: int = h.l12 - q
    var r13: int = h.l13
    var r14: int = h.l14 + q
    var r15: int = h.l15
    c = 0
    v = r0
    c = floordiv(v, 65536)
    r0 = v - c * 65536
    v = r1 + c
    c = floordiv(v, 65536)
    r1 = v - c * 65536
    v = r2 + c
    c = floordiv(v, 65536)
    r2 = v - c * 65536
    v = r3 + c
    c = floordiv(v, 65536)
    r3 = v - c * 65536
    v = r4 + c
    c = floordiv(v, 65536)
    r4 = v - c * 65536
    v = r5 + c
    c = floordiv(v, 65536)
    r5 = v - c * 65536
    v = r6 + c
    c = floordiv(v, 65536)
    r6 = v - c * 65536
    v = r7 + c
    c = floordiv(v, 65536)
    r7 = v - c * 65536
    v = r8 + c
    c = floordiv(v, 65536)
    r8 = v - c * 65536
    v = r9 + c
    c = floordiv(v, 65536)
    r9 = v - c * 65536
    v = r10 + c
    c = floordiv(v, 65536)
    r10 = v - c * 65536
    v = r11 + c
    c = floordiv(v, 65536)
    r11 = v - c * 65536
    v = r12 + c
    c = floordiv(v, 65536)
    r12 = v - c * 65536
    v = r13 + c
    c = floordiv(v, 65536)
    r13 = v - c * 65536
    v = r14 + c
    c = floordiv(v, 65536)
    r14 = v - c * 65536
    v = r15 + c
    c = floordiv(v, 65536)
    r15 = v - c * 65536
    Fe {
        l0: r0,
        l1: r1,
        l2: r2,
        l3: r3,
        l4: r4,
        l5: r5,
        l6: r6,
        l7: r7,
        l8: r8,
        l9: r9,
        l10: r10,
        l11: r11,
        l12: r12,
        l13: r13,
        l14: r14,
        l15: r15,
    }
}

/// True iff the value is zero mod p (freezes first, so a
/// non-canonical zero is recognized). ct: public data at every call
/// site in this module (verify-side and encoding work).
fn fe_iszero(f: Fe) -> bool {
    let c = fe_freeze(f)
    c.l0 == 0 &&
        c.l1 == 0 &&
        c.l2 == 0 &&
        c.l3 == 0 &&
        c.l4 == 0 &&
        c.l5 == 0 &&
        c.l6 == 0 &&
        c.l7 == 0 &&
        c.l8 == 0 &&
        c.l9 == 0 &&
        c.l10 == 0 &&
        c.l11 == 0 &&
        c.l12 == 0 &&
        c.l13 == 0 &&
        c.l14 == 0 &&
        c.l15 == 0
}

/// True iff two field elements are equal mod p. ct: public data at
/// every call site (point equality and validation are verify-side).
fn fe_eq(f: Fe, g: Fe) -> bool {
    fe_iszero(fe_sub(f, g))
}

/// Decode 32 BIG-endian bytes (the SEC1/FIPS byte order) to a field
/// element. The caller guarantees 32 byte-valued elements and a value
/// < p (`bytes_lt_p` is the ingestion check). Limb i is byte pair
/// (31-2i, 30-2i). ct: fixed offsets.
fn fe_frombytes_be(b: List[int]) -> Fe {
    let l0: int = b[31] + b[30] * 256
    let l1: int = b[29] + b[28] * 256
    let l2: int = b[27] + b[26] * 256
    let l3: int = b[25] + b[24] * 256
    let l4: int = b[23] + b[22] * 256
    let l5: int = b[21] + b[20] * 256
    let l6: int = b[19] + b[18] * 256
    let l7: int = b[17] + b[16] * 256
    let l8: int = b[15] + b[14] * 256
    let l9: int = b[13] + b[12] * 256
    let l10: int = b[11] + b[10] * 256
    let l11: int = b[9] + b[8] * 256
    let l12: int = b[7] + b[6] * 256
    let l13: int = b[5] + b[4] * 256
    let l14: int = b[3] + b[2] * 256
    let l15: int = b[1] + b[0] * 256
    Fe {
        l0: l0,
        l1: l1,
        l2: l2,
        l3: l3,
        l4: l4,
        l5: l5,
        l6: l6,
        l7: l7,
        l8: l8,
        l9: l9,
        l10: l10,
        l11: l11,
        l12: l12,
        l13: l13,
        l14: l14,
        l15: l15,
    }
}

/// Encode a field element as 32 BIG-endian bytes, canonical (< p).
/// ct: freezes (fixed), then fixed byte extraction.
fn fe_tobytes_be(fin: Fe) -> List[int] {
    let f = fe_freeze(fin)
    var out = List[int]()
    (mut out).push(f.l15 / 256)
    (mut out).push(f.l15 % 256)
    (mut out).push(f.l14 / 256)
    (mut out).push(f.l14 % 256)
    (mut out).push(f.l13 / 256)
    (mut out).push(f.l13 % 256)
    (mut out).push(f.l12 / 256)
    (mut out).push(f.l12 % 256)
    (mut out).push(f.l11 / 256)
    (mut out).push(f.l11 % 256)
    (mut out).push(f.l10 / 256)
    (mut out).push(f.l10 % 256)
    (mut out).push(f.l9 / 256)
    (mut out).push(f.l9 % 256)
    (mut out).push(f.l8 / 256)
    (mut out).push(f.l8 % 256)
    (mut out).push(f.l7 / 256)
    (mut out).push(f.l7 % 256)
    (mut out).push(f.l6 / 256)
    (mut out).push(f.l6 % 256)
    (mut out).push(f.l5 / 256)
    (mut out).push(f.l5 % 256)
    (mut out).push(f.l4 / 256)
    (mut out).push(f.l4 % 256)
    (mut out).push(f.l3 / 256)
    (mut out).push(f.l3 % 256)
    (mut out).push(f.l2 / 256)
    (mut out).push(f.l2 % 256)
    (mut out).push(f.l1 / 256)
    (mut out).push(f.l1 % 256)
    (mut out).push(f.l0 / 256)
    (mut out).push(f.l0 % 256)
    out
}

