// ---------------------------------------------------------------------
// SHA-256 (FIPS 180-4 §5.3.3, §6.2)
// ---------------------------------------------------------------------

/// An in-progress SHA-256 computation. The fields are the interim
/// backing (F-0035's byte currency, and 32-bit words in `wrapping[u64]`
/// halves per the header) — never part of the API. A caller can forge
/// one; a forged state produces a wrong digest, never a trap, because
/// every field value is arithmetically valid.
pub struct Sha256 {
    h0: wrapping[u64],
    h1: wrapping[u64],
    h2: wrapping[u64],
    h3: wrapping[u64],
    h4: wrapping[u64],
    h5: wrapping[u64],
    h6: wrapping[u64],
    h7: wrapping[u64],
    buf: List[byte],
    total: int,
    k: List[int],
}

/// A fresh SHA-256 state — FIPS 180-4 §5.3.3's initial hash value ("the
/// first thirty-two bits of the fractional parts of the square roots of
/// the first eight prime numbers"). Total: no rows, no traps.
/// ct: no secret is present yet; construction is input-independent.
///
/// ```wolf-doc-example
/// var st = sha2.new256()
/// sha2.update256(mut st, "abc".bytes())
/// sha2.to_hex(sha2.final256(take st)) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
/// ```
pub fn new256() -> Sha256 {
    let a0: wrapping[u64] = 0x6a09e667
    let a1: wrapping[u64] = 0xbb67ae85
    let a2: wrapping[u64] = 0x3c6ef372
    let a3: wrapping[u64] = 0xa54ff53a
    let a4: wrapping[u64] = 0x510e527f
    let a5: wrapping[u64] = 0x9b05688c
    let a6: wrapping[u64] = 0x1f83d9ab
    let a7: wrapping[u64] = 0x5be0cd19
    Sha256 {
        h0: a0,
        h1: a1,
        h2: a2,
        h3: a3,
        h4: a4,
        h5: a5,
        h6: a6,
        h7: a7,
        buf: List[byte](),
        total: 0,
        k: k256(),
    }
}

/// One 512-bit block — FIPS 180-4 §6.2.2: the message schedule (step 1),
/// the eight working variables (step 2), sixty-four rounds (step 3) and
/// the intermediate hash value (step 4). Addition is modulo 2^32 (the
/// masked `wrapping[u64]` discipline). Requires `st.buf.len == 64`.
fn compress256(mut st: Sha256) {
    var w = List[int]()
    var t: int = 0
    while t < 16 {
        let off = t * 4
        let wt = word32_be(
            st.buf[off] as int,
            st.buf[off + 1] as int,
            st.buf[off + 2] as int,
            st.buf[off + 3] as int,
        )
        (mut w).push(wt as int)
        t = t + 1
    }
    while t < 64 {
        let wt = ssig1_256(w[t - 2] as wrapping[u64]) +
            w[t - 7] as wrapping[u64] +
            ssig0_256(w[t - 15] as wrapping[u64]) +
            w[t - 16] as wrapping[u64] &
            mask32()
        (mut w).push(wt as int)
        t = t + 1
    }
    var a = st.h0
    var b = st.h1
    var c = st.h2
    var d = st.h3
    var e = st.h4
    var f = st.h5
    var g = st.h6
    var h = st.h7
    t = 0
    while t < 64 {
        let t1 = h + bsig1_256(e) + ch(e, f, g) + st.k[t] as wrapping[u64] + w[t] as wrapping[u64] &
            mask32()
        let t2 = bsig0_256(a) + maj(a, b, c) & mask32()
        h = g
        g = f
        f = e
        e = d + t1 & mask32()
        d = c
        c = b
        b = a
        a = t1 + t2 & mask32()
        t = t + 1
    }
    st.h0 = st.h0 + a & mask32()
    st.h1 = st.h1 + b & mask32()
    st.h2 = st.h2 + c & mask32()
    st.h3 = st.h3 + d & mask32()
    st.h4 = st.h4 + e & mask32()
    st.h5 = st.h5 + f & mask32()
    st.h6 = st.h6 + g & mask32()
    st.h7 = st.h7 + h & mask32()
    st.buf = List[byte]()
}

/// Absorbs `data` into the running SHA-256 computation. Bytes are
/// buffered until a 512-bit block is full, then compressed; calling
/// `update256` in any chunking produces the digest one call would (held
/// by `tests/x/crypto/sha2/incremental_chunking.lu`). **Total** — the
/// 0..255 element contract is the TYPE's since sc35, so the ingestion
/// guard that used to trap here is gone.
/// ct: branches and indexes on byte COUNTS only, never on byte values,
/// with no exception left to record.
pub fn update256(mut st: Sha256, data: List[byte]) {
    for byte_v in data {
        (mut st.buf).push(byte_v)
        st.total = st.total + 1
        if st.buf.len == 64 {
            compress256(mut st)
        }
    }
}

/// Pads (FIPS 180-4 §5.1.1: one `0x80` byte, zeros to 56 mod 64, the
/// message length in BITS as a big-endian 64-bit word) and returns the
/// 32 digest bytes, big-endian per word (§6.2.2 step 4, §3.1). Consumes
/// the state — a finished computation cannot be updated again, and the
/// mode system is what enforces it (`take`, the builders' `finish`
/// precedent). Total for every state `new256`/`update256` can produce.
/// ct: padding branches on the buffered LENGTH (public); the length
/// word is public by definition.
///
/// ```wolf-doc-example
/// var st = sha2.new256()
/// sha2.update256(mut st, List[byte]())
/// sha2.to_hex(sha2.final256(take st)) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
/// ```
pub fn final256(take st: Sha256) -> List[byte] {
    var s = st
    let bits = s.total as wrapping[u64] << 3
    (mut s.buf).push(0x80 as byte)
    if s.buf.len > 56 {
        while s.buf.len < 64 {
            (mut s.buf).push(0 as byte)
        }
        compress256(mut s)
    }
    while s.buf.len < 56 {
        (mut s.buf).push(0 as byte)
    }
    push_word64_be(mut s.buf, bits)
    compress256(mut s)
    var out = List[byte]()
    push_word32_be(mut out, s.h0)
    push_word32_be(mut out, s.h1)
    push_word32_be(mut out, s.h2)
    push_word32_be(mut out, s.h3)
    push_word32_be(mut out, s.h4)
    push_word32_be(mut out, s.h5)
    push_word32_be(mut out, s.h6)
    push_word32_be(mut out, s.h7)
    out
}

/// The SHA-256 digest of `msg`, one shot: `new256` + `update256` +
/// `final256`. 32 bytes out. **Total** (sc35: `List[byte]` cannot carry
/// an element outside 0..255, so there is nothing left to trap on).
/// ct: as the incremental trio — public-count branching only.
///
/// ```wolf-doc-example
/// sha2.to_hex(sha2.sum256("abc".bytes())) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
/// sha2.sum256("abc".bytes()).len == 32
/// ```
pub fn sum256(msg: List[byte]) -> List[byte] {
    var st = new256()
    update256(mut st, msg)
    final256(take st)
}

// ---------------------------------------------------------------------
// SHA-512 (FIPS 180-4 §5.3.5, §6.4)
// ---------------------------------------------------------------------

/// An in-progress SHA-512 computation. Same field posture as `Sha256`;
/// the schedule constants ride as high/low halves (`khi`/`klo`) per the
/// module header's storage rule.
pub struct Sha512 {
    h0: wrapping[u64],
    h1: wrapping[u64],
    h2: wrapping[u64],
    h3: wrapping[u64],
    h4: wrapping[u64],
    h5: wrapping[u64],
    h6: wrapping[u64],
    h7: wrapping[u64],
    buf: List[byte],
    total: int,
    khi: List[int],
    klo: List[int],
}

/// A fresh SHA-512 state — FIPS 180-4 §5.3.5's initial hash value ("the
/// first sixty-four bits of the fractional parts of the square roots of
/// the first eight prime numbers"). Total: no rows, no traps.
/// ct: no secret is present yet; construction is input-independent.
///
/// ```wolf-doc-example
/// var st = sha2.new512()
/// sha2.update512(mut st, "abc".bytes())
/// sha2.final512(take st).len == 64
/// ```
pub fn new512() -> Sha512 {
    var khi = List[int]()
    var klo = List[int]()
    k512(mut khi, mut klo)
    let a0: wrapping[u64] = 0x6a09e667f3bcc908
    let a1: wrapping[u64] = 0xbb67ae8584caa73b
    let a2: wrapping[u64] = 0x3c6ef372fe94f82b
    let a3: wrapping[u64] = 0xa54ff53a5f1d36f1
    let a4: wrapping[u64] = 0x510e527fade682d1
    let a5: wrapping[u64] = 0x9b05688c2b3e6c1f
    let a6: wrapping[u64] = 0x1f83d9abfb41bd6b
    let a7: wrapping[u64] = 0x5be0cd19137e2179
    Sha512 {
        h0: a0,
        h1: a1,
        h2: a2,
        h3: a3,
        h4: a4,
        h5: a5,
        h6: a6,
        h7: a7,
        buf: List[byte](),
        total: 0,
        khi: khi,
        klo: klo,
    }
}

/// One 1024-bit block — FIPS 180-4 §6.4.2: the same four steps as
/// §6.2.2 over 64-bit words, eighty rounds, addition modulo 2^64
/// (`wrapping[u64]`'s native width — no masks). Requires
/// `st.buf.len == 128`.
fn compress512(mut st: Sha512) {
    var whi = List[int]()
    var wlo = List[int]()
    var t: int = 0
    while t < 16 {
        let off = t * 8
        let wt = st.buf[off] as int as wrapping[u64] << 56 |
            st.buf[off + 1] as int as wrapping[u64] << 48 |
            st.buf[off + 2] as int as wrapping[u64] << 40 |
            st.buf[off + 3] as int as wrapping[u64] << 32 |
            st.buf[off + 4] as int as wrapping[u64] << 24 |
            st.buf[off + 5] as int as wrapping[u64] << 16 |
            st.buf[off + 6] as int as wrapping[u64] << 8 |
            st.buf[off + 7] as int as wrapping[u64]
        push_word_halves(mut whi, mut wlo, wt)
        t = t + 1
    }
    while t < 80 {
        let wm2 = whi[t - 2] as wrapping[u64] << 32 | wlo[t - 2] as wrapping[u64]
        let wm7 = whi[t - 7] as wrapping[u64] << 32 | wlo[t - 7] as wrapping[u64]
        let wm15 = whi[t - 15] as wrapping[u64] << 32 | wlo[t - 15] as wrapping[u64]
        let wm16 = whi[t - 16] as wrapping[u64] << 32 | wlo[t - 16] as wrapping[u64]
        let wt = ssig1_512(wm2) + wm7 + ssig0_512(wm15) + wm16
        push_word_halves(mut whi, mut wlo, wt)
        t = t + 1
    }
    var a = st.h0
    var b = st.h1
    var c = st.h2
    var d = st.h3
    var e = st.h4
    var f = st.h5
    var g = st.h6
    var h = st.h7
    t = 0
    while t < 80 {
        let kt = st.khi[t] as wrapping[u64] << 32 | st.klo[t] as wrapping[u64]
        let wt = whi[t] as wrapping[u64] << 32 | wlo[t] as wrapping[u64]
        let t1 = h + bsig1_512(e) + ch(e, f, g) + kt + wt
        let t2 = bsig0_512(a) + maj(a, b, c)
        h = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
        t = t + 1
    }
    st.h0 = st.h0 + a
    st.h1 = st.h1 + b
    st.h2 = st.h2 + c
    st.h3 = st.h3 + d
    st.h4 = st.h4 + e
    st.h5 = st.h5 + f
    st.h6 = st.h6 + g
    st.h7 = st.h7 + h
    st.buf = List[byte]()
}

/// Absorbs `data` into the running SHA-512 computation; 1024-bit
/// blocks. Any chunking produces one digest. **Total** (sc35).
/// ct: as `update256` — public-count branching only, with no exception
/// left to record.
pub fn update512(mut st: Sha512, data: List[byte]) {
    for byte_v in data {
        (mut st.buf).push(byte_v)
        st.total = st.total + 1
        if st.buf.len == 128 {
            compress512(mut st)
        }
    }
}

/// Pads (FIPS 180-4 §5.1.2: one `0x80`, zeros to 112 mod 128, the bit
/// length as a big-endian 128-bit word — the high word is the byte
/// count's top three bits, exact for every representable length) and
/// returns the 64 digest bytes. Consumes the state (`take`). Total.
/// ct: padding branches on the buffered LENGTH (public).
///
/// ```wolf-doc-example
/// var st = sha2.new512()
/// sha2.update512(mut st, List[byte]())
/// sha2.to_hex(sha2.final512(take st)) == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"
/// ```
pub fn final512(take st: Sha512) -> List[byte] {
    var s = st
    let total_w = s.total as wrapping[u64]
    let bits_hi = total_w >> 61
    let bits_lo = total_w << 3
    (mut s.buf).push(0x80 as byte)
    if s.buf.len > 112 {
        while s.buf.len < 128 {
            (mut s.buf).push(0 as byte)
        }
        compress512(mut s)
    }
    while s.buf.len < 112 {
        (mut s.buf).push(0 as byte)
    }
    push_word64_be(mut s.buf, bits_hi)
    push_word64_be(mut s.buf, bits_lo)
    compress512(mut s)
    var out = List[byte]()
    push_word64_be(mut out, s.h0)
    push_word64_be(mut out, s.h1)
    push_word64_be(mut out, s.h2)
    push_word64_be(mut out, s.h3)
    push_word64_be(mut out, s.h4)
    push_word64_be(mut out, s.h5)
    push_word64_be(mut out, s.h6)
    push_word64_be(mut out, s.h7)
    out
}

/// The SHA-512 digest of `msg`, one shot. 64 bytes out. **Total** (sc35).
/// ct: as the incremental trio.
///
/// ```wolf-doc-example
/// sha2.to_hex(sha2.sum512("abc".bytes())) == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
/// ```
pub fn sum512(msg: List[byte]) -> List[byte] {
    var st = new512()
    update512(mut st, msg)
    final512(take st)
}

// ---------------------------------------------------------------------
// SHA-384 (FIPS 180-4 §5.3.4, §6.5): the SHA-512 computation under its
// own initial hash value, truncated to the left-most 384 bits (§7).
// ---------------------------------------------------------------------

/// An in-progress SHA-384 computation: a `Sha512` core under §5.3.4's
/// initial value. Its own type so that a 384 stream cannot be finished
/// as a 512 one (or the reverse) — the digests would silently differ in
/// more than length. `update384` passes `mut st.st` straight through:
/// the F-0092 refusal that made sc16 copy the core out and back (a
/// `mut` field path off a `mut` parameter refused natively) closed at
/// the sc18 pin (s111 / wolf-lang#133, the shape re-probed on all
/// three lanes at 21b129e), and the copy dance retired with it.
pub struct Sha384 {
    st: Sha512,
}

/// A fresh SHA-384 state — FIPS 180-4 §5.3.4's initial hash value ("the
/// square roots of the ninth through sixteenth prime numbers"). Total.
/// ct: no secret is present yet; construction is input-independent.
///
/// ```wolf-doc-example
/// var st = sha2.new384()
/// sha2.update384(mut st, "abc".bytes())
/// sha2.final384(take st).len == 48
/// ```
pub fn new384() -> Sha384 {
    var core = new512()
    let a0: wrapping[u64] = 0xcbbb9d5dc1059ed8
    let a1: wrapping[u64] = 0x629a292a367cd507
    let a2: wrapping[u64] = 0x9159015a3070dd17
    let a3: wrapping[u64] = 0x152fecd8f70e5939
    let a4: wrapping[u64] = 0x67332667ffc00b31
    let a5: wrapping[u64] = 0x8eb44a8768581511
    let a6: wrapping[u64] = 0xdb0c2e0d64f98fa7
    let a7: wrapping[u64] = 0x47b5481dbefa4fa4
    core.h0 = a0
    core.h1 = a1
    core.h2 = a2
    core.h3 = a3
    core.h4 = a4
    core.h5 = a5
    core.h6 = a6
    core.h7 = a7
    Sha384 { st: core }
}

/// Absorbs `data` into the running SHA-384 computation. **Total** (sc35).
/// ct: as `update512`.
pub fn update384(mut st: Sha384, data: List[byte]) {
    update512(mut st.st, data)
}

/// Pads exactly as SHA-512 and returns the LEFT-MOST 48 digest bytes
/// (FIPS 180-4 §6.5 step 3 / §7 truncation). Consumes the state. Total.
/// ct: as `final512`.
pub fn final384(take st: Sha384) -> List[byte] {
    var core = st.st
    let full = final512(take core)
    full[0..48]
}

/// The SHA-384 digest of `msg`, one shot. 48 bytes out. **Total** (sc35).
/// ct: as the incremental trio.
///
/// ```wolf-doc-example
/// sha2.to_hex(sha2.sum384("abc".bytes())) == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"
/// ```
pub fn sum384(msg: List[byte]) -> List[byte] {
    var st = new384()
    update384(mut st, msg)
    final384(take st)
}

// ---------------------------------------------------------------------
// HMAC (FIPS 198-1 / RFC 2104): H((K0 XOR opad) || H((K0 XOR ipad) || m))
// ---------------------------------------------------------------------

/// K0 per FIPS 198-1 §4 table, steps 1-3: a key longer than the block
/// is hashed first; every key is then zero-padded to the block length.
/// The XOR-with-pad walk is shared by the three HMAC entry points; the
/// digest choice rides in as the already-reduced key.
/// ct: pads and XORs every key byte unconditionally — the only
/// key-dependent quantity in the control flow is the key's LENGTH
/// (public per RFC 2104); no branch reads a key byte's value. Since
/// sc35 there is no ingestion-guard exception to apply where the key is
/// hashed either.
fn xor_pad(key0: List[byte], block: int, pad: int) -> List[byte] {
    var out = List[byte]()
    for kb in key0 {
        out = push_xored(take out, kb as int, pad)
    }
    var i = out.len
    while i < block {
        (mut out).push(pad as byte)
        i = i + 1
    }
    out
}

/// One byte XOR in the `wrapping[u64]` domain (bitwise `^` on plain
/// `int` costs the checked lane, F-0026; on wrapping it is the module's
/// ambient dialect). Returns the list to keep the caller's loop a
/// single expression.
fn push_xored(take out: List[byte], b: int, pad: int) -> List[byte] {
    var xs = out
    let x = (b as wrapping[u64] ^ pad as wrapping[u64]) & 0xff
    (mut xs).push(x as int as byte)
    xs
}

/// HMAC-SHA-256 (FIPS 198-1; RFC 2104). Any key length; keys longer
/// than the 64-byte block are reduced by one SHA-256 first (FIPS 198-1
/// §4 step 2). 32 bytes out. **Total** (sc35: a non-byte element is a
/// type error now, not a trap).
/// ct: see `xor_pad` — key-length-dependent control flow only; no
/// branch or index reads a key byte, and since sc35 the module has no
/// recorded exception at all.
///
/// ```wolf-doc-example
/// sha2.to_hex(sha2.hmac256("key".bytes(), "The quick brown fox jumps over the lazy dog".bytes())) == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8"
/// ```
pub fn hmac256(key: List[byte], msg: List[byte]) -> List[byte] {
    var key0 = key
    if key0.len > 64 {
        key0 = sum256(key0)
    }
    let ipad = xor_pad(key0, 64, 0x36)
    let opad = xor_pad(key0, 64, 0x5c)
    var inner = new256()
    update256(mut inner, ipad)
    update256(mut inner, msg)
    let inner_digest = final256(take inner)
    var outer = new256()
    update256(mut outer, opad)
    update256(mut outer, inner_digest)
    final256(take outer)
}

/// HMAC-SHA-384 (FIPS 198-1; RFC 2104). The block is SHA-384's 128
/// bytes. 48 bytes out. **Total** (sc35).
/// ct: as `hmac256`.
pub fn hmac384(key: List[byte], msg: List[byte]) -> List[byte] {
    var key0 = key
    if key0.len > 128 {
        key0 = sum384(key0)
    }
    let ipad = xor_pad(key0, 128, 0x36)
    let opad = xor_pad(key0, 128, 0x5c)
    var inner = new384()
    update384(mut inner, ipad)
    update384(mut inner, msg)
    let inner_digest = final384(take inner)
    var outer = new384()
    update384(mut outer, opad)
    update384(mut outer, inner_digest)
    final384(take outer)
}

/// HMAC-SHA-512 (FIPS 198-1; RFC 2104). The block is SHA-512's 128
/// bytes. 64 bytes out. **Total** (sc35).
/// ct: as `hmac256`.
pub fn hmac512(key: List[byte], msg: List[byte]) -> List[byte] {
    var key0 = key
    if key0.len > 128 {
        key0 = sum512(key0)
    }
    let ipad = xor_pad(key0, 128, 0x36)
    let opad = xor_pad(key0, 128, 0x5c)
    var inner = new512()
    update512(mut inner, ipad)
    update512(mut inner, msg)
    let inner_digest = final512(take inner)
    var outer = new512()
    update512(mut outer, opad)
    update512(mut outer, inner_digest)
    final512(take outer)
}

// ---------------------------------------------------------------------
// HKDF (RFC 5869): Extract(salt, IKM) = HMAC(salt, IKM);
// Expand(PRK, info, L) = T(1) || T(2) || ... clipped to L, where
// T(i) = HMAC(PRK, T(i-1) || info || byte(i)).
// ---------------------------------------------------------------------

/// HKDF-Extract over HMAC-SHA-256 (RFC 5869 §2.2). An absent salt is
/// spelled as the empty list — the RFC's "if not provided, ... a string
/// of HashLen zeros" is HMAC's own zero-padding of an empty key, so the
/// spellings agree by construction. 32-byte PRK out.
/// ct: HMAC's obligations, unchanged.
///
/// ```wolf-doc-example
/// sha2.hkdf256_extract(List[byte](), "secret".bytes()).len == 32
/// ```
pub fn hkdf256_extract(salt: List[byte], ikm: List[byte]) -> List[byte] {
    hmac256(salt, ikm)
}

/// HKDF-Expand over HMAC-SHA-256 (RFC 5869 §2.3). Traps `assert` when
/// `n` is negative or exceeds 255 * 32 (the RFC's hard cap: the counter
/// is one byte) — the length is the caller's parameter, not data (§2's
/// trap rule). `n == 0` is the empty output. `prk` must be at least one
/// block's worth of entropy per the RFC; this module does not police
/// entropy, only lengths.
/// ct: the T(i) chain's shape depends on `n` and `info.len` (public);
/// no branch reads a byte of `prk` or the running T.
///
/// ```wolf-doc-example
/// let prk = sha2.hkdf256_extract("salt".bytes(), "ikm".bytes())
/// sha2.hkdf256_expand(prk, "info".bytes(), 42).len == 42
/// sha2.hkdf256_expand(prk, "info".bytes(), 0).len == 0
/// ```
pub fn hkdf256_expand(prk: List[byte], info: List[byte], n: int) -> List[byte] {
    if n < 0 {
        assert(false, "sha2: hkdf length is negative")
    }
    if n > 255 * 32 {
        assert(false, "sha2: hkdf length exceeds 255 * hash length")
    }
    var okm = List[byte]()
    var t = List[byte]()
    var i: int = 1
    while okm.len < n {
        var block = new256()
        update256(mut block, xor_pad(prk, 64, 0x36))
        update256(mut block, t)
        update256(mut block, info)
        block = counter_absorb256(take block, i)
        t = finish_hmac256(prk, take block)
        for b in t {
            if okm.len < n {
                (mut okm).push(b)
            }
        }
        i = i + 1
    }
    okm
}

/// The one counter byte T(i) ends with (RFC 5869 §2.3). Split out so
/// the expand loop reads as the RFC's equation.
fn counter_absorb256(take block: Sha256, i: int) -> Sha256 {
    var st = block
    var one = List[byte]()
    (mut one).push((i % 256) as byte)
    update256(mut st, one)
    st
}

/// The outer half of the T(i) HMAC: finish the inner hash, then run the
/// opad pass. `hmac256` cannot be reused directly because the inner
/// hash absorbs three pieces incrementally.
fn finish_hmac256(prk: List[byte], take inner: Sha256) -> List[byte] {
    let inner_digest = final256(take inner)
    var outer = new256()
    update256(mut outer, xor_pad(prk, 64, 0x5c))
    update256(mut outer, inner_digest)
    final256(take outer)
}

/// HKDF over HMAC-SHA-256, extract-then-expand in one call (RFC 5869
/// §2). Traps as `hkdf256_expand` on an out-of-range `n`.
/// ct: the composition of the two halves' obligations.
///
/// ```wolf-doc-example
/// sha2.hkdf256("salt".bytes(), "ikm".bytes(), "info".bytes(), 16).len == 16
/// ```
pub fn hkdf256(salt: List[byte], ikm: List[byte], info: List[byte], n: int) -> List[byte] {
    let prk = hkdf256_extract(salt, ikm)
    hkdf256_expand(prk, info, n)
}

/// HKDF-Extract over HMAC-SHA-384 (RFC 5869 §2.2). 48-byte PRK out.
/// ct: HMAC's obligations, unchanged.
pub fn hkdf384_extract(salt: List[byte], ikm: List[byte]) -> List[byte] {
    hmac384(salt, ikm)
}

/// HKDF-Expand over HMAC-SHA-384 (RFC 5869 §2.3); the cap is 255 * 48.
/// Traps and totality as `hkdf256_expand`.
/// ct: as `hkdf256_expand`.
pub fn hkdf384_expand(prk: List[byte], info: List[byte], n: int) -> List[byte] {
    if n < 0 {
        assert(false, "sha2: hkdf length is negative")
    }
    if n > 255 * 48 {
        assert(false, "sha2: hkdf length exceeds 255 * hash length")
    }
    var okm = List[byte]()
    var t = List[byte]()
    var i: int = 1
    while okm.len < n {
        var chunk = List[byte]()
        for b in t {
            (mut chunk).push(b)
        }
        for b in info {
            (mut chunk).push(b)
        }
        (mut chunk).push((i % 256) as byte)
        t = hmac384(prk, chunk)
        for b in t {
            if okm.len < n {
                (mut okm).push(b)
            }
        }
        i = i + 1
    }
    okm
}

/// HKDF over HMAC-SHA-384, extract-then-expand in one call.
/// ct: the composition of the two halves' obligations.
pub fn hkdf384(salt: List[byte], ikm: List[byte], info: List[byte], n: int) -> List[byte] {
    let prk = hkdf384_extract(salt, ikm)
    hkdf384_expand(prk, info, n)
}

/// HKDF-Extract over HMAC-SHA-512 (RFC 5869 §2.2). 64-byte PRK out.
/// ct: HMAC's obligations, unchanged.
pub fn hkdf512_extract(salt: List[byte], ikm: List[byte]) -> List[byte] {
    hmac512(salt, ikm)
}

/// HKDF-Expand over HMAC-SHA-512 (RFC 5869 §2.3); the cap is 255 * 64.
/// Traps and totality as `hkdf256_expand`.
/// ct: as `hkdf256_expand`.
pub fn hkdf512_expand(prk: List[byte], info: List[byte], n: int) -> List[byte] {
    if n < 0 {
        assert(false, "sha2: hkdf length is negative")
    }
    if n > 255 * 64 {
        assert(false, "sha2: hkdf length exceeds 255 * hash length")
    }
    var okm = List[byte]()
    var t = List[byte]()
    var i: int = 1
    while okm.len < n {
        var chunk = List[byte]()
        for b in t {
            (mut chunk).push(b)
        }
        for b in info {
            (mut chunk).push(b)
        }
        (mut chunk).push((i % 256) as byte)
        t = hmac512(prk, chunk)
        for b in t {
            if okm.len < n {
                (mut okm).push(b)
            }
        }
        i = i + 1
    }
    okm
}

/// HKDF over HMAC-SHA-512, extract-then-expand in one call.
/// ct: the composition of the two halves' obligations.
pub fn hkdf512(salt: List[byte], ikm: List[byte], info: List[byte], n: int) -> List[byte] {
    let prk = hkdf512_extract(salt, ikm)
    hkdf512_expand(prk, info, n)
}

// ---------------------------------------------------------------------
// Rendering
// ---------------------------------------------------------------------

/// `b` as lowercase hexadecimal, two digits per byte — this module's
/// own rendering so its tests and examples import exactly one module
/// (the `std.bytes.from_str` precedent); `std.hex.encode` is the facade
/// spelling. **Total** — the slice's own `assert` on a non-byte element
/// is unreachable since sc35, and was already unreachable in practice
/// because no digest this module returns could contain one.
/// ct: NOT constant-time — the alphabet slice is indexed by each byte's
/// VALUE, a secret-dependent memory index. Render public values with
/// it; a constant-time encoder is c28-tier work.
///
/// ```wolf-doc-example
/// sha2.to_hex(sha2.sum256("abc".bytes()))[0..8] == "ba7816bf"
/// sha2.to_hex(List[byte]()) == ""
/// ```
pub fn to_hex(b: List[byte]) -> str {
    let alphabet = "0123456789abcdef"
    var out = ""
    for raw in b {
        let v = raw as int
        let hi = v / 16
        let lo = v % 16
        let hd = alphabet[hi..hi + 1]
        let ld = alphabet[lo..lo + 1]
        out = "{out}{hd}{ld}"
    }
    out
}
