// ---------------------------------------------------------------------
// FIPS 180-4 §4.2.3 — the eighty K{512} constants: "the first sixty-four
// bits of the fractional parts of the cube roots of the first eighty
// prime numbers", transcribed left to right from the document's table.
// Each literal is verbatim; `push_word_halves` owns the storage split.
// ---------------------------------------------------------------------

fn k512(mut hi: List[int], mut lo: List[int]) {
