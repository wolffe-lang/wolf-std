//! member: true
//! Scalar display columns from pinned Unicode data and measured exceptions.
//! Stability tier: core. No locale, terminal probing or emoji shaping.

use std.unicode.tables

/// The additive display-column width of `c`: 0, 1 or 2, using Unicode
/// 15.1.0 plus the documented C-library compatibility exceptions.
/// Raises `none` for nonprinting scalars: Cc except NUL, Zl/Zp separators,
/// unassigned code points and noncharacters. NUL is zero, private-use characters are one,
/// and ambiguous East Asian width is always narrow. No traps.
/// This is not a font measurement; an emoji-shaping terminal may differ.
///
/// ```wolf-doc-example
/// unicode.display_width('A')? == 1
/// unicode.display_width('中')? == 2
/// unicode.display_width('\u{301}')? == 0
/// unicode.display_width('🇺')? == 1
/// unicode.display_width('\0')? == 0
/// (unicode.display_width('\t') else 99) == 99
/// ```
pub fn display_width(c: char) -> int ! {none} {
    let width = tables.column_class(c)
    if width < 0 { return none }
    width
}
