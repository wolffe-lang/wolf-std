//! member: true
//!
//! std.cmp — comparison and ordering: the `Ordering` enum, the `Eq` and
//! `Ord` protocols, and the min/max/clamp family. Stability tier: core.
//!
//! Decided here and recorded (sc01): f64 ordering. Its `Ord` is
//! `total_cmp` (IEEE totalOrder), so sorting floats is legal and NaN
//! has one home (above `+inf`). See `total_cmp` for the two documented
//! approximations at the current pins.
//!
//! **`f64` HAS AN `Eq` NOW, AND sc44 REVERSED sc01 TO GIVE IT ONE.**
//! This header said for forty-three sprints that `f64` has no `Eq`
//! because "IEEE partial comparison stays on the builtin operators".
//! `[type.trait.op]` (s155, wolf-lang#5) is what retires that sentence:
//! since the operator bridge landed, `==` on a type parameter IS
//! `Eq.eq`, so "stays on the builtin operator" and "goes through `Eq`"
//! stopped being two different places. Withholding the impl would not
//! have kept a partial order out of a total protocol; it would only
//! have made `f64` the one primitive whose `==` does not work under a
//! bound, while `<` under the same bound did. The impl's body is
//! `self == other` — the clause's rule that a primitive impl IS the
//! builtin operation — and the law caveat is stated on the impl
//! itself: reflexivity fails at NaN, which is exactly what the builtin
//! does and is why `Ord for f64` is `total_cmp` and not this.
//!
//! INTERIM SPELLINGS (each filed, flipped on the pin bump that fixes it):
//! - The absence-spelling interim is RETIRED (F-0003, dead at the sc05
//!   pins, renamed tree-wide at sc06): a lowercase bare tag resolves in
//!   every implementation. Until sc12 this line still described the
//!   interim, in a half-renamed sentence that said the source said the
//!   opposite of what it says.
//! - `Ord` requires `Eq` by doctrine, and the requirement is still
//!   DOCUMENTARY, but for a smaller reason than it was. s155 gave the
//!   grammar a `trait_item` with an `=` form (the alias bound,
//!   `[type.trait.op.alias]`) and no supertrait clause, so composition
//!   this edition is an alias listing both and not `trait Ord: Eq`.
//!   F-0004's operator half is RULED — `==`, `!=` and the relationals
//!   dispatch through `Eq`/`Ord` by name on a type parameter or a user
//!   type, which is what `std.ops` is written against — and its
//!   supertrait half is what remains open.
//! - **F-0006 IS RETIRED AND `impl Ord for str` SHIPS.** The finding
//!   said "wolfc rejects `<` on `str` (E0409) and one rejected body
//!   poisons every test that imports this module". Re-measured at the
//!   sc44 pins on all three lanes: `cmp.Ord.cmp("a", "b").is_lt()` is
//!   `true` on the checked tier, the body passes the static ladder on
//!   every lane, and nothing is poisoned. The impl is written here in
//!   the same shape as `Ord for int` — two relational tests and a
//!   fallthrough — and the order it reports is the language's
//!   byte-lexicographic one (`[mem.str.order]`), which `std.sort`'s
//!   `sort_strs` already documents is not alphabetical in any human
//!   language (F-0019 owns collation).

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

impl Ordering {
    /// The opposite verdict: `Less` <-> `Greater`; `Equal` is its own
    /// reverse. Total: no error row, no traps.
    ///
    /// Example (prose until enum methods execute at the pins, F-0002):
    /// `total_cmp(1.0, 2.0).reverse()` is `Greater`.
    pub fn reverse(self) -> Ordering {
        match self {
            Less => Ordering.Greater,
            Equal => Ordering.Equal,
            Greater => Ordering.Less,
        }
    }

    /// Lexicographic composition: keep `self` unless it is `Equal`, in
    /// which case defer to `other`. Chains multi-key comparisons:
    /// `by_name.then(by_id)`. Total: no error row, no traps.
    pub fn then(self, other: Ordering) -> Ordering {
        match self {
            Less => Ordering.Less,
            Equal => other,
            Greater => Ordering.Greater,
        }
    }

    /// True exactly for `Less`. Total: no error row, no traps.
    pub fn is_lt(self) -> bool {
        match self {
            Less => true,
            Equal => false,
            Greater => false,
        }
    }

    /// True for `Less` or `Equal`. Total: no error row, no traps.
    pub fn is_le(self) -> bool {
        match self {
            Less => true,
            Equal => true,
            Greater => false,
        }
    }

    /// True exactly for `Equal`. Total: no error row, no traps.
    pub fn is_eq(self) -> bool {
        match self {
            Less => false,
            Equal => true,
            Greater => false,
        }
    }

    /// True for anything but `Equal`. Total: no error row, no traps.
    pub fn is_ne(self) -> bool {
        match self {
            Less => true,
            Equal => false,
            Greater => true,
        }
    }

    /// True for `Greater` or `Equal`. Total: no error row, no traps.
    pub fn is_ge(self) -> bool {
        match self {
            Less => false,
            Equal => true,
            Greater => true,
        }
    }

    /// True exactly for `Greater`. Total: no error row, no traps.
    pub fn is_gt(self) -> bool {
        match self {
            Less => false,
            Equal => false,
            Greater => true,
        }
    }
}

/// Equivalence. Law: `eq` is reflexive, symmetric, transitive; `Ord`
/// implementors agree with it (`cmp(a, b).is_eq() == Eq.eq(a, b)`).
pub trait Eq {
    fn eq(self, other: Self) -> bool
}

/// Total order. Law: trichotomy (exactly one of Less/Equal/Greater),
/// antisymmetry, transitivity. Requires `Eq` by doctrine (see the
/// module header for why the requirement is documentary today).
pub trait Ord {
    fn cmp(self, other: Self) -> Ordering
}

impl Eq for int {
    fn eq(self, other: Self) -> bool {
        self == other
    }
}

impl Ord for int {
    fn cmp(self, other: Self) -> Ordering {
        if self < other { return Ordering.Less }
        if other < self { return Ordering.Greater }
        Ordering.Equal
    }
}

impl Eq for bool {
    fn eq(self, other: Self) -> bool {
        self == other
    }
}

impl Ord for bool {
    fn cmp(self, other: Self) -> Ordering {
        // false < true, the conventional bool order.
        match (self, other) {
            (false, true) => Ordering.Less,
            (true, false) => Ordering.Greater,
            _ => Ordering.Equal,
        }
    }
}

impl Eq for str {
    fn eq(self, other: Self) -> bool {
        self == other
    }
}

impl Eq for Ordering {
    fn eq(self, other: Self) -> bool {
        match (self, other) {
            (Less, Less) => true,
            (Equal, Equal) => true,
            (Greater, Greater) => true,
            _ => false,
        }
    }
}

impl Ord for Ordering {
    fn cmp(self, other: Self) -> Ordering {
        // Less < Equal < Greater.
        match (self, other) {
            (Less, Less) => Ordering.Equal,
            (Less, _) => Ordering.Less,
            (Equal, Less) => Ordering.Greater,
            (Equal, Equal) => Ordering.Equal,
            (Equal, Greater) => Ordering.Less,
            (Greater, Greater) => Ordering.Equal,
            (Greater, _) => Ordering.Greater,
        }
    }
}

impl Eq for char {
    fn eq(self, other: Self) -> bool {
        self == other
    }
}

/// Scalar order (D58): `char` is a Unicode scalar value and this is the
/// order of its code points, which is also the order the language's `<`
/// reports. Same shape as `Ord for int` for the same reason — two
/// relational tests and a fallthrough.
impl Ord for char {
    fn cmp(self, other: Self) -> Ordering {
        if self < other { return Ordering.Less }
        if other < self { return Ordering.Greater }
        Ordering.Equal
    }
}

/// Byte-lexicographic order (`[mem.str.order]`): unsigned byte compare,
/// shorter first on a shared prefix, so every multi-byte code point
/// sorts above every ASCII one. That is NOT alphabetical order in any
/// human language and this module does not pretend it is — collation is
/// a table question (F-0019) and belongs where the tables land.
/// `std.sort.sort_strs` sorts by the same relation and says the same
/// thing; the two agree because both are the language's `<`.
impl Ord for str {
    fn cmp(self, other: Self) -> Ordering {
        if self < other { return Ordering.Less }
        if other < self { return Ordering.Greater }
        Ordering.Equal
    }
}

/// IEEE equality, and the law caveat is the point of the doc comment
/// rather than a footnote to it. `Eq`'s law says `eq` is reflexive;
/// `eq(nan, nan)` is `false`, so at NaN it is not. That is exactly what
/// the builtin `==` does, and `[type.trait.op]` rules that a primitive
/// impl IS the builtin operation — an impl that repaired the law would
/// be a different operation wearing `==`'s name, and the one place a
/// total answer is owed is `Ord`, which is `total_cmp` and gives NaN a
/// home. A caller that needs reflexivity over floats compares through
/// `Ord.cmp(a, b).is_eq()`, which is total by construction.
///
/// The whole caveat in four lines, and a FENCE at last: sc44 wrote this
/// example in prose because trait dispatch through an IMPORTED module's
/// trait was `unsupported` under lupin 0.1.33 (wolf-interp#96), and
/// is46 closed it — so §4's doc-truth rule is satisfiable here for the
/// first time. `tests/cmp/primitive_impls_tier.lu` is the running
/// witness beside it.
///
/// ```wolf-doc-example
/// let a: f64 = 1.5
/// let b: f64 = 2.5
/// cmp.Eq.eq(a, a) == true
/// cmp.Eq.eq(a, b) == false
/// let nan: f64 = 0.0 / 0.0
/// cmp.Eq.eq(nan, nan) == false
/// cmp.Ord.cmp(nan, nan).is_eq() == true
/// ```
impl Eq for f64 {
    fn eq(self, other: Self) -> bool {
        self == other
    }
}

impl Ord for f64 {
    /// `Ord` for f64 IS `total_cmp` — the decision this module
    /// records. See `total_cmp` for the order and its documented
    /// approximations.
    fn cmp(self, other: Self) -> Ordering {
        total_cmp(self, other)
    }
}

/// Least of `a` and `b` under `Ord`; returns `a` on a tie (the stable
/// choice). Total: no error row, no traps.
pub fn min[T: Ord](a: T, b: T) -> T {
    match Ord.cmp(b, a) {
        Less => b,
        Equal => a,
        Greater => a,
    }
}

/// Greatest of `a` and `b` under `Ord`; returns `a` on a tie (the
/// stable choice). Total: no error row, no traps.
pub fn max[T: Ord](a: T, b: T) -> T {
    match Ord.cmp(b, a) {
        Less => a,
        Equal => a,
        Greater => b,
    }
}

/// `v` limited to `[lo, hi]`: `lo` when `v < lo`, `hi` when `v > hi`,
/// else `v`. Traps `assert` when `lo > hi` — a contract violation the
/// callee cannot repair (`[conf.trap.map]`: user assertions).
pub fn clamp[T: Ord](v: T, lo: T, hi: T) -> T {
    match Ord.cmp(lo, hi) {
        Greater => assert(false),
        Less => {},
        Equal => {},
    }
    match Ord.cmp(v, lo) {
        Less => return lo,
        Equal => {},
        Greater => {},
    }
    match Ord.cmp(v, hi) {
        Greater => hi,
        Less => v,
        Equal => v,
    }
}

// BLOCKED at the sc01 pins — `min_of[T: Ord](xs: List[T]) -> T ! {none}`
// and `max_of[T: Ord](xs: List[T]) -> T ! {none}` (least/greatest element,
// `none` on empty). Every spelling of a generic `List[T]` traversal that
// reads two overlapping places (`xs.len` then `xs[i]`, or a carried
// `best`) is rejected by wolfc's mem tier: reads of generic-typed places
// are treated as moves, so the second read is E1001 (the fix-it suggests
// a `copy` operator that is not in the pinned grammar). lupin cannot run
// them either (`Ord.cmp` dispatch). Filed with the List/mode divergence
// (F-0005); the bodies land verbatim from the sc01 workbench when the
// mem tier learns copyable reads.

/// IEEE totalOrder over floats, monomorphic: -inf < negative reals <
/// -0.0 < +0.0 < positive reals < +inf < NaN. Total: no error row, no
/// traps (f64 division by zero is IEEE, not a trap — X3 governs
/// integers).
///
/// Two documented approximations at the current pins (no f64 bit
/// intrinsics exist to do better): NaN is one value — the sign and
/// payload of a NaN are not observed, so every NaN sorts above `+inf`
/// and all NaNs compare `Equal`; totalOrder's -NaN-below--inf home is
/// not represented.
///
/// **Prose as of sc44, and the fence it replaces is a regression
/// witness, not a tidy-up.** These four lines were a `wolf-doc-example`
/// from sc01 to sc43 and ran on every lane. At v0.2.11 they are
/// `fail(E0301)` on both compiler rungs: `==` between two `Ordering`s
/// dispatches through a trait named `Eq` BY BARE NAME
/// ([type.trait.op]), an importer of this module has only `cmp.Eq`, and
/// wolf has no item imports — so the diagnostic's own fix-it cannot be
/// followed and the `impl Eq for Ordering` it asks for is already here.
/// wolf-lang#336; the fence comes back verbatim when it closes, and
/// `tests/cmp/total_cmp_relational.lu` holds the same four relations as
/// a ledgered row meanwhile.
///
/// Each line is `true`: `total_cmp(1.0, 2.0)` agrees with
/// `total_cmp(-1.0e9, 3.5)` (both `Less`), `total_cmp(2.0, 1.0)` with
/// `total_cmp(0.0 / 0.0, 1.0)` (both `Greater` — NaN above every real),
/// `total_cmp(4.5, 4.5)` with `total_cmp(0.0 / 0.0, 0.0 / 0.0)` (both
/// `Equal` — all NaNs are one value here), and `total_cmp(-0.0, 0.0)`
/// with `total_cmp(1.0, 2.0)` (both `Less` — the sign of zero is
/// observed).
pub fn total_cmp(a: f64, b: f64) -> Ordering {
    // `!(x == x)`, not the textbook `x != x`: the native backend lowers
    // `!=` on `f64` to an ORDERED comparison, so `nan != nan` is false
    // there and true in the interpreter (F-0027 / wolf-lang#22). The
    // spelling below agrees on every lane and reverts when that closes.
    let a_nan = !(a == a)
    let b_nan = !(b == b)
    if a_nan && b_nan { return Ordering.Equal }
    if a_nan { return Ordering.Greater }
    if b_nan { return Ordering.Less }
    if a < b { return Ordering.Less }
    if b < a { return Ordering.Greater }
    // a == b numerically; IEEE == conflates -0.0 and +0.0, totalOrder
    // does not. The sign of zero is observable through division.
    if a == 0.0 {
        let a_neg = 1.0 / a < 0.0
        let b_neg = 1.0 / b < 0.0
        if a_neg && !b_neg { return Ordering.Less }
        if b_neg && !a_neg { return Ordering.Greater }
    }
    Ordering.Equal
}
