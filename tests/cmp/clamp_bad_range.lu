//! check: run(exit=trap(assert))
//! phase: run
//! conforms: std.cmp, conf.trap.map
//!
//! `clamp`'s one trap: `lo > hi` is a caller contract violation and
//! traps `assert`. Neither lane executes trait dispatch at the sc01
//! pins (F-0002), so today both refuse honestly before the trap — the
//! ledger records that, and this file starts trapping on the pin bump
//! that lands dispatch. Typed bindings dodge the i32-literal paper cut
//! (F-0004).

use std.cmp

fn main() -> !int {
    let v: int = 3
    let lo: int = 9
    let hi: int = 1
    let c = cmp.clamp(v, lo, hi)
    c
}
