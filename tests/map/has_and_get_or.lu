//! check: run(exit=0)
//! phase: run
//! conforms: std.map
//!
//! `has` and `get_or`, the two eager conveniences over `get`. Same
//! blocker, same honest rows as `get_hit_miss` (F-0002/F-0004).
//!
//! Population goes through the LANGUAGE's `m[k] = v`, not `map.set`, for
//! one recorded reason (F-0013): under lupin a `mut`-mode call followed
//! by a read-mode call whose body allocates (`keys`, `values`, `pairs`)
//! is reported `ub(mem.ub)` — "foreign write … while tag is PROTECTED" —
//! which is a false positive in the interpreter's provenance model, not a
//! property of this code. `set` has its own test where the shape is safe.

use std.map

fn main() -> !int {
    var m = Map[str, int]()
    m["a"] = 1
    if map.has(m, "a") {} else { return 1 }
    if map.has(m, "z") { return 2 }
    if map.get_or(m, "a", 0) == 1 {} else { return 3 }
    if map.get_or(m, "z", 42) == 42 {} else { return 4 }
    0
}
