//! check: run(exit=0)
//! phase: run
//! conforms: std.map, type.map.key, mem.map.absent
//!
//! Old trait-walk and index-read get agree for char keys, including
//! empty/nonempty misses, replacement, removal and reinsertion.

use std.cmp
use std.map

fn old_get[K: cmp.Eq, V](m: Map[K, V], k: K) -> V ! {none} {
    for pair in m.pairs() {
        if cmp.Eq.eq(pair.0, k) {
            return pair.1
        }
    }
    none
}

fn agrees[K: cmp.Eq](m: Map[K, int], k: K, expected: int) -> bool {
    let before = old_get(m, k) else -999
    let after = map.get(m, k) else -999
    before == expected && after == expected
}

fn char_keys() -> bool {
    var m = Map[char, int]()
    if !agrees(m, 'a', -999) { return false }
    m['a'] = 0
    m['é'] = -1
    m['𐐀'] = 17
    if !agrees(m, 'a', 0) { return false }
    if !agrees(m, 'é', -1) { return false }
    if !agrees(m, '𐐀', 17) { return false }
    if !agrees(m, 'z', -999) { return false }
    m['a'] = 23
    if !agrees(m, 'a', 23) { return false }
    let removed = (mut m).remove('é') else -999
    if removed != -1 { return false }
    if !agrees(m, 'é', -999) { return false }
    m['é'] = 0
    agrees(m, 'é', 0)
}

fn main() -> !int {
    if !char_keys() { print("FAIL get-char"); return 1 }
    0
}
