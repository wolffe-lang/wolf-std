//! check: run(exit=0, stdout="10000")
//! phase: run
//! conforms: std.map, type.map, mem.map.absent
//!
//! wolf-std#109: 10,000 string-key inserts followed by 10,000 get calls.
//! The checked machine must finish, not decline at its evaluation budget.
//! The native ratio against the same workload's index read is also gated
//! by docs/sc78-witness/gate.py, with compilation excluded from timing.

use std.map

fn main() -> !int {
    var m = Map[str, int]()
    var i = 0
    while i < 10000 {
        map.set(mut m, "0#key{i}", i)
        i = i + 1
    }
    var hits = 0
    i = 0
    while i < 10000 {
        let v = map.get(m, "0#key{i}") else -1
        if v >= 0 { hits = hits + 1 }
        i = i + 1
    }
    print("{hits}")
    0
}
