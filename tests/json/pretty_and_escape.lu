//! check: run(exit=0)
//! phase: run
//! conforms: std.json
//!
//! `stringify_pretty`'s layout (one entry per line, `indent` spaces per
//! level, empty containers on one line) and `escape`'s rules — including
//! the shape that REFUSED until sc14 (a non-ASCII code point followed by a
//! character needing an escape), which is the case this file exists to
//! keep honest now that the function is total.

use std.json

fn main() -> !int {
    // Scalars are the compact form; there is nothing to lay out.
    if (json.stringify_pretty(json.from_int(1), 2) else "?") == "1" {} else { return 1 }
    if (json.stringify_pretty(json.null(), 4) else "?") == "null" {} else { return 2 }
    // Empty containers stay on one line, which is what every diff wants.
    var empty = List[json.Value]()
    if (json.stringify_pretty(json.from_list(empty), 2) else "?") == "[]" {} else { return 3 }
    var no_keys = Map[str, json.Value]()
    if (json.stringify_pretty(json.from_map(no_keys), 2) else "?") == "{{}}" {} else { return 4 }
    // One entry per line, indented by level.
    var xs = List[json.Value]()
    (mut xs).push(json.from_int(1))
    (mut xs).push(json.from_int(2))
    if (json.stringify_pretty(json.from_list(xs), 2) else "?") == "[\n  1,\n  2\n]" {} else {
        return 5
    }
    // Nesting compounds the indent.
    var outer = List[json.Value]()
    (mut outer).push(json.from_list(xs))
    if (json.stringify_pretty(json.from_list(outer), 2) else "?") == "[\n  [\n    1,\n    2\n  ]\n]" {} else {
        return 6
    }
    // An indent of zero is newlines without indentation.
    if (json.stringify_pretty(json.from_list(xs), 0) else "?") == "[\n1,\n2\n]" {} else { return 7 }
    // Objects put a space after the colon in the pretty form.
    var m = Map[str, json.Value]()
    m["a"] = json.from_int(1)
    if (json.stringify_pretty(json.from_map(m), 2) else "?") == "{{\n  \"a\": 1\n}}" {} else {
        return 8
    }
    // escape: nothing to do, and the fast path returns the string itself.
    if json.escape("wolf") == "wolf" {} else { return 9 }
    if json.escape("") == "" {} else { return 10 }
    // Non-ASCII passes through verbatim: RFC 8259 permits raw UTF-8.
    if json.escape("café 🐺") == "café 🐺" {} else { return 11 }
    // The two backslash forms and the named control escapes.
    if json.escape("a\"b") == "a\\\"b" {} else { return 12 }
    if json.escape("a\\b") == "a\\\\b" {} else { return 13 }
    if json.escape("a\nb") == "a\\nb" {} else { return 14 }
    if json.escape("a\tb") == "a\\tb" {} else { return 15 }
    if json.escape("a\rb") == "a\\rb" {} else { return 16 }
    if json.escape("a\x08b") == "a\\bb" {} else { return 17 }
    if json.escape("a\x0cb") == "a\\fb" {} else { return 18 }
    // Every other control character takes the \u00XX form.
    if json.escape("\x00") == "\\u0000" {} else { return 19 }
    if json.escape("\x01") == "\\u0001" {} else { return 20 }
    if json.escape("\x1f") == "\\u001f" {} else { return 21 }
    // DEL is not a JSON escape and passes through.
    if json.escape("\x7f") == "\x7f" {} else { return 22 }
    // THE SHAPE THAT USED TO REFUSE (sc05..sc13): a non-ASCII code point
    // followed by a character needing an escape. The byte walk steps over
    // it without measuring it, because no byte of a multi-byte code point
    // is one of the four ASCII characters JSON escapes.
    if json.escape("café \"x\"") == "café \\\"x\\\"" {} else { return 23 }
    if json.escape("\"x\" café") == "\\\"x\\\" café" {} else { return 24 }
    // Both directions past a 4-byte code point, and an escape on each side.
    if json.escape("\n🐺\n") == "\\n🐺\\n" {} else { return 25 }
    // The run between two escapes is a slice at offsets `escape` computed,
    // and it carries whatever was in it.
    if json.escape("a\tébc\td") == "a\\tébc\\td" {} else { return 26 }
    0
}
