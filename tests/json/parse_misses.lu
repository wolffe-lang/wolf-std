//! check: run(exit=1, stdout="two arms discriminate\nsyntax taken\nerror: overflow")
//! phase: run
//! conforms: std.json, err.row, err.else, err.propagate
//!
//! Every class of document `parse` refuses, and then the `syntax` tag
//! named by the toolchain.
//!
//! The strict-profile rejections are the point of the file: a parser is
//! judged by what it refuses, and every extension it might have guessed at
//! (a comment, a trailing comma, a bare key, `NaN`, a leading `+`) is here
//! as a miss rather than as a silence.
//!
//! The last two assertions are sc07's two-part row shape: an `else` proves
//! the miss path was taken and produced a value, and a final `?` lets the
//! tag ride out of `main`, where `error: syntax` and exit 1 are the
//! toolchain's own words rather than this repository's reading.
//!
//! All three tags live in ONE multi-arm handler over the module-crossing
//! row — the shape F-0079 forbade for two sprints. lupin 0.1.13's
//! arm-selection pass fixed it (wolf-interp#29; the split this file used
//! to explain retired with the sc13-file pin bump, measured: the probe
//! that answered its first arm for every tag under 0.1.12 discriminates
//! both arm orders under 0.1.13). The `deep` boundary (64 legal, 80 a
//! raise, never a stack trap — the whole security argument for the
//! limit) and `overflow`'s near-misses (big-for-int is a Num; underflow
//! is IEEE zero, not a miss) fold in from the two retired files. The
//! overflow ARM stays unasserted under F-0084 (wolf-interp#33); its tag
//! identity is held by the ride-out below instead.

use std.json

fn nested(levels: int) -> str {
    var text = ""
    var i: int = 0
    while i < levels {
        text = "[{text}]"
        i = i + 1
    }
    text
}

/// Which arm the module-crossing row lands. Value arms deliberately: a
/// `return` inside the handler returns from the HANDLER (it is a
/// closure), not from this fn — all three implementations agree, so the
/// value-arm spelling is the one this witness pins.
fn arm_of(text: str) -> int {
    let arm = json.parse(text) else |e| match e {
        syntax => json.from_str("1"),
        deep => json.from_str("2"),
        overflow => json.from_str("3"),
    }
    if json.type_name(arm) == "str" {
        if (json.as_str(arm) else "?") == "1" { return 1 }
        if (json.as_str(arm) else "?") == "2" { return 2 }
        if (json.as_str(arm) else "?") == "3" { return 3 }
    }
    0
}

fn refused(text: str) -> bool {
    let v = json.parse(text) else json.from_str("REFUSED")
    (json.as_str(v) else "?") == "REFUSED"
}

fn main() -> !int {
    // Nothing, and nothing but whitespace.
    if refused("") {} else { return 1 }
    if refused("   \n\t ") {} else { return 2 }
    // Trailing content after a complete value.
    if refused("1 2") {} else { return 3 }
    if refused("[1] x") {} else { return 4 }
    if refused("truex") {} else { return 5 }
    // Half a word.
    if refused("tru") {} else { return 6 }
    if refused("nul") {} else { return 7 }
    // Unterminated containers and strings.
    if refused("[1, 2") {} else { return 8 }
    if refused("{{\"a\": 1") {} else { return 9 }
    if refused("\"abc") {} else { return 10 }
    if refused("\"abc\\\"") {} else { return 11 }
    // The number grammar: no leading zero, no bare fraction, no bare
    // point, no leading plus, no empty exponent, no lone sign.
    if refused("01") {} else { return 12 }
    if refused("-01") {} else { return 13 }
    if refused(".5") {} else { return 14 }
    if refused("1.") {} else { return 15 }
    if refused("+1") {} else { return 16 }
    if refused("1e") {} else { return 17 }
    if refused("1e+") {} else { return 18 }
    if refused("-") {} else { return 19 }
    // The spellings JSON does not have.
    if refused("NaN") {} else { return 20 }
    if refused("Infinity") {} else { return 21 }
    if refused("0x10") {} else { return 22 }
    // The extensions this profile deliberately refuses.
    if refused("[1,]") {} else { return 23 }
    if refused("{{\"a\": 1,}}") {} else { return 24 }
    if refused("{{a: 1}}") {} else { return 25 }
    if refused("{{'a': 1}}") {} else { return 26 }
    if refused("[1] // trailing") {} else { return 27 }
    if refused("[1 2]") {} else { return 28 }
    if refused("{{\"a\" 1}}") {} else { return 29 }
    if refused("{{\"a\": }}") {} else { return 30 }
    // Escapes inside a string, and the one raw character a string may not
    // hold (RFC 8259 forbids an unescaped control character).
    if refused("\"a\\qb\"") {} else { return 31 }
    if refused("\"\\ud800\"") {} else { return 32 }
    if refused("\"\\u00g0\"") {} else { return 33 }
    if refused("\"a\nb\"") {} else { return 34 }

    // deep: the limit itself parses; one past it is a RAISE, never a
    // stack trap (from the retired parse_deep_row.lu).
    let ok = json.parse(nested(64)) else json.from_str("REFUSED")
    if json.type_name(ok) == "arr" {} else { return 41 }
    // overflow's near misses (from the retired parse_overflow_row.lu):
    // too big for `int` is a Num; underflow is IEEE zero.
    let big = json.parse("99999999999999999999") else json.null()
    if json.type_name(big) == "num" {} else { return 42 }
    let tiny = json.parse("1e-400") else json.from_str("REFUSED")
    if (json.as_float(tiny) else 1.0) == 0.0 {} else { return 43 }

    // The three tags, ONE handler, across the module boundary — each
    // input lands its own arm (F-0079's fix, witnessed where the bug
    // lived).
    if arm_of("[1,]") == 1 {} else { return 44 }
    if arm_of(nested(80)) == 2 {} else { return 45 }
    // The overflow ARM is deliberately unasserted at this pin: lupin
    // 0.1.13 selects a widened tag's arm by sub-row INDEX (F-0084,
    // wolf-interp#33 — `1e400` lands the `deep` arm here; wolfc's two
    // lanes select correctly). Ride-out identity below is intact on
    // every lane. Assert `arm_of("1e400") == 3` the day #33 closes.
    if arm_of("1e400") == 0 { return 46 } else {}
    print("two arms discriminate")

    // The miss path produces a value, and then the tag rides out of `main`
    // so the record names it.
    let handled = json.parse("[1,]") else |_| {
        print("syntax taken")
        json.null()
    }
    if json.is_null(handled) {} else { return 35 }

    let forced = json.parse("1e400")?
    if json.is_null(forced) {} else { return 36 }
    0
}
