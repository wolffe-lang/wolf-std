//! check: run(exit=1, stdout="overflow taken\nerror: overflow")
//! phase: run
//! conforms: std.json, err.row, err.else, err.propagate
//!
//! `parse`'s `overflow` tag: a well-formed number whose magnitude has no
//! `f64`.
//!
//! The tag is the one addition to the sc05 contract's row, and this file is
//! why it is worth having. `1e400` is a legal JSON number and a document
//! containing it is a legal document, so answering `syntax` would tell a
//! caller something false about its own data; answering infinity would
//! render back as `null` and lose it silently. The third answer is to say
//! which failure it was, which is §12's rule.
//!
//! The near misses matter as much as the hit: a number too big for `int` is
//! NOT overflow — it becomes a `Num` — and a magnitude too small for `f64`
//! is not overflow either, because underflow to zero is what IEEE says
//! happens and there is no data to lose beyond the rounding every `f64`
//! does.

use std.json

fn main() -> !int {
    // Too big for `int` is a `Num`, not a miss.
    let big = json.parse("99999999999999999999") else json.null()
    if json.type_name(big) == "num" {} else { return 2 }
    // Underflow is zero, not a miss.
    let tiny = json.parse("1e-400") else json.from_str("REFUSED")
    if json.type_name(tiny) == "num" {} else { return 3 }
    if (json.as_float(tiny) else 1.0) == 0.0 {} else { return 4 }
    // A magnitude with no `f64`, either sign.
    let handled = json.parse("-1e400") else |_| {
        print("overflow taken")
        json.null()
    }
    if json.is_null(handled) {} else { return 5 }

    let forced = json.parse("1e400")?
    if json.is_null(forced) {} else { return 6 }
    0
}
