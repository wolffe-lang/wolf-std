//! check: run(exit=0, stdout="3 7.5 abcd\n5 12 4 1 -5\n5.5 3 4.5 -2.5\n")
//! phase: run
//! conforms: type.trait.op, std.ops
//!
//! The operator bridge, executing: six generic functions whose only
//! arithmetic is an operator on a type parameter, instantiated at `int`,
//! `f64` and (for `Add`) `str`. Every one of them is a dispatch through
//! `std.ops` by NAME ([type.trait.op]) and every one of them answers
//! what the builtin operator answers, which is the clause's own claim
//! about primitives — `[T: Add]` at `int` IS the machine add.
//!
//! `total` is the book's chapter-5 shape and the reason the module
//! exists. It is written here with the bound spelled `ops.Add` rather
//! than through the alias ON PURPOSE, and at sc46 that stopped being a
//! workaround and became the CONTROL: `std.ops` ships `trait Num` now,
//! `tests/ops/num_alias_tier.lu` is the same shape through it, and the
//! only difference between the two files on the reference machine is
//! the alias — this one runs, that one is `E0501` at resolve
//! (wolf-interp#102). A witness that shows one machine refusing is
//! worth more beside the byte-identical program it accepts.
//!
//! `ops.Add.add(…)` is called once, and the reason it was added has
//! gone: at sc44 a qualified trait in a BOUND did not count as a use of
//! its import on lupin (`E0305`, wolf-interp#97) and the call was what
//! kept the import used. #97 closed in is46; the call stays because it
//! asserts the trait method directly, which is the other half of what
//! this file is for. The lupin column moved `unsupported` -> `run` at
//! the same release for the neighbouring reason, wolf-interp#96: an
//! imported module's trait items execute there now.
//!
//! Literals stay in typed bindings: a bare literal argument defaults to
//! `i32`, which does not meet an `impl … for int` (E0502) — the same
//! paper cut `tests/cmp/static_floor.lu` carries.

use std.ops

fn total[T: ops.Add](xs: List[T], zero: T) -> T {
    var acc = zero
    for x in xs {
        acc = acc + x
    }
    acc
}

fn diff[T: ops.Sub](a: T, b: T) -> T {
    a - b
}

fn prod[T: ops.Mul](a: T, b: T) -> T {
    a * b
}

fn quot[T: ops.Div](a: T, b: T) -> T {
    a / b
}

fn rest[T: ops.Rem](a: T, b: T) -> T {
    a % b
}

fn flip[T: ops.Neg](a: T) -> T {
    -a
}

fn main() -> !int {
    var ints = List[int]()
    (mut ints).push(1)
    (mut ints).push(2)
    var floats = List[f64]()
    (mut floats).push(2.5)
    (mut floats).push(5.0)
    var strs = List[str]()
    (mut strs).push("ab")
    (mut strs).push("cd")
    let two: int = 2
    let three: int = 3
    let four: int = 4
    let five: int = 5
    let seven: int = 7
    let nine: int = 9
    print("{total(ints, 0)} {total(floats, 0.0)} {total(strs, "")}")
    print("{diff(seven, two)} {prod(three, four)} {quot(nine, two)} {rest(nine, two)} {flip(five)}")
    print("{diff(7.5, 2.0)} {prod(1.5, 2.0)} {quot(9.0, 2.0)} {flip(2.5)}")
    if ops.Add.add(two, three) == five { 0 } else { 1 }
}
