//! check: run(exit=0)
//! phase: run
//! conforms: std.unicode
//!
//! `from_code` is the validating constructor — the one place a number
//! becomes a code point — and `utf8_len` is the encoded width. Every
//! boundary of the four UTF-8 length classes is checked, plus all three
//! ways to not be a scalar value: negative, above U+10FFFF, and inside the
//! surrogate range U+D800..U+DFFF that UTF-8 may never encode.
//!
//! The widths agree with what the language's own `str.len` reports for a
//! literal of that code point — the cross-check that keeps the table
//! honest: 2 bytes for é (U+00E9), 3 for U+1680, 4 for 🐺 (U+1F43A).

use std.unicode

fn main() -> !int {
    if (unicode.from_code(65) else 0 - 1) == 65 {} else { return 1 }
    if (unicode.from_code(0) else 0 - 1) == 0 {} else { return 2 }
    if (unicode.from_code(1114111) else 0 - 1) == 1114111 {} else { return 3 }
    if (unicode.from_code(1114112) else 0 - 1) == 0 - 1 {} else { return 4 }
    if (unicode.from_code(0 - 1) else 0 - 2) == 0 - 2 {} else { return 5 }
    if (unicode.from_code(55295) else 0 - 1) == 55295 {} else { return 6 }
    if (unicode.from_code(55296) else 0 - 1) == 0 - 1 {} else { return 7 }
    if (unicode.from_code(57343) else 0 - 1) == 0 - 1 {} else { return 8 }
    if (unicode.from_code(57344) else 0 - 1) == 57344 {} else { return 9 }
    // The four width classes, at both ends of each.
    if (unicode.utf8_len(0) else 0) == 1 {} else { return 10 }
    if (unicode.utf8_len(127) else 0) == 1 {} else { return 11 }
    if (unicode.utf8_len(128) else 0) == 2 {} else { return 12 }
    if (unicode.utf8_len(2047) else 0) == 2 {} else { return 13 }
    if (unicode.utf8_len(2048) else 0) == 3 {} else { return 14 }
    if (unicode.utf8_len(65535) else 0) == 3 {} else { return 15 }
    if (unicode.utf8_len(65536) else 0) == 4 {} else { return 16 }
    if (unicode.utf8_len(1114111) else 0) == 4 {} else { return 17 }
    // Non-scalars have no width.
    if (unicode.utf8_len(1114112) else 0) == 0 {} else { return 18 }
    if (unicode.utf8_len(55296) else 0) == 0 {} else { return 19 }
    // Cross-check against the language's byte length for the same code
    // points, written as literals.
    if (unicode.utf8_len(233) else 0) == "é".len {} else { return 20 }
    if (unicode.utf8_len(5760) else 0) == "\u{1680}".len {} else { return 21 }
    if (unicode.utf8_len(128058) else 0) == "🐺".len {} else { return 22 }
    if (unicode.utf8_len(65) else 0) == "A".len {} else { return 23 }
    0
}
