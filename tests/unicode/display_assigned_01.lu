use std.unicode

fn same(low: int, high: int, want: int) -> bool {
    var cp = low
    while cp <= high {
        let c = unicode.from_code(cp) else { return false }
        if (unicode.display_width(c) else (0 - 1)) != want { return false }
        cp += 1
    }
    true
}

