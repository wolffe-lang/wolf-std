//! check: run(exit=0)
//! phase: run
//! conforms: std.time, std.fs, os.fs, err.row, err.propagate
//! Five real TZif files, copied from macOS. Fixtures stage beside the entry.
//! v2 uses its 64-bit table before 1901 and its footer beyond 2038.
//! Expectations derived from the bytes (RFC 8536, no host date oracle):
//! New Yorks 64-bit block begins with transition -2717650800 to EST;
//! type 0 is LMT at -17762, so one second before it uses that offset.
//! Its footer EST5EDT,M3.2.0,M11.1.0 puts 2100-07-01 in EDT (-14400).
//! Lord Howes footer <+1030>-10:30<+11>-11,M10.1.0,M4.1.0 puts
//! 2100-01-01 between Octobers start and Aprils end (+39600).
//! UTC0 has no transitions; 2^31 seconds is 24855 days plus 11648
//! seconds after 1970-01-01, hence 2038-01-19 03:14:08.

use std.time

fn main() -> !int {
    let u = time.local_in(":fixtures/UTC", -1)?
    if u.year != 1969 ||
        u.month != 12 ||
        u.day != 31 ||
        u.second != 59 ||
        u.nanos != 0 ||
        u.offset_s != 0 ||
        u.is_dst ||
        u.abbrev != "UTC" {
        return 1
    }
    let n = time.local_in(":fixtures/America/New_York", 0)?
    if n.year != 1969 ||
        n.month != 12 ||
        n.day != 31 ||
        n.hour != 19 ||
        n.offset_s != -18000 ||
        n.abbrev != "EST" {
        return 2
    }
    let k = time.local_in(":fixtures/Asia/Kolkata", 0)?
    if k.hour != 5 || k.minute != 30 || k.offset_s != 19800 || k.abbrev != "IST" { return 3 }
    let b = time.local_in(":fixtures/Europe/London", 0)?
    if b.hour != 1 || b.offset_s != 3600 || b.abbrev != "BST" { return 4 }
    let h = time.local_in(":fixtures/Australia/Lord_Howe", 0)?
    if h.hour != 10 || h.offset_s != 36000 { return 5 }
    let old = time.local_in(":fixtures/America/New_York", -2717650801)?
    if old.offset_s != -17762 || old.abbrev != "LMT" || time.to_unix(old) != -2717650801 {
        return 6
    }
    let std = time.local_in(":fixtures/America/New_York", -2717650800)?
    if std.offset_s != -18000 || std.abbrev != "EST" { return 7 }
    let edge = time.local_in(":fixtures/UTC", 2147483648)?
    if time.format(edge, "%F %T")? != "2038-01-19 03:14:08" { return 8 }
    let future = time.local_in(":fixtures/America/New_York", 4118083200)?
    if future.offset_s != -14400 || !future.is_dst { return 9 }
    if time.offset_at(":fixtures/Australia/Lord_Howe", 4102444800)? != 39600 { return 10 }
    0
}
