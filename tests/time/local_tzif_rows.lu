//! check: run(exit=0)
//! phase: run
//! conforms: std.time, std.fs, os.fs, err.row, err.propagate
//! RFC 8536: corrupt a real 64-bit block without relying on host date.
//! Bad magic, index, designation, ordering, footer, leap input and flags
//! are zone rows. A v3 header with the same UTC0 footer is valid too.

use std.time

fn fixture_count(b: List[byte], at: int) -> int {
    var n = 0
    for k in 0..4 { n = n * 256 + b[at + k] as int }
    n
}

fn main() -> !int {
    for mutation in 0..10 {
        var b = fs_read_bytes("fixtures/America/New_York")?
        let at = 44 +
            fixture_count(b, 32) * 5 +
            fixture_count(b, 36) * 6 +
            fixture_count(b, 40) +
            fixture_count(b, 24) +
            fixture_count(b, 20)
        let n = fixture_count(b, at + 32)
        let idx = at + 44 + n * 8
        let types = idx + n
        if mutation == 0 { b[at + 1] = 0 as byte }
        if mutation == 1 { b[idx] = 255 as byte }
        if mutation == 2 { b[types + 5] = 255 as byte }
        if mutation == 3 { for k in 0..8 { b[at + 52 + k] = b[at + 44 + k] } }
        if mutation == 4 { b[b.len - 1] = 0 as byte }
        if mutation == 5 { b[at + 31] = 1 as byte }
        if mutation == 6 { b[types + 4] = 2 as byte }
        let flags = types + fixture_count(b, at + 36) * 6 + fixture_count(b, at + 40)
        let end = flags + fixture_count(b, at + 24) + fixture_count(b, at + 20)
        if mutation == 7 { b[flags + fixture_count(b, at + 24)] = 1 as byte }
        if mutation == 8 { b[end + 4] = 54 as byte }
        if mutation == 9 {
            b = b[0..end]
            for ch in "\nEST5EDT,M3.2.0/-1,M11.1.0\n".bytes() { (mut b).push(ch) }
        }
        fs_write_bytes("corrupt-zone.tmp", b)?
        let off = time.offset_at(":corrupt-zone.tmp", 0) else |e| match e {
            zone => 123456,
            io => 654321,
        }
        if off != 123456 { return 1 }
    }
    var v3 = fs_read_bytes("fixtures/UTC")?
    v3[4] = 51 as byte
    v3[58] = 51 as byte
    fs_write_bytes("v3-zone.tmp", v3)?
    if time.local_in(":v3-zone.tmp", 0)?.abbrev != "UTC" { return 2 }
    fs_remove("corrupt-zone.tmp")?
    fs_remove("v3-zone.tmp")?
    0
}
