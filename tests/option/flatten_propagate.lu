//! check: run(exit=0, stdout="deep 4, shallow -1")
//! phase: run
//! conforms: std.option, err.propagate
//!
//! The `flatten` idiom — nested absence collapses through `?` because
//! the callee's row is a subset of the caller's; there is no nested
//! `(T ! {None}) ! {None}` to flatten (rows are not first-class types,
//! F-0002 records both facts).

fn half(x: int) -> int ! {None} {
    if x % 2 == 0 { return x / 2 }
    return None
}

fn quarter(x: int) -> int ! {None} {
    let h = half(x)?
    let q = half(h)?
    q
}

fn main() -> !int {
    let deep = quarter(16) else 0 - 1
    let shallow = quarter(6) else 0 - 1
    print("deep {deep}, shallow {shallow}")
    if deep == 4 && shallow == 0 - 1 { 0 } else { 1 }
}
