//! check: run(exit=0, stdout="present 1 (5), absent 0")
//! phase: run
//! conforms: std.option, err.else
//!
//! `option.to_list` — absence as a container: one element on a hit, none
//! on a miss, so `for x in option.to_list(v)` is the loop that runs zero
//! times or once. The list is allocated in the ambient region; no region
//! annotation appears in the helper or here (D10).
//!
//! Both lengths are read BEFORE the loop: `for x in present` MOVES the
//! list under wolfc's mem tier, so a later `present.len` is E1001. The
//! fix-it names `for x in copy present`, and at these pins that operator
//! EXISTS and runs in both implementations (sc06's measurement — it was
//! "not in the pinned grammar" as recently as sc02); reading the length
//! first needs no new syntax, so that is what this file does.

use std.option

fn find_positive(x: int) -> int ! {none} {
    if x > 0 { return x }
    return none
}

fn main() -> !int {
    let present = option.to_list(find_positive(5))
    let absent = option.to_list(find_positive(0 - 2))
    let n_present = present.len
    let n_absent = absent.len
    var seen: int = 0
    for x in present {
        seen = x
    }
    print("present {n_present} ({seen}), absent {n_absent}")
    if n_present == 1 && seen == 5 && n_absent == 0 { 0 } else { 1 }
}
