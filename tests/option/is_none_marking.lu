//! check: run(exit=0, stdout="miss: true, hit: false")
//! phase: run
//! conforms: std.option, err.else
//!
//! `option.is_none` — `exists`'s complement, and the pair's agreement is
//! the property worth pinning: for one producer and one input, exactly
//! one of them is true.

use std.option

fn find_positive(x: int) -> int ! {none} {
    if x > 0 { return x }
    return none
}

fn main() -> !int {
    let miss = option.is_none(find_positive(0 - 4))
    let hit = option.is_none(find_positive(4))
    let agree = option.exists(find_positive(4)) && !hit
    print("miss: {miss}, hit: {hit}")
    if miss && !hit && agree { 0 } else { 1 }
}
