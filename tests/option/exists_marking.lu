//! check: run(exit=0, stdout="have 3: true, have -1: false")
//! phase: run
//! conforms: std.option, err.else
//!
//! `option.exists` — presence as a bool. The helper answers by marking
//! through `else |_|`, which consumes the value: a caller that wants the
//! value asks `or`/`expect` instead of asking this first.

use std.option

fn find_positive(x: int) -> int ! {none} {
    if x > 0 { return x }
    return none
}

fn main() -> !int {
    let a = option.exists(find_positive(3))
    let b = option.exists(find_positive(0 - 1))
    print("have 3: {a}, have -1: {b}")
    if a && !b { 0 } else { 1 }
}
