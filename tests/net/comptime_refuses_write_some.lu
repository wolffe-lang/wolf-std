//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.net, comptime.sandbox, comptime.sandbox.net, type.list.lit.value
//!
//! sc83: fail(E0701) is the normative check IF the send is reached.
//! Compiler posture: unsupported at resolve, by name: `List` construction
//! at comptime. A List cannot be constructed by this edition's scalar
//! evaluator, so a builtin taking one is unreachable there. This source
//! has NOT measured net_write_some's own comptime barrier.
//! See [type.list.lit.value] and wolf-lang#101; keep the named posture
//! until container construction is supported. Released lupin 0.1.62
//! independently refuses the unsupported `probe` comptime fn at run;
//! its send barrier has not been measured here either.

comptime fn probe() -> int ! {busy, closed, invalid, io} {
    net_write_some(-1, List[byte]())
}

fn main() -> !int {
    const N = probe() else -1
    print("{N}")
    0
}
