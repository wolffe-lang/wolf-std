//! check: run(exit=0, stdout="tcp_empty=true\ntcp_4096=true\ntcp_busy=true\ntcp_bytes=true\ntcp_closed=closed\nunix_empty=true\nunix_4096=true\nunix_busy=true\nunix_bytes=true\nunix_closed=closed\nforged=io\nlistener=io\nclosed_handle=io\nempty_closed_handle=io")
//! phase: run
//! conforms: std.net, std.net.unix, os.net.io, os.host.sigs, err.row
//!
//! sc83: one non-parking send on both stream families. Each sends a full
//! 4096-byte list whose received bytes are verified, then fills the
//! unread stream to busy and drains exactly the returned counts. The
//! armed deadline is irrelevant to write_some. lupin serves this row;
//! it calls no readiness-set builtin.
//! Windows runs TCP, then reports the Unix-family refusal on stderr.

use std.net
use std.net.unix

fn sent(mut s: net.Socket, b: List[byte]) -> int ! {closed, invalid, io} {
    net.write_some(mut s, b) else |e| match e {
        busy => -1,
        closed => { return closed },
        invalid => { return invalid },
        io => { return io },
    }
}

fn row(mut s: net.Socket, b: List[byte]) -> str {
    let n = net.write_some(mut s, b) else |e| {
        return match e {
            busy => "busy",
            closed => "closed",
            invalid => "invalid",
            io => "io",
        }
    }
    "{n}"
}

fn exercise(name: str, mut s: net.Socket, mut peer: net.Socket) -> () ! {busy, closed, invalid, io, timeout} {
    net.set_deadline(mut s, 1)?
    net.set_deadline(mut peer, 2000)?
    let empty = net.write_some(mut s, List[byte]())?
    print("{name}_empty={empty == 0}")
    var b = List[byte]()
    var i = 0
    while i < 4096 {
        (mut b).push((i % 256) as byte)
        i = i + 1
    }
    let first = sent(mut s, b)?
    print("{name}_4096={first > 0 && first <= 4096}")
    var bytes_ok = first > 0
    var first_read = 0
    while first_read < first {
        let chunk = net.read_bytes(mut peer, first - first_read)?
        for c in chunk {
            if c != (first_read % 256) as byte { bytes_ok = false }
            first_read = first_read + 1
        }
    }
    // Do not inspect megabytes byte by byte on the reference tree walker:
    // the full input buffer above holds byte fidelity; here hold counts
    // and non-parking busy. socket_queue holds the large ordered stream.
    var took = 0
    var blocked = false
    var calls = 0
    while !blocked && calls < 8192 {
        let n = sent(mut s, b)?
        if n == -1 { blocked = true } else { took = took + n }
        calls = calls + 1
    }
    print("{name}_busy={blocked && took > 0}")
    var read = 0
    while read < took {
        let chunk = net.read_bytes(mut peer, 4096)?
        read = read + chunk.len
    }
    print("{name}_bytes={bytes_ok && first_read == first && read == took}")
}

fn after_close(mut s: net.Socket) -> str {
    var answer = "not closed"
    var n = 0
    while n < 1000 {
        answer = row(mut s, [120 as byte])
        if answer == "closed" { return answer }
        time_sleep_ms(1)
        n = n + 1
    }
    answer
}

fn main() -> !int {
    var srv = net.listen(net.loopback(0))?
    var cli = net.connect(net.loopback(net.port(srv)?))?
    var peer = net.accept(mut srv)?
    exercise("tcp", mut cli, mut peer)?
    net.close(take peer)?
    let _closed_ready = net.wait([cli.fd], 2000)?
    let tcp_closed = after_close(mut cli)
    print("tcp_closed={tcp_closed}")
    let old = cli.fd
    net.close(take cli)?
    var forged = net.Socket { fd: 1000000 }
    var listener = net.Socket { fd: srv.fd }
    var stale = net.Socket { fd: old }
    let forged_row = row(mut forged, [120 as byte])
    let listener_row = row(mut listener, [120 as byte])
    let stale_row = row(mut stale, [120 as byte])
    let empty_stale = row(mut stale, List[byte]())
    net.close_listener(take srv)?
    var us = unix.listen("write-some.sock") else |e| {
        match e {
            unsupported => {
                eprint("SKIP net/write_some: Unix stream unsupported on this host")
                print("unix_empty=true")
                print("unix_4096=true")
                print("unix_busy=true")
                print("unix_bytes=true")
                print("unix_closed=closed")
                print("forged={forged_row}")
                print("listener={listener_row}")
                print("closed_handle={stale_row}")
                print("empty_closed_handle={empty_stale}")
                return 0
            },
            exists => { return exists },
            not_found => { return not_found },
            denied => { return denied },
            io => { return io },
        }
    }
    var uc = unix.connect("write-some.sock")?
    var up = net.accept(mut us)?
    exercise("unix", mut uc, mut up)?
    net.close(take up)?
    let unix_closed = after_close(mut uc)
    print("unix_closed={unix_closed}")
    net.close(take uc)?
    net.close_listener(take us)?
    print("forged={forged_row}")
    print("listener={listener_row}")
    print("closed_handle={stale_row}")
    print("empty_closed_handle={empty_stale}")
    0
}
