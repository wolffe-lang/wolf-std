//! check: run(exit=1, stdout="handled: -1\nerror: refused")
//! phase: run
//! conforms: std.net, err.row, err.propagate, err.else
//!
//! The `refused` litmus, in both directions a caller can take it: an `else`
//! handler that turns the miss into a value the program keeps running with,
//! and a `?` that propagates it out of `main`, where the process outcome
//! NAMES the tag on stdout and exits 1.
//!
//! Deterministic on any host without naming a port: bind port 0, ask the
//! host which port it gave us, then CLOSE the listener — nothing is
//! listening on that port now, and a loopback dial to it is refused
//! immediately (no routing, no firewall, no timeout involved). It is the
//! one way to name a dead port that is guaranteed dead and guaranteed
//! local.
//!
//! The handler DISCRIMINATES now: F-0052's checked-tier first-arm bug is
//! long closed (s70/s71, as std.io's header records), and this file's
//! wildcard outlived the reason for it until the dd6d13c re-read —
//! re-measured with the io arm FIRST, a refused dial still lands the
//! refused arm, so the arm below proves the tag's identity in-band and
//! the `?` ride-out proves it end-to-end, two witnesses where there was
//! one.

use std.net

fn main() -> !int {
    var srv = net.listen(net.loopback(0))?
    let p = net.port(srv)?
    net.close_listener(take srv)?
    let dead = net.loopback(p)
    let sock = net.connect(dead) else |e| match e {
        io => net.Socket { fd: 0 - 9 },
        timeout => net.Socket { fd: 0 - 8 },
        refused => net.Socket { fd: 0 - 1 },
    }
    print("handled: {sock.fd}")
    let strict = net.connect(dead)?
    print("unreachable: {strict.fd}")
    0
}
