//! check: run(exit=0, stdout="child_pid=true\nchild_ids=true\nchild_status=0\nafter_close_as_host=true")
//! phase: run
//! conforms: std.net, std.net.unix, std.process, os.proc.fork, os.proc.ids, err.row
//!
//! sc83: a separately forked client's credentials are read while it stays
//! connected, acknowledged over the same stream, then read after close.
//! No uid change is attempted. Native Linux/macOS serve this fork. The
//! checked machine reports its unsupported error row and a loud SKIP;
//! lupin refuses os_fork by name at run, Windows has no Unix stream.

use std.fs
use std.net
use std.net.unix
use std.process

fn skipped() {
    print("child_pid=true")
    print("child_ids=true")
    print("child_status=0")
    print("after_close_as_host=true")
}

fn main() -> !int {
    if os_name() == "windows" {
        eprint(
            "SKIP net/unix/peer_credentials_child: Unix streams and fork unsupported on this host",
        )
        skipped()
        return 0
    }
    let path = "credentials-child.sock"
    // A prior tier may refuse after bind. This staged path is ours alone;
    // retry only exists, without hiding any other bind failure.
    var srv = unix.listen(path) else |e| match e {
        exists => { fs.remove(path)?; unix.listen(path)? },
        unsupported => { return unsupported },
        not_found => { return not_found },
        denied => { return denied },
        io => { return io },
    }
    let f = process.fork() else |e| {
        match e {
            unsupported => {
                eprint("SKIP net/unix/peer_credentials_child: checked machine refuses os_fork")
                net.close_listener(take srv)?
                skipped()
                return 0
            },
            busy => { eprint("fork failed: busy"); return 1 },
            io => { eprint("fork failed: io"); return 1 },
        }
    }
    if process.is_child(f) {
        var cli = unix.connect(path) else |_| { process.exit(11); return 11 }
        net.set_deadline(mut cli, 5000) else |_| { process.exit(12); return 12 }
        net.write(mut cli, "x") else |_| { process.exit(13); return 13 }
        let ack = net.read(mut cli, 1) else "?"
        net.close(take cli) else {}
        process.exit(if ack == "y" then 0 else 14)
        return 0
    }
    var peer = net.accept(mut srv)?
    net.set_deadline(mut peer, 5000)?
    let _ready = net.read(mut peer, 1)?
    let c = unix.peer_credentials(peer)?
    print("child_pid={c.pid == f.pid && c.pid != os_pid()}")
    print("child_ids={c.uid == os_euid()? && c.gid == os_egid()?}")
    net.write(mut peer, "y")?
    var ch = process.Child { slot: f.child.slot }
    let status = process.wait_status(take ch)?
    print("child_status={status}")
    let after = unix.peer_credentials(peer)?
    let want = if os_name() == "macos" then -1 else f.pid
    print("after_close_as_host={after.pid == want && after.uid == c.uid && after.gid == c.gid}")
    net.close(take peer)?
    net.close_listener(take srv)?
    0
}
