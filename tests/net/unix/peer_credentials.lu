//! check: run(exit=0, stdout="accepted_pid=true\naccepted_ids=true\ndialed_pid=true\ndialed_ids=true\nclosed_peer_as_host=true\nclosed_peer_ids=true\ntcp=io\nlistener=io\nforged=io\nclosed_handle=io")
//! phase: run
//! conforms: std.net, std.net.unix, os.net.unix, os.proc.ids, os.uname, err.row
//!
//! sc83: Unix credentials are read while the peer stays connected. Linux
//! keeps the pid after close; macOS gives -1, with both effective ids kept.
//! No different-uid client is claimed. lupin refuses net_peer_cred by name
//! at run. The separate native-child row will hold a different peer pid.

use std.fs
use std.net
use std.net.unix

fn row(s: net.Socket) -> str {
    let _cred = unix.peer_credentials(s) else |e| {
        return match e {
            io => "io",
            unsupported => "unsupported",
        }
    }
    "ok"
}

fn main() -> !int {
    if os_name() == "windows" {
        eprint("SKIP net/unix/peer_credentials: Unix streams unsupported on this host")
        print("accepted_pid=true")
        print("accepted_ids=true")
        print("dialed_pid=true")
        print("dialed_ids=true")
        print("closed_peer_as_host=true")
        print("closed_peer_ids=true")
        print("tcp=io")
        print("listener=io")
        print("forged=io")
        print("closed_handle=io")
        return 0
    }
    let path = "credentials.sock"
    // All tiers share this owned directory. A reference refusal after bind
    // leaves its path behind; only that exists row needs the owner's cleanup.
    var srv = unix.listen(path) else |e| match e {
        exists => { fs.remove(path)?; unix.listen(path)? },
        unsupported => { return unsupported },
        not_found => { return not_found },
        denied => { return denied },
        io => { return io },
    }
    var cli = unix.connect(path)?
    var peer = net.accept(mut srv)?
    let accepted = unix.peer_credentials(peer)?
    let dialed = unix.peer_credentials(cli)?
    let pid = os_pid()
    let uid = os_euid()?
    let gid = os_egid()?
    print("accepted_pid={accepted.pid == pid}")
    print("accepted_ids={accepted.uid == uid && accepted.gid == gid}")
    print("dialed_pid={dialed.pid == pid}")
    print("dialed_ids={dialed.uid == uid && dialed.gid == gid}")
    net.close(take cli)?
    let gone = unix.peer_credentials(peer)?
    let want_pid = if os_name() == "macos" then -1 else pid
    print("closed_peer_as_host={gone.pid == want_pid}")
    print("closed_peer_ids={gone.uid == uid && gone.gid == gid}")
    var tcp_srv = net.listen(net.loopback(0))?
    var tcp = net.connect(net.loopback(net.port(tcp_srv)?))?
    var tcp_peer = net.accept(mut tcp_srv)?
    print("tcp={row(tcp)}")
    print("listener={row(net.Socket { fd: srv.fd })}")
    print("forged={row(net.Socket { fd: 1000000 })}")
    let old = peer.fd
    net.close(take peer)?
    print("closed_handle={row(net.Socket { fd: old })}")
    net.close(take tcp)?
    net.close(take tcp_peer)?
    net.close_listener(take tcp_srv)?
    net.close_listener(take srv)?
    0
}
