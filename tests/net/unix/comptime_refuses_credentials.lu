//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.net.unix, comptime.sandbox, comptime.sandbox.net
//!
//! sc83: credentials are a host net query, refused at comptime even with
//! a forged handle. The query's wrong-kind io row is not reached.

comptime fn probe() -> (int, int, int) ! {io, unsupported} {
    net_peer_cred(-1)
}

fn main() -> !int {
    const C = probe() else (-1, -1, -1)
    print("{C.0}")
    0
}
