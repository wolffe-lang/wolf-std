//! check: run(exit=0, stdout="ignore_one_zero=invalid\nignore_one_kill=invalid\nignore_one_stop=invalid\nignore_one_two_meanings=invalid\nignore_one_unpublished=invalid\nreset_one_zero=invalid\nreset_one_kill=invalid\nreset_one_stop=invalid\nreset_one_two_meanings=invalid\nreset_one_unpublished=invalid\nexit_signal_zero=invalid\nexit_signal_two_meanings=invalid\nexit_signal_unpublished=invalid\nfar_host_number=true")
//! phase: run
//! conforms: std.signal, std.process, os.signal.disp.one, os.signal.exit, os.signal.send, err.row
//!
//! **sc66: one meaning's disposition and the end by a signal, the rows
//! decided by their SHAPE** (ruling #88 R1, R2), before any host is
//! asked: one truth on every host and every compiled machine, and nothing
//! changes. A meaning is one bit of the table or a host number `-N`,
//! never 0; `kill()` and `stop()`, which no process can catch or ignore,
//! are `invalid` for `ignore_one` and `reset_one`; two meanings at once
//! and a bit past the table (1 << 28) are `invalid` for all three. A host
//! number far past any host's last signal is `invalid` where the host has
//! numbers and `unsupported` on windows, which has none, and the three
//! calls agree. s246's `corpus/os/signal_one_rows.lu`, through std.
//! lupin answers every shape row too: 0.1.54 did not resolve the calls,
//! and is77's 0.1.55 answers them before its refusal of a well-formed
//! call by name (wolf-interp#261; the ledger's flip, sc68).

use std.process
use std.signal

fn word_one(ignore: bool, m: int) -> str {
    if ignore {
        signal.ignore_one(m) else |e| {
            return match e {
                invalid => "invalid",
                io => "io",
                unsupported => "unsupported",
            }
        }
        return "ok"
    }
    signal.reset_one(m) else |e| {
        return match e {
            invalid => "invalid",
            io => "io",
            unsupported => "unsupported",
        }
    }
    "ok"
}

fn word_exit(m: int) -> str {
    process.exit_signal(m) else |e| {
        return match e {
            invalid => "invalid",
            unsupported => "unsupported",
        }
    }
    "returned"
}

fn main() -> !int {
    let two = signal.terminate() | signal.user()
    let past: int = 268435456
    for ignore in [true, false] {
        let name = if ignore { "ignore_one" } else { "reset_one" }
        print("{name}_zero={word_one(ignore, 0)}")
        print("{name}_kill={word_one(ignore, signal.kill())}")
        print("{name}_stop={word_one(ignore, signal.stop())}")
        print("{name}_two_meanings={word_one(ignore, two)}")
        print("{name}_unpublished={word_one(ignore, past)}")
    }
    print("exit_signal_zero={word_exit(0)}")
    print("exit_signal_two_meanings={word_exit(two)}")
    print("exit_signal_unpublished={word_exit(past)}")
    let far = signal.host(1099511627776)
    let a = word_one(true, far)
    let b = word_one(false, far)
    let c = word_exit(far)
    print("far_host_number={a == b && b == c && (a == "invalid" || a == "unsupported")}")
    0
}
