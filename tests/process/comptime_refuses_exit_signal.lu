//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.process, comptime.sandbox, comptime.sandbox.exec
//!
//! **D33 for `process.exit_signal` (sc66), held one level down at
//! `os_exit_signal`**: ending a process is `exec`, with `os_exit` (ruling
//! #88 R2), and a compile may not end the compiler. The row is handled
//! locally (F-0069); the pure `status_from` runs at run time to keep the
//! import used.

use std.process

comptime fn probe() -> int {
    os_exit_signal(16384) else |_| { return 1 }
    0
}

fn main() -> !int {
    const P = probe()
    print("p: {P} {process.is_exited(process.status_from(0))}")
    0
}
