//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.process, comptime.sandbox, comptime.sandbox.exec
//!
//! **D33 for `process.wait_status_core` and `poll_core` (sc66), held one
//! level down at `os_wait_status_core`**: the sibling reaps, as
//! `os_wait_status` does (`exec`, ruling #88 R3), and a compile may not
//! reap anything on the machine that compiles it. The row is handled
//! locally (F-0069); the pure `dumped_core` runs at run time to keep the
//! import used.

use std.process

comptime fn probe() -> int {
    os_wait_status_core(4242) else |_| { return 1 }
    0
}

fn main() -> !int {
    const P = probe()
    print("p: {P} {process.dumped_core(-267)}")
    0
}
