//! check: run(exit=1, stdout="empty argv: -1\nno such program: -1\nerror: not_found")
//! phase: run
//! conforms: std.process, os.proc.inherit, err.row, err.propagate, err.else
//!
//! **The EMPTY inherit set is not a special form, and that is the whole
//! point of this file.** `[os.proc.inherit]` says an empty set is
//! `os_spawn` with the program named apart from its arguments, and it is
//! served everywhere — on both hosts, on all three lanes, and on the two
//! machines that decline a NON-EMPTY set by name. So a caller that has
//! nothing to hand down writes `List[net.Listener]()` and gets an
//! ANSWER, never an `unsupported`, and a program does not have to branch
//! between two spawn calls to stay portable.
//!
//! **`not_found` twice, from the two conditions that reach it**, the same
//! pair `process/not_found_row.lu` holds for `start`: an argv that names
//! no program at all, and a program name no host has. The first one is
//! raised by `std.process` itself rather than delegated —
//! `os_spawn_with` takes the program APART from its arguments, so an
//! empty vector has no program to give it, and std answers the row the
//! whole-argv builtin would have answered rather than passing `""` down
//! and hoping.
//!
//! **Why this is deterministic on every tier-1 host.** No program is ever
//! started: an empty vector cannot name one and
//! `wolf-sc11-no-such-program-here` is a name no packaging system ships
//! (F-0066's reasoning, unchanged). The last call has no `else` — the tag
//! rides out of `main`, the process prints `error: not_found` and exits
//! 1, which is the toolchain naming the tag rather than this repository
//! asserting its own reading of it.
//!
//! The non-empty case cannot come here, because two of the three lanes
//! refuse it by name; it is `process/start_with_inherit_rows.lu`, native.

use std.net
use std.process

fn main() -> !int {
    let empty = process.from_argv(List[str]())
    let a = process.start_with(empty, List[net.Listener]()) else |_| {
        process.Child { slot: 0 - 1 }
    }
    print("empty argv: {a.slot}")
    let missing = process.command("wolf-sc11-no-such-program-here")
    let b = process.start_with(missing, List[net.Listener]()) else |_| {
        process.Child { slot: 0 - 1 }
    }
    print("no such program: {b.slot}")
    let c = process.command("wolf-sc11-no-such-program-here")
    let ch = process.start_with(c, List[net.Listener]())?
    print("unreachable: {ch.slot}")
    0
}
