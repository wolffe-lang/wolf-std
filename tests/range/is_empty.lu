//! check: run(exit=0)
//! phase: run
//! conforms: std.range, type.range, type.range.accessor
//!
//! `is_empty` was `std.range`'s one function for eleven sprints, because
//! emptiness is decidable from iteration alone; at wolf 0.2.14 it is
//! `r.start >= r.end` like the other three (`[type.range.accessor]`,
//! F-0030 closed). The relations here did not move with the body: a
//! reversed range (`7..3`) is empty, `a..a` is empty, and `a..a+1` is
//! not.
//!
//! Lane words: both compiler rungs run this now (they rejected the TYPE
//! `range[int]` as E0301 through 0.2.12). The reference machine ran the
//! iteration body and declines the accessor body BY NAME — lupin 0.1.36
//! mirrors v0.2.12, and "a range has no member `start`" is its whole
//! answer at resolve — so this row is `unsupported` there until the
//! mirror takes `[type.range]`.

use std.range

fn main() -> !int {
    if range.is_empty(5..5) {} else { return 1 }
    if range.is_empty(2..7) { return 2 }
    if range.is_empty(7..3) {} else { return 3 }
    if range.is_empty(0..1) { return 4 }
    if range.is_empty(0..0) {} else { return 5 }
    let lo = 3
    let hi = 3
    if range.is_empty(lo..hi) {} else { return 6 }
    0
}
