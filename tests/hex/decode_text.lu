//! check: run(exit=0)
//! phase: run
//! conforms: std.hex
//!
//! `decode_str`: the text round trip, and the line between its two tags.
//!
//! The property is `decode_str(encode_str(s)) == s` for every `s` — the
//! doctrine this module states for its byte pair, now stated for its text
//! pair, which is what §11's encoder/decoder rule asks for and what this
//! module could not promise until s81's `str_from_utf8` existed.
//!
//! The rows are held here by their EFFECT (a miss produces the fallback)
//! and by their identity in `decode_str_rows.lu`, which rides one out of
//! `main`. Both halves are needed: this file would pass if the two tags
//! were one, and that file would pass if the round trip were broken.

use std.hex

fn main() -> !int {
    // The empty string, both directions.
    if hex.encode_str("") == "" {} else { return 1 }
    if (hex.decode_str("") else "?") == "" {} else { return 2 }
    // ASCII, and the round trip through this module's own output.
    if (hex.decode_str("776f6c66") else "?") == "wolf" {} else { return 3 }
    if (hex.decode_str(hex.encode_str("wolf")) else "?") == "wolf" {} else { return 4 }
    // Every width of UTF-8 sequence: 2-byte, 3-byte, 4-byte.
    if (hex.decode_str("c3a9") else "?") == "é" {} else { return 5 }
    if (hex.decode_str(hex.encode_str("héllo")) else "?") == "héllo" {} else { return 6 }
    if (hex.decode_str(hex.encode_str("日本")) else "?") == "日本" {} else { return 7 }
    if (hex.decode_str(hex.encode_str("🐺")) else "?") == "🐺" {} else { return 8 }
    if (hex.decode_str(hex.encode_str("wolf é 日 🐺")) else "?") == "wolf é 日 🐺" {} else {
        return 9
    }
    // Case is not significant on the way in, exactly as in `decode`.
    if (hex.decode_str("C3A9") else "?") == "é" {} else { return 10 }
    if (hex.decode_str("c3A9") else "?") == "é" {} else { return 11 }
    // A control character survives the trip; an interior NUL is text, not
    // a terminator, because a `str` carries its length.
    if (hex.decode_str("0a") else "?") == "\n" {} else { return 12 }
    let nul = hex.decode_str("610062") else "?"
    if nul.len == 3 {} else { return 13 }
    // `parse`: the text is not hexadecimal.
    if (hex.decode_str("zz") else "NOT HEX") == "NOT HEX" {} else { return 14 }
    if (hex.decode_str("0f0") else "NOT HEX") == "NOT HEX" {} else { return 15 }
    if (hex.decode_str("é") else "NOT HEX") == "NOT HEX" {} else { return 16 }
    // `utf8`: the text IS hexadecimal and the bytes are not text. `ff`
    // begins no sequence; `c3` begins one and does not finish it; `eda080`
    // is a surrogate, which UTF-8 excludes.
    if (hex.decode_str("ff") else "NOT TEXT") == "NOT TEXT" {} else { return 17 }
    if (hex.decode_str("c3") else "NOT TEXT") == "NOT TEXT" {} else { return 18 }
    if (hex.decode_str("eda080") else "NOT TEXT") == "NOT TEXT" {} else { return 19 }
    if (hex.decode_str("c080") else "NOT TEXT") == "NOT TEXT" {} else { return 20 }
    // And the whole byte range still round-trips as BYTES even where it
    // cannot be read as text, which is why `decode` keeps the short name.
    var all = List[byte]()
    var i: int = 0
    while i < 256 {
        (mut all).push(i as byte)
        i = i + 1
    }
    let text = hex.encode(all)
    let back = hex.decode(text) else List[byte]()
    if back.len == 256 {} else { return 21 }
    if (hex.decode_str(text) else "NOT TEXT") == "NOT TEXT" {} else { return 22 }
    0
}
