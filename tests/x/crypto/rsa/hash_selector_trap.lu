//! check: run(exit=trap(assert))
//! phase: run
//! conforms: std.x.crypto.rsa, conf.trap.set
//!
//! sc79: a hash selector that is not one of `rsa.hash_sha256()`,
//! `hash_sha384()` or `hash_sha512()` is the caller's constant, not
//! data, so it traps `assert` (API-CONVENTIONS §2, §10) before any key
//! or signature is read.

use std.hex
use std.x.crypto.rsa

fn main() -> int {
    let kb = hex.decode(
        "",
    ) else List[byte]()
    let key = rsa.parse_public_key(kb) else |_| {
        return 2
    }
    if rsa.verify_pkcs1(key, 224, "m".bytes(), List[byte]()) {
        return 3
    }
    0
}
