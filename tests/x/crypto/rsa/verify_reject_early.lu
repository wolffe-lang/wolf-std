//! check: run(exit=0, stdout="short signature: refused\nlong signature: refused\nsignature at least n: refused\npss short signature: refused\npss signature at least n: refused")
//! phase: run
//! conforms: std.x.crypto.rsa
//!
//! sc79: the verifiers' early refusals, each answered false before any
//! modular exponentiation (RFC 8017 §8.2.2 step 1 and §8.1.2 step 1: a
//! signature that is not k octets; §5.2.2 step 1: a representative at
//! least n). THREE-LANE for that reason. The key is the vendored
//! 2049-bit one; the signatures are synthetic.

use std.hex
use std.x.crypto.rsa

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn filled(len: int, v: int) -> List[byte] {
    var out = List[byte]()
    var i: int = 0
    while i < len {
        (mut out).push(v as byte)
        i = i + 1
    }
    out
}

fn say(label: str, verdict: bool) {
    if verdict {
        print("{label}: accepted")
    } else {
        print("{label}: refused")
    }
}

fn main() -> int {
    let kb = bytes_of(
        "",
    )
    let key = rsa.parse_public_key(kb) else |_| {
        return 2
    }
    let msg = "sc79 row message".bytes()
    let h = rsa.hash_sha256()
    say("short signature", rsa.verify_pkcs1(key, h, msg, filled(256, 1)))
    say("long signature", rsa.verify_pkcs1(key, h, msg, filled(258, 1)))
    say("signature at least n", rsa.verify_pkcs1(key, h, msg, filled(257, 255)))
    say("pss short signature", rsa.verify_pss(key, h, msg, filled(256, 1), 32))
    say("pss signature at least n", rsa.verify_pss(key, h, msg, filled(257, 255), 32))
    0
}
