    let m = hex.decode(msg) else List[byte]()
    let s = hex.decode(sig) else List[byte]()
    rsa.verify_pkcs1(k, rsa.hash_sha256(), m, s) == want
}

fn vd1(key: str, msg: str, sig: str, want: bool) -> bool {
