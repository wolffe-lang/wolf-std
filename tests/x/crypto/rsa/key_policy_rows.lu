//! check: run(exit=0, stdout="2048 bits, e = 65537: ok\n2047 bits: small_modulus\n1024 bits: small_modulus\n4096 bits: ok\n4097 bits: large_modulus\neven modulus: bad_modulus\nleading zero octets: ok\ne = 3: ok\ne = 1: bad_exponent\ne = 2: bad_exponent\ne = 65536: bad_exponent\ne = n: bad_exponent\ne of 257 bits: bad_exponent\nempty e: bad_exponent\nder, 2049 bits: ok\nder, indefinite length: der\nder, non-minimal length: der\nder, negative modulus: der\nder, non-minimal INTEGER: der\nder, trailing byte: der\nder, one INTEGER: der\nder, empty: der")
//! phase: run
//! conforms: std.x.crypto.rsa, err.row, err.else
//!
//! sc79: the RSA key policy, every refusal by name. `rsa.public_key`
//! refuses a modulus under 2048 bits (`small_modulus`) or over 4096
//! (`large_modulus`), an even modulus (`bad_modulus`), and an exponent
//! that is even, below 3, at least n or at least 2^256 (`bad_exponent`);
//! `rsa.parse_public_key` adds `der` for an RSAPublicKey that is not
//! strict X.690 DER. The moduli are synthetic (the policy reads only
//! their size and parity); the DER rows mutate the vendored 2049-bit
//! `vendor/vectors/pki/sc79/rsa2049.pub.der`. THREE-LANE: no row
//! reaches a modular exponentiation.

use std.hex
use std.x.crypto.rsa

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

/// `len` octets: `top`, zeros, then `low` (or one octet `top` when
/// `len` is 1).
fn number(len: int, top: int, low: int) -> List[byte] {
    var out = List[byte]()
    var i: int = 0
    while i < len {
        if i == 0 {
            (mut out).push(top as byte)
        } else if i == len - 1 {
            (mut out).push(low as byte)
        } else {
            (mut out).push(0 as byte)
        }
        i = i + 1
    }
    out
}

fn word(n: List[byte], e: List[byte]) -> str {
    let k = rsa.public_key(n, e) else |err| match err {
        small_modulus => {
            return "small_modulus"
        },
        large_modulus => {
            return "large_modulus"
        },
        bad_modulus => {
            return "bad_modulus"
        },
        bad_exponent => {
            return "bad_exponent"
        },
    }
    if k.bits > 0 {
        return "ok"
    }
    "?"
}

fn der_word(h: str) -> str {
    let b = bytes_of(h)
    let k = rsa.parse_public_key(b) else |err| match err {
        der => {
            return "der"
        },
        small_modulus => {
            return "small_modulus"
        },
        large_modulus => {
            return "large_modulus"
        },
        bad_modulus => {
            return "bad_modulus"
        },
        bad_exponent => {
            return "bad_exponent"
        },
    }
    if k.bits == 2049 {
        return "ok"
    }
    "?"
}

fn main() -> int {
    let e65537 = number(3, 1, 1)
    let n2048 = number(256, 192, 1)
    print("2048 bits, e = 65537: {word(n2048, e65537)}")
    print("2047 bits: {word(number(256, 127, 1), e65537)}")
    print("1024 bits: {word(number(128, 192, 1), e65537)}")
    print("4096 bits: {word(number(512, 128, 1), e65537)}")
    print("4097 bits: {word(number(513, 1, 1), e65537)}")
    print("even modulus: {word(number(256, 192, 2), e65537)}")
    var padded = List[byte]()
    (mut padded).push(0 as byte)
    (mut padded).push(0 as byte)
    for v in n2048 {
        (mut padded).push(v)
    }
    print("leading zero octets: {word(padded, e65537)}")
    print("e = 3: {word(n2048, number(1, 3, 3))}")
    print("e = 1: {word(n2048, number(1, 1, 1))}")
    print("e = 2: {word(n2048, number(1, 2, 2))}")
    print("e = 65536: {word(n2048, number(3, 1, 0))}")
    print("e = n: {word(n2048, n2048)}")
    print("e of 257 bits: {word(n2048, number(33, 1, 1))}")
    print("empty e: {word(n2048, List[byte]())}")
    print(
        "der, 2049 bits: {der_word("")}",
    )
    print(
        "der, indefinite length: {der_word("")}",
    )
    print(
        "der, non-minimal length: {der_word("")}",
    )
    print(
        "der, negative modulus: {der_word("")}",
    )
    print(
        "der, non-minimal INTEGER: {der_word("")}",
    )
    print(
        "der, trailing byte: {der_word("")}",
    )
    print(
        "der, one INTEGER: {der_word("")}",
    )
    print("der, empty: {der_word("")}")
    0
}
