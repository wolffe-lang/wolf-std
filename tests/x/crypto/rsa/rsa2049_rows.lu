//! check: run(exit=0, stdout="rsa2049: 9 rows")
//! phase: run
//! conforms: std.x.crypto.rsa
//!
//! sc79: a 2049-bit modulus, where RSASSA-PSS's encoded message is one
//! octet shorter than the modulus (RFC 8017 §8.1.2 step 2c: emBits =
//! modBits − 1 = 2048, so emLen = k − 1 and RSAVP1's leading octet must
//! be zero). No Wycheproof file carries this shape. The key and both
//! signatures are the pinned OpenSSL binary's
//! (`vendor/vectors/pki/sc79/rsa2049*`), over the 16 bytes
//! `sc79 row message`. Each row prints `FAIL <name>` when its verdict is
//! wrong and the program then exits 1.

use std.hex
use std.x.crypto.rsa

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn row(name: str, ok: bool) -> int {
    if ok {
        return 0
    }
    print("FAIL {name}")
    1
}

fn main() -> int {
    let kb = bytes_of(
        "",
    )
    let key = rsa.parse_public_key(kb) else |_| {
        print("FAIL rsa2049-key-parses")
        return 1
    }
    let msg = "sc79 row message".bytes()
    let pss = bytes_of(
        "",
    )
    let pk1 = bytes_of(
        "",
    )
    let pss_flipped = bytes_of(
        "",
    )
    let sha256 = rsa.hash_sha256()
    var bad: int = 0
    bad = bad + row("rsa2049-modulus-bits", key.bits == 2049)
    bad = bad + row("pss-2049-sha256-salt32", rsa.verify_pss(key, sha256, msg, pss, 32))
    bad = bad + row("pss-2049-salt31-refused", !rsa.verify_pss(key, sha256, msg, pss, 31))
    bad = bad + row("pss-2049-salt33-refused", !rsa.verify_pss(key, sha256, msg, pss, 33))
    bad = bad +
        row("pss-2049-sha384-refused", !rsa.verify_pss(key, rsa.hash_sha384(), msg, pss, 32))
    bad = bad + row("pss-2049-flipped-refused", !rsa.verify_pss(key, sha256, msg, pss_flipped, 32))
    bad = bad + row("pkcs1-2049-sha256", rsa.verify_pkcs1(key, sha256, msg, pk1))
    bad = bad + row("pkcs1-2049-as-pss-refused", !rsa.verify_pss(key, sha256, msg, pk1, 32))
    bad = bad + row("pss-2049-as-pkcs1-refused", !rsa.verify_pkcs1(key, sha256, msg, pss))
    if bad > 0 {
        return 1
    }
    print("rsa2049: 9 rows")
    0
}
