//! check: run(exit=0)
//! phase: run
//! conforms: std.x.crypto.chacha20, arith.wrapping
//!
//! RFC 8439 Appendix A.5 — AEAD_CHACHA20_POLY1305 decryption: the
//! 265-byte draft-agl-tls-chacha20poly1305 text under the published
//! key, nonce, AAD and received tag. `open` must accept the tag and
//! give back the published plaintext; sealing the plaintext must
//! reproduce ciphertext||tag byte for byte. Hex quoted from
//! `vendor/vectors/rfc/rfc8439.txt`.

use std.hex
use std.x.crypto.chacha20

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn main() -> int {
    let key = bytes_of("1c9240a5eb55d38af333888604f6b5f0473917c1402b80099dca5cbc207075c0")
    let nonce = bytes_of("000000000102030405060708")
    let aad = bytes_of("f33388860000000000004e91")
    let boxed = bytes_of(
        "",
    )
    let opened = chacha20.open(key, nonce, aad, boxed) else List[byte]()
    assert(
        chacha20.to_hex(opened) ==
            "",
        "A.5 open",
    )
    let resealed = chacha20.
        seal(
        key,
        nonce,
        aad,
        bytes_of(
            "",
        ),
    )
    assert(
        chacha20.to_hex(resealed) ==
            "",
        "A.5 seal",
    )
    0
}
