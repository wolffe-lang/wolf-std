//! `vendor/vectors/README.md`). Do not edit by hand; ci's
//! `gen-vectors --check` holds this file byte-identical to its source.
//!
//! Wycheproof v1 ChaCha20-Poly1305, the VALID set, part 8 of
//! 8 (32 vectors of the set's 256): each case seals to the
//! published ciphertext||tag AND opens back to the message —
//! Ktv, pseudorandom, and the edge-case Poly1305/keystream
//! constructions. The interpreter column is `slow` (the sc16
//! ledger word): 32 seal+open pairs measure 98s under lupin
//! 0.1.13 against the rig's 60s ceiling (F-0093's program-age
//! curve), the `..._smoke.lu` subset keeps the differential
//! column, and the chunking is what flips this file back to
//! `run` when wolf-interp#41 lands.

use std.hex
use std.x.crypto.chacha20

fn aead_matches(key_hex: str, iv_hex: str, aad_hex: str, msg_hex: str, box_hex: str) -> bool {
    let key = hex.decode(key_hex) else List[byte]()
    let iv = hex.decode(iv_hex) else List[byte]()
    let aad = hex.decode(aad_hex) else List[byte]()
    let msg = hex.decode(msg_hex) else List[byte]()
    let boxed = chacha20.seal(key, iv, aad, msg)
    if !(chacha20.to_hex(boxed) == box_hex) {
        return false
    }
    let opened = chacha20.open(key, iv, aad, boxed) else List[byte]()
    chacha20.to_hex(opened) == msg_hex
}

