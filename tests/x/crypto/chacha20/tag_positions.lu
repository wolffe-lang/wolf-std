//! check: run(exit=0)
//! phase: run
//! conforms: std.x.crypto.chacha20, err.row
//!
//! RFC 8439 section 2.8.2 box, every tag position and short framing.
use std.hex
use std.x.crypto.chacha20

fn refused(key: List[byte], nonce: List[byte], aad: List[byte], boxed: List[byte]) -> bool {
    var rejected = false
    let out = chacha20.open(key, nonce, aad, boxed) else |tag| {
        rejected = true
        List[byte]()
    }
    assert(out.len == 0)
    rejected
}

fn main() -> int {
    let key = hex.decode("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f") else List[byte]()
    let nonce = hex.decode("070000004041424344454647") else List[byte]()
    let aad = hex.decode("50515253c0c1c2c3c4c5c6c7") else List[byte]()
    let boxed = hex.decode("d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691") else List[byte]()
    let split = boxed.len - 16
    for i in split..boxed.len {
        var bad = copy boxed
        bad[i] = ((bad[i] as int + 1) % 256) as byte
        assert(refused(key, nonce, aad, bad))
    }
    for n in 0..16 { assert(refused(key, nonce, aad, boxed[0..n])) }
    var bad_ct = copy boxed
    bad_ct[0] = 0 as byte
    assert(refused(key, nonce, aad, bad_ct))
    assert(refused(key, nonce, "wrong aad".bytes(), boxed))
    let empty = chacha20.seal(key, nonce, List[byte](), List[byte]())
    assert(empty.len == 16)
    let plain = chacha20.open(key, nonce, List[byte](), empty) else "wrong".bytes()
    assert(plain.len == 0)
    0
}
