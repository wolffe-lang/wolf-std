//!
//! Wycheproof v1 ChaCha20-Poly1305, the DIFFERENTIAL SMOKE SUBSET
//! of the valid set: the first 10 valid vectors with msg <= 48
//! and aad <= 16 bytes (of the set's 256) — small enough that
//! the interpreter runs the file inside the rig's ceiling, so the
//! AEAD keeps a differential column while the full set rides the
//! `..._p*.lu` parts on the native lane.

use std.hex
use std.x.crypto.chacha20

fn aead_matches(key_hex: str, iv_hex: str, aad_hex: str, msg_hex: str, box_hex: str) -> bool {
    let key = hex.decode(key_hex) else List[int]()
    let iv = hex.decode(iv_hex) else List[int]()
    let aad = hex.decode(aad_hex) else List[int]()
    let msg = hex.decode(msg_hex) else List[int]()
    let boxed = chacha20.seal(key, iv, aad, msg)
    if !(chacha20.to_hex(boxed) == box_hex) {
        return false
    }
    let opened = chacha20.open(key, iv, aad, boxed) else List[int]()
    chacha20.to_hex(opened) == msg_hex
}

