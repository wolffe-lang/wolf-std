//! check: run(exit=1, stdout="witness: fallback empty\nerror: tag")
//! phase: run
//! conforms: std.x.crypto.chacha20, err.row, err.propagate, err.else
//!
//! THE FLIPPED-TAG WITNESS (the sc17 contract's pin): seal the
//! §2.8.2 vector, flip ONE BIT of the tag's last byte, and `open`
//! must answer the `tag` row with ZERO plaintext escaping. Two halves,
//! per the sc07 row-test shape: an `else` proves the miss path is
//! taken and that the fallback — the only value the caller ever sees —
//! is EMPTY (open computes no plaintext on the reject path; the row is
//! the entire result), and a final `?` rides the tag out of `main` so
//! the toolchain itself names it (`error: tag`, exit 1) — the record's
//! word, not this repository's.

use std.hex
use std.x.crypto.chacha20

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn main() -> !int {
    let key = bytes_of("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    let nonce = bytes_of("070000004041424344454647")
    let aad = bytes_of("50515253c0c1c2c3c4c5c6c7")
    let boxed = chacha20.
        seal(
        key,
        nonce,
        aad,
        bytes_of(
            "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e",
        ),
    )
    let n = boxed.len
    var forged = List[byte]()
    var last: int = 0
    var pos: int = 0
    for b in boxed {
        if pos < n - 1 {
            (mut forged).push(b)
        } else {
            last = b as int
        }
        pos = pos + 1
    }
    var flipped = last + 1
    if last % 2 == 1 {
        flipped = last - 1
    }
    (mut forged).push(flipped as byte)
    let hush = chacha20.open(key, nonce, aad, forged) else List[byte]()
    assert(hush.len == 0, "flipped tag yields zero plaintext")
    print("witness: fallback empty")
    let never = chacha20.open(key, nonce, aad, forged)?
    print("unreachable: {never.len}")
    0
}
