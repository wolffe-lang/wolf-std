//! check: run(exit=0, stdout="rfc7914 core: 3 rows")
//! phase: run
//! conforms: std.x.crypto.scrypt
//!
//! sc80: RFC 7914's three building-block vectors, quoted from
//! `vendor/vectors/rfc/rfc7914.txt`: §8 (the Salsa20/8 Core on one
//! 64-octet block), §9 (scryptBlockMix with r = 1, B[0] || B[1] in,
//! B'[0] || B'[1] out) and §10 (scryptROMix with r = 1 and N = 16). Each
//! is "the first input and output pair generated by the first scrypt
//! test vector". Each row prints `FAIL <name>` when its output differs,
//! and the program then exits 1. THREE-LANE: the largest row is 32
//! BlockMix calls.

use std.hex
use std.x.crypto.scrypt

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn row(name: str, ok: bool) -> int {
    if ok {
        return 0
    }
    print("FAIL {name}")
    1
}

fn main() -> int {
    let salsa_in = bytes_of(
        "7e879a214f3ec9867ca940e641718f26baee555b8c61c1b50df846116dcd3b1dee24f319df9b3d8514121e4b5ac5aa3276021d2909c74829edebc68db8b8c25e",
    )
    let salsa_out = "a41f859c6608cc993b81cacb020cef05044b2181a2fd337dfd7b1c6396682f29b4393168e3c9e6bcfe6bc5b7a06d96bae424cc102c91745c24ad673dc7618f81"
    let block_in = bytes_of(
        "f7ce0b653d2d72a4108cf5abe912ffdd777616dbbb27a70e8204f3ae2d0f6fad89f68f4811d1e87bcc3bd7400a9ffd29094f0184639574f39ae5a1315217bcd7894991447213bb226c25b54da86370fbcd984380374666bb8ffcb5bf40c254b067d27c51ce4ad5fed829c90b505a571b7f4d1cad6a523cda770e67bceaaf7e89",
    )
    let block_out = "a41f859c6608cc993b81cacb020cef05044b2181a2fd337dfd7b1c6396682f29b4393168e3c9e6bcfe6bc5b7a06d96bae424cc102c91745c24ad673dc7618f8120edc975323881a80540f64c162dcd3c21077cfe5f8d5fe2b1a4168f953678b77d3b3d803b60e4ab920996e59b4d53b65d2a225877d5edf5842cb9f14eefe425"
    let romix_out = "79ccc193629debca047f0b70604bf6b62ce3dd4a9626e355fafc6198e6ea2b46d58413673b99b029d665c357601fb426a0b2f4bba200ee9f0a43d19b571a9c71ef1142e65d5a266fddca832ce59faa7cac0b9cf1be2bffca300d01ee387619c4ae12fd4438f203a0e4e1c47ec314861f4e9087cb33396a6873e8f9d2539a4b8e"
    var bad: int = 0
    bad = bad + row("rfc7914-s8-salsa20-8", scrypt.to_hex(scrypt.salsa20_8(salsa_in)) == salsa_out)
    bad = bad + row("rfc7914-s9-blockmix", scrypt.to_hex(scrypt.blockmix(block_in, 1)) == block_out)
    let rm = scrypt.romix(block_in, 1, 16) else |_| {
        print("FAIL rfc7914-s10-romix")
        return 1
    }
    bad = bad + row("rfc7914-s10-romix", scrypt.to_hex(rm) == romix_out)
    if bad > 0 {
        return 1
    }
    print("rfc7914 core: 3 rows")
    0
}
