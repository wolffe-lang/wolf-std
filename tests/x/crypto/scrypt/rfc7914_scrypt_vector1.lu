//! check: run(exit=0, stdout="rfc7914 scrypt vector 1: 1 row")
//! phase: run
//! conforms: std.x.crypto.scrypt
//!
//! sc80: RFC 7914 §12's first scrypt vector: P = "", S = "", N = 16,
//! r = 1, p = 1, 64 octets, quoted from `vendor/vectors/rfc/rfc7914.txt`.
//! The cap is exactly `scrypt.memory(4, 1, 1, 64)`, so the row also holds
//! that the module's own estimate admits the run it describes.
//! THREE-LANE.

use std.x.crypto.scrypt

fn main() -> int {
    let want = "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906"
    let dk = scrypt.scrypt(
        List[byte](),
        List[byte](),
        4,
        1,
        1,
        64,
        scrypt.memory(4, 1, 1, 64),
    ) else |_| {
        print("FAIL rfc7914-s12-vector1")
        return 1
    }
    if scrypt.to_hex(dk) != want {
        print("FAIL rfc7914-s12-vector1")
        return 1
    }
    print("rfc7914 scrypt vector 1: 1 row")
    0
}
