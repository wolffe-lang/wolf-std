//! check: run(exit=0, stdout="ubuntu strings: 39 rows")
//! phase: run
//! conforms: std.x.crypto.passwd, std.x.crypto.sha2
//!
//! sc80: `$7$` strings Ubuntu 24.04's crypt made, checked three ways:
//! `passwd.verify` accepts each with its password, rejects it with the
//! password one octet longer, and `passwd.hash` of the same password,
//! salt and cost gives the same string, byte for byte. Each password is
//! the first 20 hex digits of SHA-256("sc80 ubuntu fixture password
//! <row>"), derived here at run time, and each salt is crypt's base-64
//! of the first 0, 16 or 64 octets of SHA-512("sc80 ubuntu fixture salt
//! <row>"). The strings are generated test data: GENERATED by
//! `docs/sc80-witness/interop/ubuntu_fixture.py` in sc80's pinned image
//! with these packages:
//!   libcrypt1 1:4.4.36-4build1
//!   libssl3t64 3.0.13-0ubuntu3.16
//!   perl-base 5.38.2-3.2ubuntu0.6
//!   python3.12 3.12.3-1ubuntu0.17
//!   whois 5.5.22
//! The local record's `ubuntu-fixture` step regenerates them and
//! compares. Rows 8 and 9 sit at `mkpasswd -R 7` and `-R 6`'s costs
//! (r = 32), and `mkpasswd -m scrypt -S <setting>` made the same string.
//! Each row prints `FAIL <name>` when it is wrong,
//! and the program then exits 1. Native only: rows at N = 2^14 and
//! 2^15 exhaust the interpreter's and the checked tier's step budgets.

use std.x.crypto.passwd
use std.x.crypto.sha2

fn row(name: str, ok: bool) -> int {
    if ok {
        return 0
    }
    print("FAIL {name}")
    1
}

/// Row `i`'s password: the first 20 hex digits of SHA-256 of its label.
fn password(i: int) -> List[byte] {
    let hex = sha2.to_hex(sha2.sum256("sc80 ubuntu fixture password {i}".bytes()))
    hex[0..20].bytes()
}

/// Row `i`'s salt: crypt's base-64 of the first `octets` octets of
/// SHA-512 of its label (`passwd.gen_salt` for 16 and 64; empty for 0).
fn salt(i: int, octets: int) -> str {
    if octets == 0 {
        return ""
    }
    let d = sha2.sum512("sc80 ubuntu fixture salt {i}".bytes())
    var head = List[byte]()
    var k: int = 0
    while k < octets {
        (mut head).push(d[k])
        k = k + 1
    }
    passwd.gen_salt(head) else ""
}

fn check(i: int, n_log2: int, r: int, p: int, octets: int, line: str) -> int {
    let pw = password(i)
    var longer = List[byte]()
    for b in pw {
        (mut longer).push(b)
    }
    (mut longer).push(33 as byte)
    let accepted = passwd.verify(pw, line) else false
    let rejected = passwd.verify(longer, line) else true
    let c = passwd.cost(n_log2, r, p) else |_| {
        print("FAIL ubuntu-{i}-cost")
        return 1
    }
    let mine = passwd.hash(pw, salt(i, octets), c) else ""
    var bad: int = 0
    bad = bad + row("ubuntu-{i}-verifies", accepted)
    bad = bad + row("ubuntu-{i}-wrong-password-refused", !rejected)
    bad = bad + row("ubuntu-{i}-hash-identical", mine == line)
    bad
}

fn main() -> int {
    var bad: int = 0
    let s0 = "$7$86..../....ihh7PT1B5V6yIyineF30i1$l1olD0a/9h.xHA0dwi4U8QM0f.e67V3iAbNpmo7RNc4"
    bad = bad + check(0, 10, 8, 1, 16, s0)
    let s1 = "$7$86..../....7stkiRNchuSJrm1RhJ7tZ.$6Yn8TIxN400g.0t2s1Dxq2Zwab59p6vcOtfUQddU3ID"
    bad = bad + check(1, 10, 8, 1, 16, s1)
    let s2 = "$7$86..../....EDXuouSa0Rq7.EbuTyNj1.$hDiJhydOOsXXXmnt2zdDo/MLOPFYbqNJJJ6gL9e1n93"
    bad = bad + check(2, 10, 8, 1, 16, s2)
    let s3 = "$7$86..../....JEnx3dXqRQnQbcxgk6.8U.$qULB200z2ZoLEUohpEA0wqFAqdUTRXpqYNFOzPfm0x."
    bad = bad + check(3, 10, 8, 1, 16, s3)
    let s4 = "$7$C6..../....fAeCdU7ntYOAYJ0bHTbll/$bAkTOnJEpMqdyjdd.vEweNnYbCGI8RCjB7FWsXqz3W5"
    bad = bad + check(4, 14, 8, 1, 16, s4)
    let s5 = "$7$C6..../....5n9KylmIjjlaOY9xc6S4x.$QmtZKFQ.YiEEGx4u6HJ8PXQOgOVDyzs4a2BupZTtoSD"
    bad = bad + check(5, 14, 8, 1, 16, s5)
    let s6 = "$7$D6..../....1pehHtjxR4UyEUF4WoStD1$KwGVs4YxqN3vYWRe97ek14iJxhBpphOOHq0O7dqFKFD"
    bad = bad + check(6, 15, 8, 1, 16, s6)
    let s7 = "$7$D6..../....ePMk0EW53SZhbYyxUizYs.$R6MfBJK7dRodyIp850c.F.NNc/umjui/VAi0qttgOnD"
    bad = bad + check(7, 15, 8, 1, 16, s7)
    let s8 = "$7$CU..../....ewCiD0WFMuCICVlHt2XLu0$2hvmYWGM3UMbMDjhNemdVwY6AmI/xp/LQJ1QXgFZHK2"
    bad = bad + check(8, 14, 32, 1, 16, s8)
    let s9 = "$7$BU..../....kvc8Im1Al7DMWxSKewHh80$3WIDV3tMHeD9m8sq4yIfIOAQMxcvJV1hw5IUSQGqwa9"
    bad = bad + check(9, 13, 32, 1, 16, s9)
    let s10 = "$7$82....0....Lfg3hcuz5tMg5MjogjmpH/$ab0FfDAcZ9gH5wOolJS5YZ3Q6/7oROHW15Ww3PsxVu."
    bad = bad + check(10, 10, 4, 2, 16, s10)
    let s11 = "$7$86..../....$1p1koMVSFe1Z8d8cbbs/jZVfFw5EhBLCeeDu6Olblq8"
    bad = bad + check(11, 10, 8, 1, 0, s11)
    let s12 = "$7$86..../....1OmOD9aVLm2sfsMUJTX25CwskVvVR.L.Dl4uLdIxBBncTH/JN.nwF2f.d9wLd2h3i3B31dfpT6qFF85iQ5Urh.$/4VMR.aLn3VyYq7neYqkHWZARCTJ2AqCPLFEh5Yus23"
    bad = bad + check(12, 10, 8, 1, 64, s12)
    if bad > 0 {
        return 1
    }
    print("ubuntu strings: 39 rows")
    0
}
