fn vd(pk: str, msg: str, der: str, want: bool) -> bool {
    let key = hex.decode(pk) else List[byte]()
    let m = hex.decode(msg) else List[byte]()
    let d = hex.decode(der) else List[byte]()
    p256.verify_der(key, m, d) == want
}

