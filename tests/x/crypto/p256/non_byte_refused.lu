//! check: run(exit=trap(assert))
//! phase: run
//! conforms: std.x.crypto.p256, arith.checked
//!
//! THE 0..255 BYTE CONTRACT (F-0035): a private key carrying an element
//! outside 0..255 is a caller contract violation, so `public_key` traps
//! `assert` at ingestion — BEFORE any scalar multiplication, so the
//! trap fires on all three lanes (the guards-before-the-core rule).

use std.x.crypto.p256

fn main() -> int {
    var d = List[int]()
    var i = 0
    while i < 31 {
        (mut d).push(1)
        i = i + 1
    }
    (mut d).push(999)
    let pk = p256.public_key(d)
    print("unreachable: {pk.len}")
    0
}
