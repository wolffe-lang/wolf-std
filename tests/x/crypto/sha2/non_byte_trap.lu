//! check: run(exit=trap(assert))
//! phase: run
//! conforms: std.x.crypto.sha2, conf.trap.set
//!
//! §11's byte contract, held: an element outside 0..255 is a caller
//! contract violation and traps `assert` at ingestion — a wrapping cast
//! would otherwise silently digest a value the caller never meant. The
//! print proves the trap fires at the bad element, not before.

use std.x.crypto.sha2

fn main() -> int {
    var msg = List[int]()
    (mut msg).push(97)
    (mut msg).push(256)
    print("reached the call")
    let d = sha2.sum256(msg)
    print("unreachable: {d.len}")
    0
}
