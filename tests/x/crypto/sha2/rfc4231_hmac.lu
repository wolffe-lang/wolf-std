//! check: run(exit=0)
//! phase: run
//! conforms: std.x.crypto.sha2, arith.wrapping
//!
//! RFC 4231 (Identifiers and Test Vectors for HMAC-SHA-224, -256, -384,
//! -512): all seven test cases, sections 4.2-4.8, for the three digests
//! this module ships — 21 vectors, hex quoted verbatim from
//! `vendor/vectors/rfc/rfc4231.txt`. The HMAC-SHA-224 column is omitted
//! by name: SHA-224 is outside D53's ladder. Test case 5 publishes a
//! 128-bit TRUNCATED output, so its assertions compare the first 32 hex
//! digits (`[0..32]` of the rendering); the RFC's own heading says
//! "with a truncation of output to 128 bits". Cases 6 and 7 use
//! 131-byte keys — the longer-than-block path that forces the FIPS
//! 198-1 step-2 key reduction in all three widths.

use std.hex
use std.x.crypto.sha2

fn mac256(key_hex: str, data_hex: str) -> str {
    let key = hex.decode(key_hex) else List[int]()
    let data = hex.decode(data_hex) else List[int]()
    sha2.to_hex(sha2.hmac256(key, data))
}

fn mac384(key_hex: str, data_hex: str) -> str {
    let key = hex.decode(key_hex) else List[int]()
    let data = hex.decode(data_hex) else List[int]()
    sha2.to_hex(sha2.hmac384(key, data))
}

fn mac512(key_hex: str, data_hex: str) -> str {
    let key = hex.decode(key_hex) else List[int]()
    let data = hex.decode(data_hex) else List[int]()
    sha2.to_hex(sha2.hmac512(key, data))
}

fn main() -> int {
    let k1 = "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"
    let d1 = "4869205468657265"
    assert(
        mac256(k1, d1) == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
        "tc1 hmac256",
    )
    assert(
        mac384(k1, d1) ==
            "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6",
        "tc1 hmac384",
    )
    assert(
        mac512(k1, d1) ==
            "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854",
        "tc1 hmac512",
    )
    let k2 = "4a656665"
    let d2 = "7768617420646f2079612077616e7420666f72206e6f7468696e673f"
    assert(
        mac256(k2, d2) == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843",
        "tc2 hmac256",
    )
    assert(
        mac384(k2, d2) ==
            "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649",
        "tc2 hmac384",
    )
    assert(
        mac512(k2, d2) ==
            "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737",
        "tc2 hmac512",
    )
    let k3 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let d3 = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
    assert(
        mac256(k3, d3) == "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe",
        "tc3 hmac256",
    )
    assert(
        mac384(k3, d3) ==
            "88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27",
        "tc3 hmac384",
    )
    assert(
        mac512(k3, d3) ==
            "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb",
        "tc3 hmac512",
    )
    let k4 = "0102030405060708090a0b0c0d0e0f10111213141516171819"
    let d4 = "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"
    assert(
        mac256(k4, d4) == "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b",
        "tc4 hmac256",
    )
    assert(
        mac384(k4, d4) ==
            "3e8a69b7783c25851933ab6290af6ca77a9981480850009cc5577c6e1f573b4e6801dd23c4a7d679ccf8a386c674cffb",
        "tc4 hmac384",
    )
    assert(
        mac512(k4, d4) ==
            "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd",
        "tc4 hmac512",
    )
    let k5 = "0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c"
    let d5 = "546573742057697468205472756e636174696f6e"
    assert(mac256(k5, d5)[0..32] == "a3b6167473100ee06e0c796c2955552b", "tc5 hmac256")
    assert(mac384(k5, d5)[0..32] == "3abf34c3503b2a23a46efc619baef897", "tc5 hmac384")
    assert(mac512(k5, d5)[0..32] == "415fad6271580a531d4179bc891d87a6", "tc5 hmac512")
    let k6 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let d6 = "54657374205573696e67204c6172676572205468616e20426c6f636b2d53697a65204b6579202d2048617368204b6579204669727374"
    assert(
        mac256(k6, d6) == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54",
        "tc6 hmac256",
    )
    assert(
        mac384(k6, d6) ==
            "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952",
        "tc6 hmac384",
    )
    assert(
        mac512(k6, d6) ==
            "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598",
        "tc6 hmac512",
    )
    let k7 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let d7 = ""
    assert(
        mac256(k7, d7) == "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2",
        "tc7 hmac256",
    )
    assert(
        mac384(k7, d7) ==
            "6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e",
        "tc7 hmac384",
    )
    assert(
        mac512(k7, d7) ==
            "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58",
        "tc7 hmac512",
    )
    0
}
