//!
//! Wycheproof v1 HKDF-SHA-384, the DIFFERENTIAL SMOKE SUBSET:
//! the first 6 valid vectors with okm length <= 96 bytes
//! (tcIds 1, 2, 3, 4, 5, 6) — small enough that the interpreter lane runs the
//! file inside the rig's ceiling, so HKDF keeps a lupin column
//! while the full 80 ride `..._full.lu` on the native lane.

use std.hex
use std.x.crypto.sha2

fn okm_matches(ikm_hex: str, salt_hex: str, info_hex: str, n: int, want: str) -> bool {
    let ikm = hex.decode(ikm_hex) else List[byte]()
    let salt = hex.decode(salt_hex) else List[byte]()
    let info = hex.decode(info_hex) else List[byte]()
    sha2.to_hex(sha2.hkdf384(salt, ikm, info, n)) == want
}

fn main() -> int {
    assert(
        okm_matches(
            "24aeff2645e3e0f5494a9a102778c43a",
            "",
            "",
            20,
            "4b7045423d9156424b0b85d95a7d602fba3924b1",
        ),
        "tc 1",
    )
    assert(
