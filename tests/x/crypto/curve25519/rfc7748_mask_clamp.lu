//! check: run(exit=0)
//! phase: run
//! conforms: std.x.crypto.curve25519, err.row
//!
//! RFC 7748 section 5 masking/clamping requirements applied to section 5.2.
use std.hex
use std.bytes
use std.x.crypto.curve25519

fn main() -> int {
    let scalar = hex.decode("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4") else List[byte]()
    let u = hex.decode("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c") else List[byte]()
    let want = hex.decode("c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552") else List[byte]()
    var high = copy u
    high[31] = (u[31] as int + 128) as byte
    let masked = curve25519.x25519(scalar, high) else List[byte]()
    assert(bytes.is_equal_fixed_work(masked, want))
    var other = copy scalar
    other[0] = (scalar[0] as int - scalar[0] as int % 8 + (scalar[0] as int + 1) % 8) as byte
    other[31] = (scalar[31] as int % 64) as byte
    let clamped = curve25519.x25519(other, u) else List[byte]()
    assert(bytes.is_equal_fixed_work(clamped, want))
    0
}
