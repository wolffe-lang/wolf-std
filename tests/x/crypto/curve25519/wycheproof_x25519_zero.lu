//!
//! Wycheproof v1 X25519, the ZERO-SHARED-SECRET set: all 31
//! `acceptable` vectors flagged `ZeroSharedSecret` — small-order
//! public keys for which `x25519` must raise the `zero` row
//! (RFC 8446 §7.4.2 requires a TLS 1.3 endpoint to abort rather
//! than use a predictable secret). This is the module's security
//! core, kept WHOLE, and the reject is witnessed as a negative
//! sentinel from the helper's `zero` handler. The interpreter
//! column is `slow` (F-0093); `..._zero_smoke.lu` keeps it
//! differential.

use std.hex
use std.x.crypto.curve25519

fn zero_verdict(priv_hex: str, pub_hex: str) -> int {
    let sk = hex.decode(priv_hex) else List[byte]()
    let pk = hex.decode(pub_hex) else List[byte]()
    let out = curve25519.x25519(sk, pk) else |_| {
        return -1
    }
    out.len
}

