//! check: run(exit=0)
//! phase: run
//! conforms: std.x.crypto.curve25519, arith.checked
//!
//! GENERATED by `tests/x/crypto/curve25519/small_order.py`
//! (python3, from the curve equation and RFC 8032's text, independent
//! of std's wolf code). Do not edit by hand; `small_order.py --check`
//! holds this file byte-identical to its generator.
//!
//! The documented LIMIT of `verify_strict`: a mixed-order public key,
//! TEST 1's A plus a small-order T (of order 2, then 8), is not of
//! small order, so the [8]P check does not refuse it, and a signature
//! whose k is a multiple of ord(T) satisfies the cofactorless equation.
//! Both `verify` and `verify_strict` accept these rows. Refusing them
//! needs [L]A, a further scalar multiplication
//! (`docs/sc77-the-strict-verify.md`); a lane that adds it flips these
//! rows deliberately.

use std.hex
use std.x.crypto.curve25519

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

// One row: prints `FAIL <row>` and counts 1 when either function
// disagrees with the generator.
fn row(
    name: str,
    pk_hex: str,
    msg_hex: str,
    sig_hex: str,
    want_verify: bool,
    want_strict: bool,
) -> int {
    let pk = bytes_of(pk_hex)
    let msg = bytes_of(msg_hex)
    let sig = bytes_of(sig_hex)
    var fails: int = 0
    if curve25519.verify(pk, msg, sig) != want_verify {
        print("FAIL verify-{name}")
        fails = fails + 1
    }
    if curve25519.verify_strict(pk, msg, sig) != want_strict {
        print("FAIL strict-{name}")
        fails = fails + 1
    }
    fails
}

fn main() -> int {
    var fails: int = 0
    fails = fails +
        row(
            "mixed-a-order2",
            "16a567fe7d4ef5482ab4012c369bf8c5f11e8d0c2559dcda50fde59708f8aee5",
            "6d697865642032",
            "07210416c5bbdbc8864436346b21ff8f1d7d3258c5c61098e2d88575119ea3366531a0134e2fb9ac16dfad071a1c80cdca7b0ea51a3d655a09c50f89a1fd5809",
            true,
            true,
        )
    fails = fails +
        row(
            "mixed-a-order8-26e8x0",
            "3b5b475c4b82dd1572799fc546f4c6c03e478c6654aa4c7f945b347ea32af60d",
            "6d69786564203333",
            "07210416c5bbdbc8864436346b21ff8f1d7d3258c5c61098e2d88575119ea336a1db2edfd1d5cf0487d077ac8a876dbcd0edcb737cf66d360d541389bf55fc0f",
            true,
            true,
        )
    if fails > 0 {
        return 1
    }
    0
}
