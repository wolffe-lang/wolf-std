//! check: run(exit=0)
//! phase: run
//! conforms: std.x.crypto.curve25519, arith.checked
//!
//! The Ed25519 DIFFERENTIAL SMOKE: RFC 8032 §7.1 TEST 1 (empty message)
//! run public + verify on every lane — a scalar multiplication is
//! ~13-40s under lupin 0.1.13 (F-0093), so the full §7.1 set and the
//! Wycheproof suite ride the native lane while this keeps the sign/
//! verify path three-lane. Hex from `vendor/vectors/rfc/rfc8032.txt`.

use std.hex
use std.x.crypto.curve25519

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn main() -> int {
    let sk = bytes_of("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let pk = bytes_of("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
    let sig = bytes_of("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
    assert(curve25519.to_hex(curve25519.public(sk)) == "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", "pk")
    assert(curve25519.verify(pk, List[byte](), sig), "vrf")
    0
}
