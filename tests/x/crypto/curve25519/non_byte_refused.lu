//! check: run(exit=trap(assert))
//! phase: run
//! conforms: std.x.crypto.curve25519, conf.trap.set
//!
//! The 0..255 byte contract (§11's interim, F-0035), held as a trap: an
//! element outside a byte is neither a scalar nor a coordinate, and the
//! ingestion guard rejects it before the ladder. A `List[int]` is the
//! interim byte currency and this is the guard that keeps it honest.

use std.x.crypto.curve25519

fn main() -> int {
    var scalar = List[int]()
    var i: int = 0
    while i < 31 {
        (mut scalar).push(0)
        i = i + 1
    }
    (mut scalar).push(256)
    let u = "a 32-byte curve25519 u-coord!!!!".bytes()
    print("reached the call")
    let out = curve25519.x25519(scalar, u) else List[int]()
    print("unreachable: {out.len}")
    0
}
