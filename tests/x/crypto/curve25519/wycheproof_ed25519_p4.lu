//!
//! Wycheproof v1 Ed25519 verify, part 4 of 4 (31 of the
//! set's 151: 30 valid + 1 invalid): `verify` must answer
//! true for every valid vector and FALSE for every invalid one —
//! the invalid set is the point (wrong lengths, non-canonical
//! encodings, S >= L malleability, swapped/garbage signatures), and
//! the single cofactorless verify with strict S < L decides them
//! all. The interpreter column is `slow` (verify is two scalar
//! mults, ~7-8s under lupin 0.1.13, F-0093); the smoke file keeps
//! the differential column.

use std.hex
use std.x.crypto.curve25519

fn verify_is(pub_hex: str, msg_hex: str, sig_hex: str, want: bool) -> bool {
    let pk = hex.decode(pub_hex) else List[byte]()
    let msg = hex.decode(msg_hex) else List[byte]()
    let sig = hex.decode(sig_hex) else List[byte]()
    curve25519.verify(pk, msg, sig) == want
}

