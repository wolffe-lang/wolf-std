//! `vendor/vectors/README.md`). Do not edit by hand; ci's
//! `gen-vectors --check` holds this file byte-identical to its source.
//!
//! Wycheproof v1 X25519, the SHARED set, part 5 of 13
//! (40 vectors of the set's 487): every `valid` and nonzero
//! `acceptable` vector — the shared secret is asserted byte-for-
//! byte. The `acceptable` twist and non-canonical-public cases are
//! here because RFC 7748 masks the high bit and requires no twist
//! or canonicity rejection, so the ladder's answer is conformant.
//! The interpreter column is `slow` (the sc16 word): each vector
//! is a full ladder (~6.5s under lupin 0.1.13, F-0093's curve
//! makes a 40-call program blow the ceiling), the shared_smoke
//! file keeps the differential column, and the chunk flips back
//! to `run` when a lupin release carries is20.

use std.hex
use std.x.crypto.curve25519

fn shared_matches(priv_hex: str, pub_hex: str, want: str) -> bool {
    let sk = hex.decode(priv_hex) else List[byte]()
    let pk = hex.decode(pub_hex) else List[byte]()
    let out = curve25519.x25519(sk, pk) else List[byte]()
    curve25519.to_hex(out) == want
}

