use std.hex
use std.x.crypto.curve25519

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

// One row: prints `FAIL <row>` and counts 1 when `verify` disagrees.
fn row(name: str, pk_hex: str, msg_hex: str, sig_hex: str, want: bool) -> int {
    if curve25519.verify(bytes_of(pk_hex), bytes_of(msg_hex), bytes_of(sig_hex)) == want {
        return 0
