//! check: run(exit=0)
//! phase: run
//! conforms: std.x.tls.handshake, arith.wrapping
//!
//! RFC 8448 §3 transcript hash (§4.4.1): the running SHA-256 over the
//! exact wire bytes of the handshake messages, in order, each with its
//! 4-byte handshake header (NOT the 5-byte record header). Every
//! checkpoint the trace's key schedule consumes is pinned: the empty
//! transcript (the "derived" context), Transcript-Hash(CH..SH) that
//! feeds the handshake traffic secrets, Transcript-Hash(CH..CertVerify)
//! that the server Finished MACs over, Transcript-Hash(CH..serverFin)
//! that feeds the application secrets, and Transcript-Hash(CH..clientFin)
//! that feeds the resumption secret. Message bytes are the trace's own
//! (asserted in message_bytes.lu); here they drive the transcript.
//!

use std.hex
use std.x.tls.handshake as hs

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn main() -> int {
    let ch = bytes_of("")
    let sh = bytes_of("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")
    let ee = bytes_of("080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000")
    let cert = bytes_of("")
    let cv = bytes_of("0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3")
    let sfin = bytes_of("140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718")
    let cfin = bytes_of("14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61")

    let empty = hs.transcript_new()
    assert(hs.to_hex(hs.transcript_hash(empty)) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "empty transcript")

    var t = hs.transcript_new()
    hs.transcript_add(mut t, ch)
    hs.transcript_add(mut t, sh)
    assert(hs.to_hex(hs.transcript_hash(t)) == "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8", "Transcript-Hash(CH..SH)")

    hs.transcript_add(mut t, ee)
    hs.transcript_add(mut t, cert)
    hs.transcript_add(mut t, cv)
    assert(hs.to_hex(hs.transcript_hash(t)) == "edb7725fa7a3473b031ec8ef65a2485493900138a2b91291407d7951a06110ed", "Transcript-Hash(CH..CertVerify)")

    hs.transcript_add(mut t, sfin)
    assert(hs.to_hex(hs.transcript_hash(t)) == "9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13", "Transcript-Hash(CH..serverFin)")

    hs.transcript_add(mut t, cfin)
    assert(hs.to_hex(hs.transcript_hash(t)) == "209145a96ee8e2a122ff810047cc952684658d6049e86429426db87c54ad143d", "Transcript-Hash(CH..clientFin)")
    0
}
