//! check: run(exit=0)
//! phase: run
//! conforms: std.x.tls.handshake, arith.wrapping
//!
//! RFC 8448 §3 full key schedule (§7.1), end-to-end: the X25519 shared
//! secret from the trace's ephemeral key pairs, then early -> handshake
//! (EC)DHE -> master, then every traffic/exporter/resumption secret,
//! each asserted byte-for-byte. The transcript hashes are computed HERE
//! from the trace's message bytes (the sc21 story: messages ->
//! transcript -> Derive-Secret -> secrets), and the ws05 seam is proven
//! by turning two secrets into sc20 traffic keys/IVs (RFC 8448's
//! AES-128-GCM key length, 16). The X25519 agreement is checked both
//! directions (client priv * server pub == server priv * client pub).
//!

use std.hex
use std.x.tls.handshake as hs
use std.x.tls.record

fn bytes_of(h: str) -> List[int] {
    hex.decode(h) else List[int]()
}

fn main() -> int {
    // (EC)DHE shared secret — both directions reach the trace's IKM.
    let dh_c = hs.ecdhe_shared(bytes_of("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005"), bytes_of("c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f")) else List[int]()
    let dh_s = hs.ecdhe_shared(bytes_of("b1580eeadf6dd589b8ef4f2d5652578cc810e9980191ec8d058308cea216a21e"), bytes_of("99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c")) else List[int]()
    assert(hs.to_hex(dh_c) == "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d", "X25519 shared (client view)")
    assert(hs.to_hex(dh_s) == "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d", "X25519 shared (server view)")

    // Transcript hashes over the real messages.
    var t = hs.transcript_new()
    hs.transcript_add(mut t, bytes_of(""))
    hs.transcript_add(mut t, bytes_of("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304"))
    let th_chsh = hs.transcript_hash(t)
    hs.transcript_add(mut t, bytes_of("080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000"))
    hs.transcript_add(mut t, bytes_of(""))
    hs.transcript_add(mut t, bytes_of("0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3"))
    hs.transcript_add(mut t, bytes_of("140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718"))
    let th_sf = hs.transcript_hash(t)
    hs.transcript_add(mut t, bytes_of("14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61"))
    let th_cf = hs.transcript_hash(t)

    // The schedule.
    let early = hs.early_secret()
    assert(hs.to_hex(early) == "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a", "early secret")
    let hsec = hs.handshake_secret(early, dh_c)
    assert(hs.to_hex(hsec) == "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac", "handshake secret")
    let master = hs.master_secret(hsec)
    assert(hs.to_hex(master) == "18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919", "master secret")

    let chs = hs.client_handshake_traffic(hsec, th_chsh)
    assert(hs.to_hex(chs) == "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21", "c hs traffic")
    let shs = hs.server_handshake_traffic(hsec, th_chsh)
    assert(hs.to_hex(shs) == "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38", "s hs traffic")
    let cap = hs.client_application_traffic(master, th_sf)
    assert(hs.to_hex(cap) == "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5", "c ap traffic")
    let sap = hs.server_application_traffic(master, th_sf)
    assert(hs.to_hex(sap) == "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643", "s ap traffic")
    let exp = hs.exporter_master(master, th_sf)
    assert(hs.to_hex(exp) == "fe22f881176eda18eb8f44529e6792c50c9a3f89452f68d8ae311b4309d3cf50", "exp master")
    let res = hs.resumption_master(master, th_cf)
    assert(hs.to_hex(res) == "7df235f2031d2a051287d02b0241b0bfdaf86cc856231f2d5aba46c434ec196c", "res master")

    // ws05 seam: sc20 turns a traffic secret into an AEAD key/iv.
    assert(record.to_hex(record.traffic_key(shs, 16)) == "3fce516009c21727d0f2e4e86ee403bc", "server hs write key")
    assert(record.to_hex(record.traffic_iv(shs)) == "5d313eb2671276ee13000b30", "server hs write iv")
    assert(record.to_hex(record.traffic_key(cap, 16)) == "17422dda596ed5d9acd890e3c63f5051", "client ap write key")
    assert(record.to_hex(record.traffic_iv(cap)) == "5b78923dee08579033e523d9", "client ap write iv")

    // The FROZEN ws05 seam: a completed handshake packages the negotiated
    // suite + the six secrets into a HandshakeResult ws05 hands to sc20.
    let result = hs.handshake_result(4865, chs, shs, cap, sap, exp, res)
    assert(result.cipher_suite == 4865, "seam: cipher_suite")
    assert(hs.to_hex(result.server_handshake_secret) == "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38", "seam: s hs secret")
    assert(hs.to_hex(result.client_application_secret) == "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5", "seam: c ap secret")
    assert(hs.to_hex(result.resumption_master_secret) == "7df235f2031d2a051287d02b0241b0bfdaf86cc856231f2d5aba46c434ec196c", "seam: res master")
    0
}
