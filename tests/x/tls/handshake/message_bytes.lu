//! check: run(exit=0)
//! phase: run
//! conforms: std.x.tls.handshake
//!
//! RFC 8448 §3 — every handshake message the Simple 1-RTT trace
//! exercises, serialized byte-for-byte from its field values through
//! the message + extension builders (4-byte handshake header
//! included). ClientHello/ServerHello/EncryptedExtensions build every
//! extension; Certificate frames an OPAQUE DER blob (no ASN.1 parse,
//! sc22); CertificateVerify carries the signature (verification sc22);
//! both Finished messages frame the trace's verify_data. The Certificate
//! DER is the trace's own 432 octets, carried verbatim.
//!

use std.hex
use std.x.tls.handshake as hs

fn bytes_of(h: str) -> List[int] {
    hex.decode(h) else List[int]()
}

fn u16s(mut out: List[int], vals: List[int]) {
    for v in vals {
        (mut out).push(v)
    }
}

fn main() -> int {
    // ---- ClientHello ----
    var groups = List[int]()
    u16s(mut groups, seq9(29, 23, 24, 25, 256, 257, 258, 259, 260))
    var schemes = List[int]()
    u16s(mut schemes, seq15(1027, 1283, 1539, 515, 2052, 2053, 2054, 1025, 1281, 1537, 513, 1026, 1282, 1538, 514))
    var modes = List[int]()
    (mut modes).push(1)
    var che = List[int]()
    hs.transcript_add(mut che, hs.ext_server_name("server"))
    hs.transcript_add(mut che, hs.ext_renegotiation_info_empty())
    hs.transcript_add(mut che, hs.ext_supported_groups(groups))
    hs.transcript_add(mut che, hs.ext_session_ticket_empty())
    hs.transcript_add(mut che, hs.ext_key_share_client_x25519(bytes_of("99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c")))
    hs.transcript_add(mut che, hs.ext_supported_versions_client())
    hs.transcript_add(mut che, hs.ext_signature_algorithms(schemes))
    hs.transcript_add(mut che, hs.ext_psk_key_exchange_modes(modes))
    hs.transcript_add(mut che, hs.ext_record_size_limit(16385))
    let ch = hs.client_hello(bytes_of("cb34ecb1e78163ba1c38c6dacb196a6dffa21a8d9912ec18a2ef6283024dece7"), List[int](), bytes_of("130113031302"), che)
    assert(hs.to_hex(ch) == "", "ClientHello bytes")

    // ---- ServerHello ----
    var she = List[int]()
    hs.transcript_add(mut she, hs.ext_key_share_server_x25519(bytes_of("c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f")))
    hs.transcript_add(mut she, hs.ext_supported_versions_server())
    let sh = hs.server_hello(bytes_of("a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e26928"), List[int](), 4865, she)
    assert(hs.to_hex(sh) == "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304", "ServerHello bytes")

    // ---- EncryptedExtensions ----
    var eee = List[int]()
    hs.transcript_add(mut eee, hs.ext_supported_groups(groups))
    hs.transcript_add(mut eee, hs.ext_record_size_limit(16385))
    hs.transcript_add(mut eee, hs.ext_server_name_ack())
    let ee = hs.encrypted_extensions(eee)
    assert(hs.to_hex(ee) == "080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000", "EncryptedExtensions bytes")

    // ---- Certificate (opaque DER carried, not parsed) ----
    let cert = hs.certificate(List[int](), bytes_of(""))
    assert(hs.to_hex(cert) == "", "Certificate bytes")

    // ---- CertificateVerify (signature carried, verify deferred sc22) ----
    let cv = hs.certificate_verify(2052, bytes_of("5a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3"))
    assert(hs.to_hex(cv) == "0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3", "CertificateVerify bytes")

    // ---- Finished, server and client ----
    let sfin = hs.finished_message(bytes_of("9b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718"))
    assert(hs.to_hex(sfin) == "140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718", "server Finished bytes")
    let cfin = hs.finished_message(bytes_of("a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61"))
    assert(hs.to_hex(cfin) == "14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61", "client Finished bytes")
    0
}

fn seq9(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: int) -> List[int] {
    var o = List[int]()
    (mut o).push(a)
    (mut o).push(b)
    (mut o).push(c)
    (mut o).push(d)
    (mut o).push(e)
    (mut o).push(f)
    (mut o).push(g)
    (mut o).push(h)
    (mut o).push(i)
    o
}

fn seq15(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: int, j: int, k: int, l: int, m: int, n: int, p: int) -> List[int] {
    var o = List[int]()
    (mut o).push(a)
    (mut o).push(b)
    (mut o).push(c)
    (mut o).push(d)
    (mut o).push(e)
    (mut o).push(f)
    (mut o).push(g)
    (mut o).push(h)
    (mut o).push(i)
    (mut o).push(j)
    (mut o).push(k)
    (mut o).push(l)
    (mut o).push(m)
    (mut o).push(n)
    (mut o).push(p)
    o
}
