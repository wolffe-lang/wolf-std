//! check: run(exit=trap(assert))
//! phase: run
//! conforms: std.x.tls.handshake, conf.trap.set
//!
//! The 0..255 element contract (§11's interim, F-0035), held as a trap
//! and shared verbatim with sha2/chacha20/record: a byte-sequence element
//! outside 0..255 is a caller-contract violation. Framing a
//! CertificateVerify signature that carries the never-byte 256 traps at
//! ingestion, before any serialization, so every lane reaches the trap.
//!

use std.x.tls.handshake as hs

fn main() -> int {
    var bad = List[int]()
    (mut bad).push(256)
    let _ = hs.certificate_verify(2052, bad)
    0
}
