//! check: run(exit=0, stdout="rsa_pss_rsae_sha256: ok\nrsa_pss_rsae_sha384: ok\nrsa_pss_rsae_sha512: ok\necdsa_secp384r1_sha384: ok\nsha256 signature named sha384: bad_signature\nflipped rsa_pss byte: bad_signature\nan RSA key under an ECDSA scheme: bad_signature\na P-384 key under ecdsa_secp256r1_sha256: bad_signature\nan ECDSA key under rsa_pss: bad_signature\na 1024-bit RSA key: weak_key\nrsa_pkcs1_sha256 (0x0401): unsupported_alg\nrsa_pss_pss_sha256 (0x0809): unsupported_alg")
//! phase: run
//! conforms: std.x.tls.client, std.x.tls.cert, std.x.crypto.rsa, std.x.crypto.p384
//!
//! sc79: CertificateVerify (RFC 8446 §4.4.3) under the schemes this
//! client now verifies — rsa_pss_rsae_sha256/384/512 (RSASSA-PSS, MGF1
//! over the same hash, salt = digest length, §4.2.3) and
//! ecdsa_secp384r1_sha384 — against the leaf keys of the pinned corpus.
//! The signatures are the OpenSSL binary's over §4.4.3's content with
//! the 32 bytes 0x00..0x1f as the transcript hash
//! (`vendor/vectors/pki/sc79/cv_*.sig`). Then every refusal by name:
//! a scheme that does not match the signature or the key, a weak RSA
//! key, and the schemes this client does not verify. NATIVE-ONLY.

use std.hex
use std.x.tls.cert
use std.x.tls.client

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn th() -> List[byte] {
    var out = List[byte]()
    var i: int = 0
    while i < 32 {
        (mut out).push(i as byte)
        i = i + 1
    }
    out
}

fn word(alg: str, key: List[byte], scheme: int, sig: List[byte]) -> str {
    let _ok = client.verify_certificate_verify(alg, key, scheme, sig, th()) else |e| match e {
        unsupported_alg => {
            return "unsupported_alg"
        },
        bad_signature => {
            return "bad_signature"
        },
        weak_key => {
            return "weak_key"
        },
    }
    "ok"
}

fn main() -> !int {
    let rsa_leaf = cert.parse(
        bytes_of(
            "",
        ),
    )?
    let p384_leaf = cert.parse(
        bytes_of(
            "",
        ),
    )?
    let weak_leaf = cert.parse(
        bytes_of(
            "",
        ),
    )?
    let s256 = bytes_of(
        "",
    )
    let s384 = bytes_of(
        "",
    )
    let s512 = bytes_of(
        "",
    )
    let ec = bytes_of(
        "3064023035ea8e6f6a417d56df0200f6b4bfcdff3c4443a0ae2d18bef65c53fda19eb700af747fdcc7947beba621ba32460d272402304cb0d80c49b353a878a22ed94f8ecde509b73e2683c09762399dea5f294fb4c7676a87772a3ab7b08a96b98e93146cc5",
    )
    let ra = rsa_leaf.spki_alg
    let rk = rsa_leaf.spki_key
    let ea = p384_leaf.spki_alg
    let ek = p384_leaf.spki_key
    print("rsa_pss_rsae_sha256: {word(ra, rk, client.scheme_rsa_pss_sha256(), s256)}")
    print("rsa_pss_rsae_sha384: {word(ra, rk, client.scheme_rsa_pss_sha384(), s384)}")
    print("rsa_pss_rsae_sha512: {word(ra, rk, client.scheme_rsa_pss_sha512(), s512)}")
    print("ecdsa_secp384r1_sha384: {word(ea, ek, client.scheme_ecdsa_p384_sha384(), ec)}")
    print("sha256 signature named sha384: {word(ra, rk, client.scheme_rsa_pss_sha384(), s256)}")
    let flipped = bytes_of(
        "",
    )
    print("flipped rsa_pss byte: {word(ra, rk, client.scheme_rsa_pss_sha256(), flipped)}")
    print("an RSA key under an ECDSA scheme: {word(ra, rk, client.scheme_ecdsa_p384_sha384(), ec)}")
    print(
        "a P-384 key under ecdsa_secp256r1_sha256: {word(ea, ek, client.scheme_ecdsa_p256_sha256(), ec)}",
    )
    print("an ECDSA key under rsa_pss: {word(ea, ek, client.scheme_rsa_pss_sha256(), s256)}")
    print(
        "a 1024-bit RSA key: {word(weak_leaf.spki_alg, weak_leaf.spki_key, client.scheme_rsa_pss_sha256(), s256)}",
    )
    print("rsa_pkcs1_sha256 (0x0401): {word(ra, rk, 1025, s256)}")
    print("rsa_pss_pss_sha256 (0x0809): {word(ra, rk, 2057, s256)}")
    0
}
