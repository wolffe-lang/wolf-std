//! check: run(exit=trap(assert))
//! phase: run
//! conforms: std.x.tls.record, conf.trap.set
//!
//! The IV-length contract, held as a trap: the TLS 1.3 per-record nonce
//! (§5.3) is built over the 12-byte static write IV, and the IV length
//! is the CALLER's contract, not data. An 8-byte IV is a contract
//! violation the guard catches before any XOR, so every lane reaches the
//! trap.

use std.hex
use std.x.tls.record

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn main() -> int {
    let iv = bytes_of("5d313eb267127600")
    print("reached the call")
    let nonce = record.record_nonce(iv, 0)
    print("unreachable: {nonce.len}")
    0
}
