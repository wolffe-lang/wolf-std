//! check: run(exit=trap(assert))
//! phase: run
//! conforms: std.x.tls.record, conf.trap.set
//!
//! The 0..255 element contract (§11's interim, F-0035), held as a trap:
//! a byte sequence element outside 0..255 is a caller-contract
//! violation, shared verbatim with sha2/chacha20. Sealing a content list
//! carrying the never-byte 256 traps at ingestion, before any AEAD
//! arithmetic, so every lane reaches the trap.

use std.hex
use std.x.tls.record

fn bytes_of(h: str) -> List[int] {
    hex.decode(h) else List[int]()
}

fn main() -> int {
    let key = bytes_of("ac70443f7fe3bdaf568b1dcdb0a7f3fea098bca189c3455ba41fcd9d488348a4")
    let iv = bytes_of("5d313eb2671276ee13000b30")
    var content = List[int]()
    (mut content).push(256)
    print("reached the call")
    let rec = record.seal(key, iv, 0, 22, content, 0)
    print("unreachable: {rec.len}")
    0
}
