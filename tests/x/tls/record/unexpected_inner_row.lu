//! check: run(exit=1, stdout="witness: fallback empty\nerror: unexpected")
//! phase: run
//! conforms: std.x.tls.record, err.row, err.propagate, err.else
//!
//! THE NO-CONTENT-TYPE WITNESS (§5.4): a deprotected inner plaintext
//! that is all zeros has no non-zero content-type octet and is a
//! malformed record (§5.4 mandates an `unexpected_message` alert). Here
//! the record is well-formed AEAD — sealed by this very module with a
//! zero content type and empty content, so the inner is the single octet
//! `00` — and `open` authenticates it, finds no content-type, and raises
//! `unexpected`. The tag PASSES (this is not a `tag` failure); the
//! plaintext is structurally invalid. The `else` proves the fallback is
//! empty and the `?` rides `unexpected` out of `main`.

use std.hex
use std.x.tls.record

fn bytes_of(h: str) -> List[int] {
    hex.decode(h) else List[int]()
}

fn main() -> !int {
    let key = bytes_of("ac70443f7fe3bdaf568b1dcdb0a7f3fea098bca189c3455ba41fcd9d488348a4")
    let iv = bytes_of("5d313eb2671276ee13000b30")
    // Seal an inner of a single zero octet: content type 0, no content,
    // no padding — a well-authenticated but content-type-less record.
    let rec = record.seal(key, iv, 0, 0, List[int](), 0)
    let hush = record.open(key, iv, 0, rec) else List[int]()
    assert(hush.len == 0, "no-content-type record yields zero plaintext")
    print("witness: fallback empty")
    let never = record.open(key, iv, 0, rec)?
    print("unreachable: {never.len}")
    0
}
