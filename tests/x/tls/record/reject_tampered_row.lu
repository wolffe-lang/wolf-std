//! check: run(exit=1, stdout="witness: fallback empty\nerror: tag")
//! phase: run
//! conforms: std.x.tls.record, err.row, err.propagate, err.else
//!
//! THE TAMPERED-RECORD WITNESS (the record layer's reject discipline,
//! §5.2 + sc17's verify-before-expose): a real TLS 1.3 record (RFC
//! 8448's server EncryptedExtensions, sealed under a ChaCha20-Poly1305
//! key derived from the trace's server-handshake-traffic secret) with
//! ONE bit of the last tag byte flipped (`38` -> `39`). `open` must
//! answer the `tag` row with ZERO plaintext escaping. Two halves, the
//! sc07 row-test shape: an `else` proves the miss path is taken and the
//! fallback the caller sees is EMPTY (open verifies the tag before any
//! decryption — no plaintext is ever computed on the reject path), and a
//! final `?` rides the tag out of `main` (`error: tag`, exit 1). The
//! clean record is `chacha_records.lu`'s first fixture; only the last
//! byte differs here.

use std.hex
use std.x.tls.record

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn main() -> !int {
    let key = bytes_of("ac70443f7fe3bdaf568b1dcdb0a7f3fea098bca189c3455ba41fcd9d488348a4")
    let iv = bytes_of("5d313eb2671276ee13000b30")
    let forged = bytes_of(
        "17030300395873757403ed97881d323c4c60ab52fbbd84c6326f776d5e07041bbcee731e6fa17387310108168b8a72aec407a10bb860f502931681eee139",
    )
    let hush = record.open(key, iv, 0, forged) else List[byte]()
    assert(hush.len == 0, "tampered record yields zero plaintext")
    print("witness: fallback empty")
    let never = record.open(key, iv, 0, forged)?
    print("unreachable: {never.len}")
    0
}
