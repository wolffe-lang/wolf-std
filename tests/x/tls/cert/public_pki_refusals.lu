//! check: run(exit=0, stdout="weak leaf key: weak_key\nweak issuer key: weak_key\nclientAuth-only leaf: bad_usage\nleaf keyUsage without digitalSignature: bad_usage\nemailProtection-only intermediate: bad_usage\nname constraints: name_constraints\nintermediate not a CA: not_ca\nroot pathLen 0 over an intermediate: not_ca\nsha1WithRSAEncryption: unsupported_alg\nP-521: unsupported_alg\nEd448: unsupported_alg\nrsa bad signature: bad_signature\npss bad signature: bad_signature\np384 bad signature: bad_signature\nrsa expired: expired\nrsa not yet valid: not_yet_valid\nrsa wrong name: name_mismatch\nwildcard, two labels deep: name_mismatch\nwildcard, the bare parent: name_mismatch\nwildcard leaf, one label: ok exact.wolf.test\nwildcard leaf, its exact name: ok exact.wolf.test\nrsa wrong root: issuer_mismatch")
//! phase: run
//! conforms: std.x.tls.cert
//!
//! sc79: every refusal of the public-PKI profile by name, over the
//! pinned corpus (`vendor/vectors/pki/sc79/README.md` names each
//! certificate's defect). The sc22 chain rows — bad signature, expired,
//! not yet valid, not a CA, wrong name, wrong anchor — extended to RSA,
//! RSA-PSS and P-384, plus the three new refusals: `weak_key` (an RSA
//! key under 2048 bits, at the leaf and at an issuer), `bad_usage` (the
//! leaf's keyUsage or extendedKeyUsage, an intermediate's
//! extendedKeyUsage), `name_constraints`; and `unsupported_alg` for
//! SHA-1, P-521 and Ed448. NATIVE-ONLY (RSA and P-384 verifications).

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn cat(a: List[byte], b: List[byte]) -> List[byte] {
    var out = copy a
    for v in b {
        (mut out).push(v)
    }
    out
}

fn word(chain: List[byte], host: str, roots: List[byte], now: int) -> str {
    let leaf = cert.validate_path(chain, host, roots, now) else |e| match e {
        der => {
            return "der"
        },
        unsupported_alg => {
            return "unsupported_alg"
        },
        bad_signature => {
            return "bad_signature"
        },
        expired => {
            return "expired"
        },
        not_yet_valid => {
            return "not_yet_valid"
        },
        name_mismatch => {
            return "name_mismatch"
        },
        not_ca => {
            return "not_ca"
        },
        issuer_mismatch => {
            return "issuer_mismatch"
        },
        unknown_critical => {
            return "unknown_critical"
        },
        weak_key => {
            return "weak_key"
        },
        bad_usage => {
            return "bad_usage"
        },
        name_constraints => {
            return "name_constraints"
        },
    }
    "ok {leaf.subject_cn}"
}

fn sig_word(child: List[byte]) -> str {
    let c = cert.parse(child) else |_| {
        return "der"
    }
    let _r = cert.verify_signed_by(c, c) else |e| match e {
        der => {
            return "der"
        },
        unsupported_alg => {
            return "unsupported_alg"
        },
        bad_signature => {
            return "bad_signature"
        },
        weak_key => {
            return "weak_key"
        },
    }
    "ok"
}

fn rsa_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn rsa_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn rsa_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn rsa1024_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn rsa1024_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn weakiss_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn client_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn kunosig_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn email_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn email_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn nc_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn nc_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn nonca_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn nonca_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn pl0_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn pl0_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn pl0_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn sha1_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p521_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn ed448_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn pss_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn pss_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p384_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p384_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p384_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn wild_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn main() -> int {
    let now = cert.timestamp(2027, 6, 1, 0, 0, 0)
    let ri = rsa_int()
    print("weak leaf key: {word(cat(rsa1024_leaf(), ri), "localhost", rsa_root(), now)}")
    print(
        "weak issuer key: {word(cat(weakiss_leaf(), rsa1024_int()), "localhost", rsa_root(), now)}",
    )
    print("clientAuth-only leaf: {word(cat(client_leaf(), ri), "localhost", rsa_root(), now)}")
    print(
        "leaf keyUsage without digitalSignature: {word(cat(kunosig_leaf(), ri), "localhost", rsa_root(), now)}",
    )
    print(
        "emailProtection-only intermediate: {word(cat(email_leaf(), email_int()), "localhost", rsa_root(), now)}",
    )
    print("name constraints: {word(cat(nc_leaf(), nc_int()), "localhost", rsa_root(), now)}")
    print(
        "intermediate not a CA: {word(cat(nonca_leaf(), nonca_int()), "localhost", rsa_root(), now)}",
    )
    print(
        "root pathLen 0 over an intermediate: {word(cat(pl0_leaf(), pl0_int()), "localhost", pl0_root(), now)}",
    )
    print("sha1WithRSAEncryption: {word(cat(sha1_leaf(), ri), "localhost", rsa_root(), now)}")
    print("P-521: {sig_word(p521_root())}")
    print("Ed448: {sig_word(ed448_root())}")
    print(
        "rsa bad signature: {word(cat(bytes_of(""), ri), "localhost", rsa_root(), now)}",
    )
    print(
        "pss bad signature: {word(cat(bytes_of(""), pss_int()), "localhost", rsa_root(), now)}",
    )
    print(
        "p384 bad signature: {word(cat(bytes_of(""), p384_int()), "localhost", p384_root(), now)}",
    )
    let chain = cat(rsa_leaf(), ri)
    print(
        "rsa expired: {word(chain, "localhost", rsa_root(), cert.timestamp(2037, 1, 1, 0, 0, 0))}",
    )
    print(
        "rsa not yet valid: {word(chain, "localhost", rsa_root(), cert.timestamp(2026, 1, 1, 0, 0, 0))}",
    )
    print("rsa wrong name: {word(chain, "example.com", rsa_root(), now)}")
    print("wildcard, two labels deep: {word(chain, "a.b.wolf.test", rsa_root(), now)}")
    print("wildcard, the bare parent: {word(chain, "wolf.test", rsa_root(), now)}")
    print(
        "wildcard leaf, one label: {word(cat(wild_leaf(), ri), "www.wild.wolf.test", rsa_root(), now)}",
    )
    print(
        "wildcard leaf, its exact name: {word(cat(wild_leaf(), ri), "exact.wolf.test", rsa_root(), now)}",
    )
    print("rsa wrong root: {word(chain, "localhost", p384_root(), now)}")
    0
}
