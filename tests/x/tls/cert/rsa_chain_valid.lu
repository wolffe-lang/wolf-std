//! check: run(exit=0, stdout="rsa, localhost: ok localhost\nrsa, a.wolf.test (wildcard): ok localhost\nrsa, one-anchor seam: ok localhost\nrsa, an unused certificate in the list: ok localhost\npss: ok localhost")
//! phase: run
//! conforms: std.x.tls.cert, std.x.crypto.rsa
//!
//! sc79's RSA paths validate. The RSA chain: an RSA-4096 root, an
//! RSA-3072 intermediate under sha384WithRSAEncryption, an RSA-2048 leaf
//! under sha256WithRSAEncryption (`vendor/vectors/pki/sc79`, built by
//! the pinned OpenSSL binary, which verifies the same chain). The leaf's
//! SAN carries `DNS:*.wolf.test`, matched under RFC 9525. The RSA-PSS
//! chain: RSASSA-PSS signatures with SHA-256 / salt 32 and SHA-384 /
//! salt 48, their parameters read from each certificate (RFC 4055).
//! NATIVE-ONLY: each validation is two RSA verifications.

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn cat(a: List[byte], b: List[byte]) -> List[byte] {
    var out = copy a
    for v in b {
        (mut out).push(v)
    }
    out
}

fn word(chain: List[byte], host: str, roots: List[byte], now: int) -> str {
    let leaf = cert.validate_path(chain, host, roots, now) else |e| match e {
        der => {
            return "der"
        },
        unsupported_alg => {
            return "unsupported_alg"
        },
        bad_signature => {
            return "bad_signature"
        },
        expired => {
            return "expired"
        },
        not_yet_valid => {
            return "not_yet_valid"
        },
        name_mismatch => {
            return "name_mismatch"
        },
        not_ca => {
            return "not_ca"
        },
        issuer_mismatch => {
            return "issuer_mismatch"
        },
        unknown_critical => {
            return "unknown_critical"
        },
        weak_key => {
            return "weak_key"
        },
        bad_usage => {
            return "bad_usage"
        },
        name_constraints => {
            return "name_constraints"
        },
    }
    "ok {leaf.subject_cn}"
}

fn rsa_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn rsa_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn rsa_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn pss_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn pss_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p384_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn main() -> int {
    let now = cert.timestamp(2027, 6, 1, 0, 0, 0)
    let chain = cat(rsa_leaf(), rsa_int())
    print("rsa, localhost: {word(chain, "localhost", rsa_root(), now)}")
    print("rsa, a.wolf.test (wildcard): {word(chain, "a.wolf.test", rsa_root(), now)}")
    let seam = cert.validate_chain(chain, "localhost", rsa_root(), now) else |_| {
        print("FAIL rsa-validate-chain")
        return 1
    }
    print("rsa, one-anchor seam: ok {seam.subject_cn}")
    let extra = cat(cat(rsa_leaf(), p384_int()), rsa_int())
    print("rsa, an unused certificate in the list: {word(extra, "localhost", rsa_root(), now)}")
    print("pss: {word(cat(pss_leaf(), pss_int()), "localhost", rsa_root(), now)}")
    0
}
