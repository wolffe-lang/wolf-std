//! check: run(exit=1, stdout="witness: truncated certificate rejected\nerror: der")
//! phase: run
//! conforms: std.x.tls.cert, err.row, err.propagate, err.else
//!
//! The `der` rejection ridden out of main — the toolchain naming the
//! tag (the strongest row witness this rig has): a truncated leaf
//! first proves the miss path through an else-handler, then propagates
//! `error: der` into the record. RFC 5280 s4.1 / X.690 s8.1.

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[int] {
    hex.decode(h) else List[int]()
}

fn rejects(b: List[int]) -> bool {
    let c = cert.parse(b) else |_| {
        return true
    }
    c.version < 0
}

fn main() -> !int {
    let leaf = bytes_of(
        "",
    )
    var trunc = List[int]()
    var i = 0
    for v in leaf {
        if i < leaf.len - 10 {
            (mut trunc).push(v)
        }
        i = i + 1
    }
    assert(rejects(trunc), "truncated cert must reject")
    print("witness: truncated certificate rejected")
    let never = cert.parse(trunc)?
    print("unreachable: {never.version}")
    0
}
