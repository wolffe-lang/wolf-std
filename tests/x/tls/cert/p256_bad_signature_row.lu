//! check: run(exit=1, stdout="witness: flipped signature byte fails P-256 verify\nerror: bad_signature")
//! phase: run
//! conforms: std.x.tls.cert, err.row, err.propagate, err.else, std.x.crypto.p256
//!
//! BAD P-256 SIGNATURE, by name: the openssl ECDSA-P256 cert with its
//! LAST signature byte flipped — the DER still parses (the mutation is
//! inside the signatureValue BIT STRING content), every structural
//! check passes, and sc23's `p256.verify_der` answers false, so the
//! chain rejects `bad_signature` (NOT `unsupported_alg` — the algorithm
//! IS supported now; the signature is wrong). NATIVE-ONLY (two P-256
//! ladders, past the non-native step budgets).

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[int] {
    hex.decode(h) else List[int]()
}

fn flip_last(bs: List[int]) -> List[int] {
    var out = List[int]()
    let n = bs.len
    var i = 0
    for v in bs {
        if i == n - 1 {
            (mut out).push((v + 1) % 256)
        } else {
            (mut out).push(v)
        }
        i = i + 1
    }
    out
}

fn rejects(chain: List[int], host: str, anchor: List[int], now: int) -> bool {
    let c = cert.validate_chain(chain, host, anchor, now) else |_| {
        return true
    }
    c.version < 0
}

fn main() -> !int {
    let ec = bytes_of(
        "",
    )
    let bad = flip_last(ec)
    let host = "ecdsa.wolf.example"
    let now = cert.timestamp(2026, 10, 1, 0, 0, 0)
    assert(rejects(bad, host, bad, now), "the flipped-signature chain must reject")
    print("witness: flipped signature byte fails P-256 verify")
    let never = cert.validate_chain(bad, host, bad, now)?
    print("unreachable: {never.version}")
    0
}
