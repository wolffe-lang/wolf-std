//! check: run(exit=0, stdout="rsa in the store: ok localhost\np384 in the store: ok localhost\ned25519 in the store: ok localhost\ncross-sign stepped past: ok localhost\ncross-sign to its own root: ok localhost\ncross-sign alone: issuer_mismatch\nan unparseable root skipped: ok localhost\nempty store: issuer_mismatch\nmalformed store: der")
//! phase: run
//! conforms: std.x.tls.cert
//!
//! sc79's path building against a ROOT SET: the store is concatenated
//! DER (an Ed25519, two RSA, a P-384, a P-521 and an Ed448 root), and
//! each chain finds its own root. The cross-sign rows: `rsa_int_x`
//! carries `rsa_int`'s subject and key under another root, so with only
//! `rsa_root` trusted the list `rsa_leaf, rsa_int_x, rsa_int` needs the
//! search to back out of `rsa_int_x` and take `rsa_int`. A store entry
//! this profile cannot parse is skipped; a store whose framing is broken
//! is `der`. NATIVE-ONLY: the paths carry RSA and P-384 verifications.

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn cat(a: List[byte], b: List[byte]) -> List[byte] {
    var out = copy a
    for v in b {
        (mut out).push(v)
    }
    out
}

fn word(chain: List[byte], host: str, roots: List[byte], now: int) -> str {
    let leaf = cert.validate_path(chain, host, roots, now) else |e| match e {
        der => {
            return "der"
        },
        unsupported_alg => {
            return "unsupported_alg"
        },
        bad_signature => {
            return "bad_signature"
        },
        expired => {
            return "expired"
        },
        not_yet_valid => {
            return "not_yet_valid"
        },
        name_mismatch => {
            return "name_mismatch"
        },
        not_ca => {
            return "not_ca"
        },
        issuer_mismatch => {
            return "issuer_mismatch"
        },
        unknown_critical => {
            return "unknown_critical"
        },
        weak_key => {
            return "weak_key"
        },
        bad_usage => {
            return "bad_usage"
        },
        name_constraints => {
            return "name_constraints"
        },
    }
    "ok {leaf.subject_cn}"
}

fn rsa_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn rsa_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn rsa_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn rsa_int_x() -> List[byte] {
    bytes_of(
        "",
    )
}

fn other_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p384_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p384_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p384_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn ed_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn ed_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p521_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn ed448_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn main() -> int {
    let now = cert.timestamp(2027, 6, 1, 0, 0, 0)
    let store = cat(
        cat(cat(cat(cat(ed_root(), other_root()), p384_root()), rsa_root()), p521_root()),
        ed448_root(),
    )
    print("rsa in the store: {word(cat(rsa_leaf(), rsa_int()), "localhost", store, now)}")
    print("p384 in the store: {word(cat(p384_leaf(), p384_int()), "localhost", store, now)}")
    print("ed25519 in the store: {word(ed_leaf(), "localhost", store, now)}")
    let crossed = cat(cat(rsa_leaf(), rsa_int_x()), rsa_int())
    print("cross-sign stepped past: {word(crossed, "localhost", rsa_root(), now)}")
    print(
        "cross-sign to its own root: {word(cat(rsa_leaf(), rsa_int_x()), "localhost", other_root(), now)}",
    )
    print("cross-sign alone: {word(cat(rsa_leaf(), rsa_int_x()), "localhost", rsa_root(), now)}")
    let junk = bytes_of("3003020100")
    print(
        "an unparseable root skipped: {word(cat(rsa_leaf(), rsa_int()), "localhost", cat(junk, rsa_root()), now)}",
    )
    print("empty store: {word(cat(rsa_leaf(), rsa_int()), "localhost", List[byte](), now)}")
    print("malformed store: {word(cat(rsa_leaf(), rsa_int()), "localhost", bytes_of("30"), now)}")
    0
}
