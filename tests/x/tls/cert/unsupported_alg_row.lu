//! check: run(exit=1, stdout="witness: rsa and ecdsa parse structurally\nwitness: rsa validation names the unsupported algorithm\nerror: unsupported_alg")
//! phase: run
//! conforms: std.x.tls.cert, err.row, err.propagate, err.else
//!
//! THE PARSE-BUT-NAMED-UNSUPPORTED SPLIT, at the sc23 pin (RSA is the
//! last `unsupported_alg` rung): real-world-shaped RSA-2048/
//! sha256WithRSAEncryption and ECDSA-P256/ecdsa-with-SHA256
//! certificates (openssl-generated, vendor/vectors/pki) both PARSE
//! structurally — version, serial, DNs, validity, SPKI, SAN, the
//! multi-byte RSA modulus, the NULL RSA parameters and the named-curve
//! EC parameters all walk the same hardened decoder. RSA chain
//! validation answers the NAMED `unsupported_alg` rejection, NEVER a
//! silent accept (RSA has no crypto rung yet). ECDSA-P256 NOW VALIDATES
//! (sc23's p256.verify_der) — witnessed in `p256_chain_valid.lu` and
//! `p256_bad_signature_row.lu`; here it is only shown to PARSE. RSA's
//! rejection rides out of main so the record names it. Three-lane: RSA
//! validation is `unsupported_alg` before any scalar multiplication.

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn rejects(chain: List[byte], host: str, anchor: List[byte], now: int) -> bool {
    let c = cert.validate_chain(chain, host, anchor, now) else |_| {
        return true
    }
    c.version < 0
}

fn main() -> !int {
    let rsa = bytes_of(
        "",
    )
    let ecdsa = bytes_of(
        "",
    )
    let now = cert.timestamp(2026, 10, 1, 0, 0, 0)
    // Each parse is destructured where it is born (sc30,
    // [gram.pat.struct]), fields renamed apart since both certificates
    // share main's scope; `..` leaves what this witness does not pin.
    let cert.Cert { subject_cn: rsa_cn, sig_alg: rsa_sig_alg, spki_alg: rsa_spki_alg, has_san: rsa_has_san, .. } = cert.parse(rsa) else |_| {
        return 2
    }
    assert(rsa_cn == "rsa.wolf.example", "rsa subject CN parsed")
    assert(cert.alg_name(rsa_sig_alg) == "rsa", "rsa signature algorithm classified")
    assert(cert.alg_name(rsa_spki_alg) == "rsa", "rsa SPKI classified")
    assert(rsa_has_san, "rsa SAN parsed")
    let cert.Cert { subject_cn: ec_cn, sig_alg: ec_sig_alg, spki_alg: ec_spki_alg, .. } = cert.parse(ecdsa) else |_| {
        return 2
    }
    assert(ec_cn == "ecdsa.wolf.example", "ecdsa subject CN parsed")
    assert(cert.alg_name(ec_sig_alg) == "ecdsa", "ecdsa signature algorithm classified")
    assert(cert.alg_name(ec_spki_alg) == "ecdsa", "ecdsa SPKI classified")
    print("witness: rsa and ecdsa parse structurally")
    assert(rejects(rsa, "rsa.wolf.example", rsa, now), "rsa chain must name unsupported_alg")
    print("witness: rsa validation names the unsupported algorithm")
    let never = cert.validate_chain(rsa, "rsa.wolf.example", rsa, now)?
    print("unreachable: {never.version}")
    0
}
