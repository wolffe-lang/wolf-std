//! check: run(exit=1, stdout="witness: leaf is expired at the supplied now\nerror: expired")
//! phase: run
//! conforms: std.x.tls.cert, err.row, err.propagate, err.else
//!
//! EXPIRED, by name (RFC 5280 s4.1.2.5 / s6.1.3(a)(2)): the same valid
//! pinned chain judged at a supplied `now` PAST the leaf's notAfter
//! (2027-01-01) answers the `expired` row — deterministic time, no
//! wall clock, no signature ever verified (the date check runs before
//! any scalar multiplication). The else-half proves the miss path,
//! then the tag rides out of main for the record to name.

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn rejects(chain: List[byte], host: str, anchor: List[byte], now: int) -> bool {
    let c = cert.validate_chain(chain, host, anchor, now) else |_| {
        return true
    }
    c.version < 0
}

fn main() -> !int {
    let chain = bytes_of(
        "",
    )
    let host = "wolf.example"
    let anchor = bytes_of(
        "",
    )
    let now = cert.timestamp(2028, 1, 1, 0, 0, 0)
    assert(rejects(chain, host, anchor, now), "the chain must reject")
    print("witness: leaf is expired at the supplied now")
    let never = cert.validate_chain(chain, host, anchor, now)?
    print("unreachable: {never.version}")
    0
}
