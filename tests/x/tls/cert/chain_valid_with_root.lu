//! check: run(exit=0)
//! phase: run
//! conforms: std.x.tls.cert, std.x.crypto.curve25519
//!
//! The chain-includes-the-root shape (TLS servers often send it):
//! chain = leaf || root as CONCATENATED DER, walked by cert_end's
//! boundary parsing, validates against the same root anchor — the
//! self-signed tail chains to the anchor by name and verifies under
//! its own key, and the root's pathLen 1 admits the walk (below = 1
//! <= 1). Two Ed25519 verifications.

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[int] {
    hex.decode(h) else List[int]()
}

fn main() -> int {
    let root = bytes_of(
        "",
    )
    let leaf_der = bytes_of(
        "",
    )
    var chain = List[int]()
    for b in leaf_der {
        (mut chain).push(b)
    }
    for b in root {
        (mut chain).push(b)
    }
    let boundary = cert.cert_end(chain, 0) else 0 - 1
    assert(boundary == leaf_der.len, "cert_end finds the leaf boundary")
    let now = cert.timestamp(2026, 8, 27, 12, 0, 0)
    let leaf = cert.validate_chain(chain, "wolf.example", root, now) else |_| {
        return 1
    }
    assert(leaf.subject_cn == "wolf.example", "leaf returned from the two-cert chain")
    0
}
