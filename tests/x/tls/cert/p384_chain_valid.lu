//! check: run(exit=0, stdout="p384, ecdsa-with-SHA384: ok localhost\np256 leaf under p384, ecdsa-with-SHA256: ok localhost\np384, ecdsa-with-SHA512: ok localhost")
//! phase: run
//! conforms: std.x.tls.cert, std.x.crypto.p384, std.x.crypto.p256
//!
//! sc79's ECDSA P-384 paths validate: a P-384 root, a P-384
//! intermediate, and three leaves under it — a P-384 leaf under
//! ecdsa-with-SHA384, a P-256 leaf under ecdsa-with-SHA256 (a P-384
//! issuer key over a shorter digest, FIPS 186-5's bits2int), and a P-384
//! leaf under ecdsa-with-SHA512 (the digest truncated to 384 bits).
//! NATIVE-ONLY: each validation is two P-384 verifications.

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn cat(a: List[byte], b: List[byte]) -> List[byte] {
    var out = copy a
    for v in b {
        (mut out).push(v)
    }
    out
}

fn word(chain: List[byte], host: str, roots: List[byte], now: int) -> str {
    let leaf = cert.validate_path(chain, host, roots, now) else |e| match e {
        der => {
            return "der"
        },
        unsupported_alg => {
            return "unsupported_alg"
        },
        bad_signature => {
            return "bad_signature"
        },
        expired => {
            return "expired"
        },
        not_yet_valid => {
            return "not_yet_valid"
        },
        name_mismatch => {
            return "name_mismatch"
        },
        not_ca => {
            return "not_ca"
        },
        issuer_mismatch => {
            return "issuer_mismatch"
        },
        unknown_critical => {
            return "unknown_critical"
        },
        weak_key => {
            return "weak_key"
        },
        bad_usage => {
            return "bad_usage"
        },
        name_constraints => {
            return "name_constraints"
        },
    }
    "ok {leaf.subject_cn}"
}

fn p384_root() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p384_int() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p384_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn p256_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn ec512_leaf() -> List[byte] {
    bytes_of(
        "",
    )
}

fn main() -> int {
    let now = cert.timestamp(2027, 6, 1, 0, 0, 0)
    print(
        "p384, ecdsa-with-SHA384: {word(cat(p384_leaf(), p384_int()), "localhost", p384_root(), now)}",
    )
    print(
        "p256 leaf under p384, ecdsa-with-SHA256: {word(cat(p256_leaf(), p384_int()), "localhost", p384_root(), now)}",
    )
    print(
        "p384, ecdsa-with-SHA512: {word(cat(ec512_leaf(), p384_int()), "localhost", p384_root(), now)}",
    )
    0
}
