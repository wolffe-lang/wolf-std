//! check: run(exit=0, stdout="rejected: bad_gentime_pre2050\nrejected: bad_utctime_no_seconds\nrejected: bad_time_month_13\nrejected: bad_version_v2\nrejected: bad_negative_serial\nrejected: bad_nonminimal_serial\nrejected: bad_nonminimal_length\nrejected: bad_boolean_01\nrejected: bad_critical_false_encoded\nrejected: bad_alg_mismatch\nrejected: bad_ed25519_params\nrejected: bad_sig_unused_bits\nrejected: bad_duplicate_ext\nrejected: bad_empty_san\nrejected: bad_unsorted_set\nrejected: bad_unique_id\nrejected: bad_oid_padded_arc\nrejected: bad_pathlen_without_ca\nconformance: 18 clauses, 18 named rejections")
//! phase: run
//! conforms: std.x.tls.cert, err.row, err.else
//!
//! THE MALFORMED-ENCODING CONFORMANCE SUITE (the sprint's flagship):
//! eighteen authored certificates, each violating exactly ONE X.690 /
//! RFC 5280 clause (built by vendor/vectors/pki/gen_pki.py, the clause
//! beside each variant there and here), and every one must be a CLEAN
//! NAMED `der` rejection from parse — no crash, no trap, no
//! out-of-bounds read (a server cannot abort on a bad input; wolf's
//! checked arithmetic makes an overrun a trap, and the decoder's job
//! is to REJECT first). The clause per variant:
//! - bad_gentime_pre2050: RFC 5280 s4.1.2.5: dates through 2049 MUST be UTCTime
//! - bad_utctime_no_seconds: RFC 5280 s4.1.2.5.1: UTCTime seconds are mandatory
//! - bad_time_month_13: s4.1.2.5 profile of ISO 8601: month range
//! - bad_version_v2: RFC 5280 s4.1.2.1: v2 is rejected by this profile
//! - bad_negative_serial: RFC 5280 s4.1.2.2: serial MUST be positive
//! - bad_nonminimal_serial: X.690 s8.3.2: INTEGER minimality
//! - bad_nonminimal_length: X.690 s10.1: shortest length form is mandatory
//! - bad_boolean_01: X.690 s11.1: DER TRUE is 0xFF, 0x01 is BER
//! - bad_critical_false_encoded: X.690 s11.5: a DEFAULT value is encoded by ABSENCE
//! - bad_alg_mismatch: RFC 5280 s4.1.2.3: TBS signature must equal the outer algorithm
//! - bad_ed25519_params: RFC 8410 s3: the Ed25519 identifier has NO parameters
//! - bad_sig_unused_bits: RFC 5280 s4.1.1.3: the signature BIT STRING is whole octets
//! - bad_duplicate_ext: RFC 5280 s4.2: at most one instance of a particular extension
//! - bad_empty_san: RFC 5280 s4.2.1.6: SAN MUST contain at least one name
//! - bad_unsorted_set: X.690 s11.6: SET OF members sorted by encoding
//! - bad_unique_id: RFC 5280 s4.1.2.8: unique identifiers MUST NOT be generated
//! - bad_oid_padded_arc: X.690 s8.19.2: no 0x80 padding octet in an OID arc
//! - bad_pathlen_without_ca: RFC 5280 s4.2.1.9: pathLenConstraint requires cA TRUE

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[int] {
    hex.decode(h) else List[int]()
}

fn parses(b: List[int]) -> bool {
    let c = cert.parse(b) else |_| {
        return false
    }
    c.version > 0
}

fn main() -> int {
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_gentime_pre2050")
        return 1
    }
    print("rejected: bad_gentime_pre2050")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_utctime_no_seconds")
        return 1
    }
    print("rejected: bad_utctime_no_seconds")
    if parses(
        bytes_of(
            "",
