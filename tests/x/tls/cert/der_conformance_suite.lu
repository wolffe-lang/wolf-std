    ) {
        print("accepted: bad_version_v2")
        return 1
    }
    print("rejected: bad_version_v2")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_negative_serial")
        return 1
    }
    print("rejected: bad_negative_serial")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_nonminimal_serial")
        return 1
    }
    print("rejected: bad_nonminimal_serial")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_nonminimal_length")
        return 1
    }
    print("rejected: bad_nonminimal_length")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_boolean_01")
        return 1
    }
    print("rejected: bad_boolean_01")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_critical_false_encoded")
        return 1
    }
    print("rejected: bad_critical_false_encoded")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_alg_mismatch")
        return 1
    }
    print("rejected: bad_alg_mismatch")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_ed25519_params")
        return 1
    }
    print("rejected: bad_ed25519_params")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_sig_unused_bits")
        return 1
    }
    print("rejected: bad_sig_unused_bits")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_duplicate_ext")
        return 1
    }
    print("rejected: bad_duplicate_ext")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_empty_san")
        return 1
    }
    print("rejected: bad_empty_san")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_unsorted_set")
        return 1
    }
    print("rejected: bad_unsorted_set")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_unique_id")
        return 1
    }
    print("rejected: bad_unique_id")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_oid_padded_arc")
        return 1
    }
    print("rejected: bad_oid_padded_arc")
    if parses(
        bytes_of(
            "",
        ),
    ) {
        print("accepted: bad_pathlen_without_ca")
        return 1
    }
    print("rejected: bad_pathlen_without_ca")
    print("conformance: 18 clauses, 18 named rejections")
    0
}
