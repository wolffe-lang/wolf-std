//! check: run(exit=1, stdout="witness: leaf does not chain to the supplied anchor\nerror: issuer_mismatch")
//! phase: run
//! conforms: std.x.tls.cert, err.row, err.propagate, err.else
//!
//! WRONG TRUST ANCHOR, by name (RFC 5280 s6.1's name chaining): the
//! valid pinned leaf against a DIFFERENT Ed25519 CA (other_root) —
//! the leaf's issuer Name bytes do not equal the anchor's subject
//! Name bytes, so the chain answers `issuer_mismatch` before any
//! signature is attempted.

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[byte] {
    hex.decode(h) else List[byte]()
}

fn rejects(chain: List[byte], host: str, anchor: List[byte], now: int) -> bool {
    let c = cert.validate_chain(chain, host, anchor, now) else |_| {
        return true
    }
    c.version < 0
}

fn main() -> !int {
    let chain = bytes_of(
        "",
    )
    let host = "wolf.example"
    let anchor = bytes_of(
        "",
    )
    let now = cert.timestamp(2026, 8, 27, 12, 0, 0)
    assert(rejects(chain, host, anchor, now), "the chain must reject")
    print("witness: leaf does not chain to the supplied anchor")
    let never = cert.validate_chain(chain, host, anchor, now)?
    print("unreachable: {never.version}")
    0
}
