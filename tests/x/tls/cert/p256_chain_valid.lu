//! check: run(exit=0, stdout="witness: P-256 (ECDSA) certificate validates through sc22")
//! phase: run
//! conforms: std.x.tls.cert, std.x.crypto.p256
//!
//! THE sc23 INTEGRATION WITNESS (the sprint's flagship): an ECDSA-P256
//! certificate — the algorithm real-world CAs issue — VALIDATES through
//! sc22's chain validator, where sc22 answered `unsupported_alg`. The
//! self-signed prime256v1 / ecdsa-with-SHA256 cert (openssl-generated,
//! `vendor/vectors/pki/ecdsa.hex`, `openssl verify` OK) is used as leaf
//! and trust anchor; `validate_chain` runs sc23's `p256.verify_der`
//! over the TBS bytes and returns the parsed leaf. NATIVE-ONLY: the
//! verification is two table-free P-256 ladders, past lupin's 50M step
//! budget and the checked tier's (the ledger records both
//! `unsupported`).

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[int] {
    hex.decode(h) else List[int]()
}

fn main() -> int {
    let ec = bytes_of(
        "",
    )
    let now = cert.timestamp(2026, 10, 1, 0, 0, 0)
    let leaf = cert.validate_chain(ec, "ecdsa.wolf.example", ec, now) else |_| {
        print("P-256 chain rejected (should validate)")
        return 1
    }
    if !(leaf.subject_cn == "ecdsa.wolf.example") {
        print("wrong subject: {leaf.subject_cn}")
        return 1
    }
    if !leaf.has_san {
        print("SAN missing")
        return 1
    }
    if !(cert.alg_name(leaf.sig_alg) == "ecdsa") {
        print("wrong sig alg classification")
        return 1
    }
    print("witness: P-256 (ECDSA) certificate validates through sc22")
    0
}
