//! check: run(exit=1, stdout="witness: unrecognized critical extension present\nerror: unknown_critical")
//! phase: run
//! conforms: std.x.tls.cert, err.row, err.propagate, err.else
//!
//! UNKNOWN CRITICAL EXTENSION, by name (RFC 5280 s4.2: a
//! certificate-using system MUST reject a certificate containing a
//! critical extension it does not recognize): critext.hex carries
//! critical 1.3.6.1.4.1.55555.1 — it PARSES (the structure is sound;
//! the parse/validate split), and validation rejects it by name. The
//! same extension NON-critical is carried and ignored (s4.2's other
//! half, held by parse_fields.lu).

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[int] {
    hex.decode(h) else List[int]()
}

fn rejects(chain: List[int], host: str, anchor: List[int], now: int) -> bool {
    let c = cert.validate_chain(chain, host, anchor, now) else |_| {
        return true
    }
    c.version < 0
}

fn main() -> !int {
    let chain = bytes_of(
        "",
    )
    let host = "critext.wolf.example"
    let anchor = bytes_of(
        "",
    )
    let now = cert.timestamp(2026, 8, 27, 12, 0, 0)
    assert(rejects(chain, host, anchor, now), "the chain must reject")
    print("witness: unrecognized critical extension present")
    let never = cert.validate_chain(chain, host, anchor, now)?
    print("unreachable: {never.version}")
    0
}
