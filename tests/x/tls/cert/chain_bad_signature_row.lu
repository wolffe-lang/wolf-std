//! check: run(exit=1, stdout="witness: flipped signature byte fails Ed25519 verify\nerror: bad_signature")
//! phase: run
//! conforms: std.x.tls.cert, err.row, err.propagate, err.else, std.x.crypto.curve25519
//!
//! BAD SIGNATURE, by name: the pinned leaf with its LAST signature
//! byte flipped — the DER still parses (the mutation is inside the
//! signature BIT STRING's content), every structural check passes,
//! and sc18's Ed25519 verification answers false, so the chain
//! rejects `bad_signature`. Two verifications run (the else-witness
//! half and the riding half) — the heaviest negative by design.

use std.hex
use std.x.tls.cert

fn bytes_of(h: str) -> List[int] {
    hex.decode(h) else List[int]()
}

fn rejects(chain: List[int], host: str, anchor: List[int], now: int) -> bool {
    let c = cert.validate_chain(chain, host, anchor, now) else |_| {
        return true
    }
    c.version < 0
}

fn main() -> !int {
    let leaf_der = bytes_of(
        "",
    )
    var chain = List[int]()
    var i = 0
    for b in leaf_der {
        if i == leaf_der.len - 1 {
            (mut chain).push((b + 1) % 256)
        } else {
            (mut chain).push(b)
        }
        i = i + 1
    }
    let host = "wolf.example"
    let anchor = bytes_of(
        "",
    )
    let now = cert.timestamp(2026, 8, 27, 12, 0, 0)
    assert(rejects(chain, host, anchor, now), "the chain must reject")
    print("witness: flipped signature byte fails Ed25519 verify")
    let never = cert.validate_chain(chain, host, anchor, now)?
    print("unreachable: {never.version}")
    0
}
