//! check: run(exit=trap(assert))
//! phase: run
//! conforms: std.testing, std.str, conf.trap.assert
//!
//! A missing prefix traps `assert` after one line. Its own entry file.
//! Note the input: a non-ASCII string probed with an ASCII prefix is a
//! MISS and never a `bounds` trap, which is the whole reason this
//! assertion is writable.

use std.x.testing_text

fn main() -> !int {
    testing_text.assert_starts_with("héllo", "x")
    0
}
