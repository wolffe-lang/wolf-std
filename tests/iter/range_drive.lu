//! check: run(exit=0, stdout="sum 6, after 3")
//! phase: run
//! conforms: std.iter
//!
//! The F1 prototype executing: a RangeIter driven by explicit
//! `range_next(mut it)` calls under a `loop`-shaped `while`, the row
//! tag `done` as the end signal consumed by `else |_|`. This is the
//! shape the iterator filing proposes as `next(mut self) -> T ! {done}`
//! — free-fn spelling and `done` casing per the module's interim notes
//! (F-0002, F-0003). lupin executes it; wolfc rejects the MODULE at the
//! mem rung (E1001 — list_next's List reads count as moves, F-0005
//! freight from the sibling prototype), honestly ledgered.

use std.iter

fn main() -> !int {
    var it = iter.range_iter(0, 4)
    var sum = 0
    var going = true
    while going {
        let v = iter.range_next(mut it) else |_| {
            going = false
            0
        }
        sum = sum + v
    }
    // Exhausted stays exhausted: the next call is done again.
    let after = iter.range_next(mut it) else 3
    print("sum {sum}, after {after}")
    if sum == 6 && after == 3 { 0 } else { 1 }
}
