//! check: run(exit=0)
//! phase: run
//! conforms: std.str, std.fmt, type.char, mem.str
//! Additive C-compatible widths; clusters protect cuts, not emoji shaping.

use std.str
use std.fmt

fn main() -> !int {
    assert(str.display_width("")? == 0)
    assert(str.display_width("aé中")? == 4)
    assert(str.display_width("e\u{301}")? == 1)
    assert(str.display_width("🇺🇸")? == 2)
    assert(str.display_width("🇺🇸🇬")? == 3)
    assert(str.display_width("👩‍💻")? == 4)
    assert(str.display_width("❤️")? == 1)
    assert(str.display_width("❤︎")? == 1)
    assert(str.display_width("1\u{FE0F}\u{20E3}")? == 1)
    assert(str.display_width("\0")? == 0)
    assert((str.display_width("x\t") else 99) == 99)
    assert((str.display_width("\n") else 99) == 99)
    assert(str.truncate_display("e\u{301}中x", 1)? == "e\u{301}")
    assert(str.truncate_display("e\u{301}中x", 2)? == "e\u{301}")
    assert(str.truncate_display("e\u{301}中x", 3)? == "e\u{301}中")
    assert(str.truncate_display("🇺🇸🇬", 1)? == "")
    assert(str.truncate_display("🇺🇸🇬", 2)? == "🇺🇸")
    assert(str.truncate_display("👩‍💻x", 3)? == "")
    assert(str.truncate_display("👩‍💻x", 4)? == "👩‍💻")
    assert(str.truncate_display("❤️x", 1)? == "❤️")
    assert(str.truncate_display("\u{301}\0x", 0)? == "\u{301}\0")
    assert(str.truncate_display("", 0)? == "")
    assert((str.truncate_display("a\t", 0) else "bad") == "bad")
    assert(str.pad_display_left("e\u{301}", 3)? == "  e\u{301}")
    assert(str.pad_display_right("中", 3)? == "中 ")
    assert(str.pad_display_right("👩‍💻", 3)? == "👩‍💻")
    assert(str.pad_display_left("🇺🇸", 3)? == " 🇺🇸")
    assert(str.pad_display_right("❤️", 2)? == "❤️ ")
    assert(str.pad_display_left("", 2)? == "  ")
    assert((str.pad_display_left("\r", 2) else "bad") == "bad")
    assert((str.pad_display_right("\r", 0) else "bad") == "bad")
    let accents = str.graphemes("e\u{301}中")
    assert(accents.len == 2)
    assert(accents[0] == "e\u{301}")
    let flags = str.graphemes("🇺🇸🇬")
    assert(flags.len == 2)
    assert(flags[0] == "🇺🇸")
    assert(flags[1] == "🇬")
    assert(str.graphemes("👩‍💻").len == 1)
    assert(str.graphemes("\r\n").len == 1)
    assert(str.graphemes("").len == 0)
    assert(str.display_width("각")? == 2)
    assert(str.truncate_display("각x", 1)? == "")
    assert(str.truncate_display("각x", 2)? == "각")
    assert((str.display_width("\u{1B}[31mA") else 99) == 99)
    assert(fmt.pad_left("é", 3) == " é")
    assert(fmt.pad_right("中", 4) == "中 ")
    assert(str.pad_display_left("é", 3)? == "  é")
    assert(str.pad_display_right("中", 4)? == "中  ")
    0
}
