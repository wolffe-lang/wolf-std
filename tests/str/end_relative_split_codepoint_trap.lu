//! check: run(exit=trap(bounds))
//! phase: run
//! conforms: conf.trap.set, str.slice
//!
//! The trap half of `^n` (see `end_relative_slice.lu`): a from-end offset
//! is a BYTE offset, so one that lands inside a code point faults `bounds`
//! exactly as the forward spelling does (D25, `[conf.trap.set]`).
//! `"héllo"` is six bytes — h, é (two bytes at 1..3), l, l, o — so `^4`
//! names byte 2, the interior of é, and the slice below is the same fault
//! `slice_split_codepoint_traps.lu` pins at a forward offset. Measured
//! identical on all three lanes at the sc24 pins, message and clause
//! included ("byte range 2..6 splits a UTF-8 code point", [mem.ub.defined]).

fn main() -> !int {
    let s = "héllo"
    let bad = s[^4..]
    str_len(bad)
}

fn str_len(s: str) -> int {
    s.len
}
