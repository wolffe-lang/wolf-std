//! check: run(exit=0)
//! phase: run
//! conforms: std.str, str.find
//!
//! `find`, `rfind`, `find_all` and `count` — the search family, including
//! the three edges each one has to get right: the empty needle (0 for
//! `find`, `len` for `rfind`, nothing for `find_all`, zero for `count`), a
//! needle longer than the haystack (a miss, never a fault), and overlapping
//! candidates (`count` and `find_all` skip past each match, so "aaa"
//! contains one "aa").
//!
//! Every offset asserted here is a code-point boundary, and the multi-byte
//! fixtures are the point: `find("héllo", "l")` is 3, not 2, because the
//! answer is a BYTE offset (D25) — a function that returned 2 would be
//! counting characters and lying about the unit.

use std.str

fn main() -> !int {
    if (str.find("the wolf runs", "wolf") else 0 - 1) == 4 {} else { return 1 }
    if (str.find("the wolf runs", "the") else 0 - 1) == 0 {} else { return 2 }
    if (str.find("the wolf runs", "moon") else 0 - 1) == 0 - 1 {} else { return 3 }
    if (str.find("wolf", "wolf-lang") else 0 - 1) == 0 - 1 {} else { return 4 }
    if (str.find("", "x") else 0 - 1) == 0 - 1 {} else { return 5 }
    if (str.find("héllo", "l") else 0 - 1) == 3 {} else { return 6 }
    if (str.find("héllo", "é") else 0 - 1) == 1 {} else { return 7 }
    if (str.find("é🐺é", "🐺") else 0 - 1) == 2 {} else { return 8 }
    if (str.find("wolf", "") else 0 - 1) == 0 {} else { return 9 }
    if (str.find("", "") else 0 - 1) == 0 {} else { return 10 }
    if (str.rfind("a/b/c", "/") else 0 - 1) == 3 {} else { return 11 }
    if (str.rfind("a/b/c", "a") else 0 - 1) == 0 {} else { return 12 }
    if (str.rfind("a/b/c", "z") else 0 - 1) == 0 - 1 {} else { return 13 }
    if (str.rfind("héllo", "l") else 0 - 1) == 4 {} else { return 14 }
    if (str.rfind("wolf", "") else 0 - 1) == 4 {} else { return 15 }
    if (str.rfind("é", "") else 0 - 1) == 2 {} else { return 16 }
    if (str.rfind("aaa", "aa") else 0 - 1) == 1 {} else { return 17 }
    if str.count("a,b,c", ",") == 2 {} else { return 18 }
    if str.count("aaa", "aa") == 1 {} else { return 19 }
    if str.count("aaaa", "aa") == 2 {} else { return 20 }
    if str.count("wolf", "z") == 0 {} else { return 21 }
    if str.count("wolf", "") == 0 {} else { return 22 }
    if str.count("", "") == 0 {} else { return 23 }
    if str.count("é🐺é", "é") == 2 {} else { return 24 }
    // `find_all` is `count`'s witness: same matches, with their offsets.
    var seen = 0
    var sum = 0
    for at in str.find_all("a,b,c", ",") {
        seen = seen + 1
        sum = sum + at
    }
    if seen == 2 {} else { return 25 }
    if sum == 4 {} else { return 26 }
    var overlapping = 0
    for at in str.find_all("aaa", "aa") { overlapping = overlapping + at }
    if overlapping == 0 {} else { return 27 }
    var empty_needle = 0
    for at in str.find_all("wolf", "") { empty_needle = empty_needle + 1 }
    if empty_needle == 0 {} else { return 28 }
    var wide = 0
    for at in str.find_all("é🐺é", "é") { wide = wide + at }
    if wide == 6 {} else { return 29 }
    var missing = 0
    for at in str.find_all("wolf", "z") { missing = missing + 1 }
    if missing == 0 {} else { return 30 }
    0
}
