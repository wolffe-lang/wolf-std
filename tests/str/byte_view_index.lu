//! check: run(exit=0)
//! phase: run
//! conforms: str.views
//!
//! **The shape std could not write, and can now.** For two sprints
//! `s.bytes()[i]` read the receiver's own storage under native lowering,
//! answered correctly under lupin, and was refused by wolfc's checked
//! tier at `mem` (`unsupported — indexing outside the modelled surface`),
//! which is why `std.str`'s walks are `for`-and-counter and why this file
//! existed at all: to hold the refusal as a ledger row so the finding
//! could not rot. **F-0071 is CLOSED at the sc12 pin** (s88's #85, "a
//! temporary can be read from"), this row advanced from `unsupported` to
//! `run` on the checked lane, and the file goes on measuring the same
//! shapes from the other side.
//!
//! Three of s77's seven consuming positions are asserted here, and they
//! are exactly the three every lane models: INDEXING (`bs[i]`), the
//! recoverable `get`, and `count`. `len` has its own file
//! (`byte_view_walk.lu`, with iteration). The two that are still not
//! portable — `first` and `last`, which lupin has no `List` method for —
//! are `byte_view_first_last.lu`, whose lupin column is dark and says
//! why.
//!
//! What did NOT change with the closure is std's bodies. The one-pass
//! state machine `str.code_points` became is shorter than the
//! random-access walk it replaced, so nothing went back; the closure buys
//! a future body the option, not a rewrite of the ones that are already
//! better. `std.str`'s header says the same thing where a reader of the
//! code will meet it.
//!
//! No import: the surface under test is the language's own, exactly as in
//! `slice_oob_traps.lu`.

fn offset_of_last_lead(s: str) -> int {
    let n = s.len
    var at = 0 - 1
    var i = 0
    while i < n {
        let b = s.bytes()[i]
        if b < 128 as byte || b > 191 as byte {
            at = i
        }
        i = i + 1
    }
    at
}

fn lead_bytes_by_get(s: str) -> int {
    let n = s.len
    var leads = 0
    var i = 0
    while i < n {
        let b = s.bytes().get(i) else 0 as byte
        if b < 128 as byte || b > 191 as byte {
            leads = leads + 1
        }
        i = i + 1
    }
    leads
}

fn main() -> !int {
    if offset_of_last_lead("héllo") == 5 {} else { return 1 }
    if offset_of_last_lead("é🐺") == 2 {} else { return 2 }
    if offset_of_last_lead("") == 0 - 1 {} else { return 3 }
    if offset_of_last_lead("wolf") == 3 {} else { return 4 }
    // `get` on the view: the same read, recoverable, and out of range is
    // a miss rather than a fault.
    if lead_bytes_by_get("héllo") == 5 {} else { return 5 }
    if lead_bytes_by_get("é🐺") == 2 {} else { return 6 }
    if ("wolf".bytes().get(9) else (0 - 1) as byte) == (0 - 1) as byte {} else { return 7 }
    // `count` agrees with `len`, which is the position that never needed
    // a finding.
    if "héllo".bytes().count() == 6 {} else { return 8 }
    if "héllo".bytes().count() == "héllo".bytes().len {} else { return 9 }
    if "".bytes().count() == 0 {} else { return 10 }
    0
}
