//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.fs, comptime.sandbox, comptime.sandbox.fs, os.fs.access
//!
//! **D33 for `fs.access` (sc72, wolf 0.2.35), held one level down at
//! `fs_access`**: a compile may not ask the filesystem what this process
//! may do, any more than read a file. The row is handled locally
//! (F-0069).

use std.fs

comptime fn probe() -> int {
    fs_access(".", 0) else |_| { return 1 }
    0
}

fn main() -> !int {
    const P = probe()
    print("p: {P} {fs.join("a", "b")}")
    0
}
