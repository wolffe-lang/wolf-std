//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.fs, comptime.sandbox, comptime.sandbox.fs, os.fs.lock
//!
//! **D33 for `fs.lock` (sc72, wolf 0.2.35), held one level down at
//! `fs_lock`**: a lock is a host file's state, `fs`. The row is handled
//! locally (F-0069).

use std.fs

comptime fn probe() -> int {
    fs_lock(3, 1) else |_| { return 1 }
    0
}

fn main() -> !int {
    const P = probe()
    print("p: {P} {fs.LOCK_SHARED}")
    0
}
