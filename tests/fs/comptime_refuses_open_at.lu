//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.fs, comptime.sandbox, comptime.sandbox.fs, os.fs.at.open
//!
//! **D33 for `fs.open_at` (wolf-std#141), held one level down at
//! `fs_open_at`**: a compile may not open a name in a held directory. The row is handled
//! locally (F-0069). `main` names `fs.open_at` in a call the typecheck
//! phase never runs, to keep the import used.

use std.fs

comptime fn probe() -> int {
    fs_open_at(3, "x", 0, 0) else |_| { return 1 }
    0
}

fn main() -> !int {
    const Z = probe()
    let d = fs.stdin()
    var f = fs.open_at(d, "x", 0, 0) else |_| { fs.stdin() }
    fs.close(take f) else |_| {}
    print("z: {Z}")
    0
}
