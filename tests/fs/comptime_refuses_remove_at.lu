//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.fs, comptime.sandbox, comptime.sandbox.fs, os.fs.at.remove
//!
//! **D33 for `fs.remove_at` (wolf-std#141), held one level down at
//! `fs_remove_at`**: a compile may not remove a name from a held directory. The row is handled
//! locally (F-0069). `main` names `fs.remove_at` in a call the typecheck
//! phase never runs, to keep the import used.

use std.fs

comptime fn probe() -> int {
    fs_remove_at(3, "x") else |_| { return 1 }
    0
}

fn main() -> !int {
    const Z = probe()
    let d = fs.stdin()
    fs.remove_at(d, "x") else |_| {}
    print("z: {Z}")
    0
}
