//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.fs, comptime.sandbox, comptime.sandbox.fs, os.fs.sync
//!
//! **D33 for `fs.sync` (sc69), held one level down at `fs_sync`**: a
//! compile may not flush a file to a disk, any more than it may write
//! one. The row is handled locally (F-0069); `fs.sync` named in `main`
//! keeps the import used (it never runs: the row stops at typecheck).

use std.fs

comptime fn probe() -> int {
    fs_sync(1) else |_| { return 1 }
    0
}

fn main() -> !int {
    const P = probe()
    var f = fs.stdout()
    fs.sync(mut f) else |_| {}
    print("p: {P}")
    0
}
