//! check: run(exit=0, stdout="mode_8=invalid\nmode_negative=invalid\nexists=ok\nread=ok\nwrite=ok\nread_write=ok\nexecute=denied\nexecute_after_mode=ok\ndirectory_rwx=ok\nmissing=not_found\ndangling=not_found\nunder_a_file=io")
//! phase: run
//! conforms: std.fs, os.fs.access, os.fs.mode, os.fs.symlink, err.row
//!
//! **sc72: `fs.access`** (wolf 0.2.35's s254, wolf-lang#820,
//! `[os.fs.access]`). The two shape rows (`mode` 8, -1) are `invalid`
//! before the host, on every host. Then a file this row wrote: it exists,
//! reads, writes, reads and writes, and does NOT execute (`denied`: no
//! execute bit is set, which is the host's rule for root too); after
//! `set_mode(0o755)` it executes. This directory (`.`) reads, writes and
//! is searched. A missing name and a dangling link are `not_found`; a name
//! under a file is `io` (`ENOTDIR`). Nothing here asks a question whose
//! answer depends on who runs the row: the rig's container runs it as
//! root, CI's runners as a user.
//!
//! **windows** answers `unsupported` by name after the mode's check (its
//! permission is an access-control list): the row prints its host lines
//! for that reason. **lupin** 0.1.56 does not resolve `fs_access`
//! (wolf-interp#278).

use std.fs

fn row(path: str, mode: int) -> str {
    fs.access(path, mode) else |e| {
        return match e {
            denied => "denied",
            invalid => "invalid",
            io => "io",
            not_found => "not_found",
            unsupported => "unsupported",
        }
    }
    "ok"
}

fn host_lines() {
    print("exists=ok")
    print("read=ok")
    print("write=ok")
    print("read_write=ok")
    print("execute=denied")
    print("execute_after_mode=ok")
    print("directory_rwx=ok")
    print("missing=not_found")
    print("dangling=not_found")
    print("under_a_file=io")
}

fn main() -> !int {
    // The lanes share the staged root; clear what a refused lane left.
    fs.remove("sc72-access-dangling.tmp") else |_| {}
    fs.write_text("sc72-access.tmp", "x")?
    fs.set_mode("sc72-access.tmp", 0o644) else |_| {}
    print("mode_8={row("sc72-access.tmp", 8)}")
    print("mode_negative={row("sc72-access.tmp", 0 - 1)}")
    let exists = row("sc72-access.tmp", 0)
    if exists == "unsupported" {
        host_lines()
        fs.remove("sc72-access.tmp")?
        return 0
    }
    print("exists={exists}")
    print("read={row("sc72-access.tmp", 4)}")
    print("write={row("sc72-access.tmp", 2)}")
    print("read_write={row("sc72-access.tmp", 6)}")
    print("execute={row("sc72-access.tmp", 1)}")
    fs.set_mode("sc72-access.tmp", 0o755)?
    print("execute_after_mode={row("sc72-access.tmp", 1)}")
    print("directory_rwx={row(".", 7)}")
    print("missing={row("sc72-access-none.tmp", 0)}")
    fs.symlink("sc72-access-none.tmp", "sc72-access-dangling.tmp")?
    print("dangling={row("sc72-access-dangling.tmp", 0)}")
    print("under_a_file={row("sc72-access.tmp/x", 0)}")
    fs.remove("sc72-access-dangling.tmp")?
    fs.remove("sc72-access.tmp")?
    0
}
