//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.fs, comptime.sandbox, comptime.sandbox.fs, os.fs.at.mkdir
//!
//! **D33 for `fs.create_dir_at` (wolf-std#141), held one level down at
//! `fs_create_dir_at`**: a compile may not make a directory in a held directory. The row is handled
//! locally (F-0069). `main` names `fs.create_dir_at` in a call the typecheck
//! phase never runs, to keep the import used.

use std.fs

comptime fn probe() -> int {
    fs_create_dir_at(3, "x", 0o755) else |_| { return 1 }
    0
}

fn main() -> !int {
    const Z = probe()
    let d = fs.stdin()
    fs.create_dir_at(d, "x", 0o755) else |_| {}
    print("z: {Z}")
    0
}
