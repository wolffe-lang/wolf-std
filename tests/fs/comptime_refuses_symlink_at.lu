//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.fs, comptime.sandbox, comptime.sandbox.fs, os.fs.at.symlink
//!
//! **D33 for `fs.symlink_at` (wolf-std#141), held one level down at
//! `fs_symlink_at`**: a compile may not make a link in a held directory. The row is handled
//! locally (F-0069). `main` names `fs.symlink_at` in a call the typecheck
//! phase never runs, to keep the import used.

use std.fs

comptime fn probe() -> int {
    fs_symlink_at("t", 3, "x") else |_| { return 1 }
    0
}

fn main() -> !int {
    const Z = probe()
    let d = fs.stdin()
    fs.symlink_at("t", d, "x") else |_| {}
    print("z: {Z}")
    0
}
