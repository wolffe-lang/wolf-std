//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.fs, comptime.sandbox, comptime.sandbox.fs, os.fs.nonblock
//!
//! **D33 for `fs.set_nonblock` (sc72, wolf 0.2.35), held one level down
//! at `fs_set_nonblock`**: a handle's flag is an open file's state, `fs`.
//! The row is handled locally (F-0069).

use std.fs

comptime fn probe() -> int {
    fs_set_nonblock(3, true) else |_| { return 1 }
    0
}

fn main() -> !int {
    const P = probe()
    print("p: {P} {fs.NOFOLLOW}")
    0
}
