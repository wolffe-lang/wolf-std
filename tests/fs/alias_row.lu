//! check: run(exit=0, stdout="through alias: -1 | tag: not_found | expanded: -1")
//! phase: run
//! conforms: std.fs, type.err.alias, type.err.alias.transparent, type.err.alias.diag, err.row, err.propagate, err.else
//!
//! **The io tier's alias, witnessed against std.fs's own row and not
//! yet written into it.** `[type.err.alias]` (s158, wolf-lang#36 — the
//! filing sc06 measured the case for as F-0041) makes `error IoErrors =
//! {not_found, denied, io}` a SPELLING of the row fifteen `std.fs`
//! signatures carry, the same type in both directions with no
//! conversion. Both directions are what this file pins: a function
//! declared `-> int ! IoErrors` propagates `fs.size`'s expanded row
//! through `?` unchanged (`size` carries exactly the three tags —
//! `read_text` carries `utf8` too, and E0602 said so on the first
//! draft), and a function declared with the expanded row
//! propagates the ALIAS row back through `?`; the handler over either
//! matches TAGS, because the diagnostic and the type both expand the
//! alias (`[type.err.alias.diag]`). The tag that fires is the host's
//! honest `not_found` for a path under a directory that does not exist.
//!
//! **The alias now lives in `std/fs/fs.lu`, and this row witnesses it
//! from outside (sc51).** At the 0.2.14 / lupin 0.1.36 pin the alias
//! could not be written into the module: lupin conformed to `a7f517e`
//! (v0.2.12), refused `error IoErrors = {…}` at PARSE, and a parse
//! refusal is not lazy — one `error` line in `std/fs/fs.lu` turned every
//! lupin importer of the module red, `fs/path_helpers.lu` included, a row
//! that never names the alias. So sc48 witnessed the clause here with a
//! LOCAL declaration, at the cost of one row instead of eighteen.
//!
//! Re-measured at lupin 0.1.37 (sc51): the parse refusal is GONE. With the
//! alias inside the module, all nineteen lupin importers of `std.fs` reach
//! RESOLVE and decline for the ordinary reason (no `fs_*` builtins on that
//! declaration is KEPT, and here is why, measured: naming the module's
//! alias from outside — `-> int ! fs.IoErrors` — does NOT expand at this
//! pin. wolf 0.2.15 answers E0602, "this can also fail with `denied`,
//! `io`, `not_found`, which `size_through_alias`'s row does not include",
//! so the qualified spelling resolves to a row WITHOUT the alias's tags.
//! Transparency holds inside the module and does not cross the module
//! boundary. Filed as F-0138; std/fs's own fourteen signatures are
//! unaffected, because they name the alias unqualified in its own file,
//! and callers see the expanded row either way.

use std.fs

error IoErrors = {not_found, denied, io}

fn size_through_alias(path: str) -> int ! IoErrors {
    fs.size(path)?
}

fn size_expanded(path: str) -> int ! {not_found, denied, io} {
    size_through_alias(path)?
}

fn main() -> !int {
    let absent = "no-such-dir/absent.txt"
    let a = size_through_alias(absent) else |e| match e {
        not_found => 0 - 1,
        denied => 0 - 2,
        io => 0 - 3,
    }
    var tag = "none-fired"
    let b = size_expanded(absent) else |e| match e {
        not_found => {
            tag = "not_found"
            0 - 1
        },
        denied => {
            tag = "denied"
            0 - 2
        },
        io => {
            tag = "io"
            0 - 3
        },
    }
    print("through alias: {a} | tag: {tag} | expanded: {b}")
    if a != 0 - 1 { return 1 }
    if tag != "not_found" { return 2 }
    if b != 0 - 1 { return 3 }
    0
}
