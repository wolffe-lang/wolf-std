//! check: fail(E0701)
//! phase: typecheck
//! conforms: std.env, comptime.sandbox, comptime.sandbox.env
//!
//! **D33 for `env.unset` (wolf-lang s225), held one level down at
//! `env_unset`**: removing a variable from the COMPILER's environment
//! changes the process context the compiler runs in — the sandbox
//! table's `env` reason, with `env_set` and `os_chdir`. The row is
//! handled locally (F-0069) and the facade is called at run time to keep
//! the import used.

use std.env

comptime fn probe() -> int {
    env_unset("HOME") else |_| {}
    0
}

fn main() -> !int {
    const Z = probe()
    let key = env.entry_key("A=B")
    print("key: {key} z: {Z}")
    0
}
