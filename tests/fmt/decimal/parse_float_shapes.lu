//! check: run(exit=0)
//! phase: run
//! conforms: std.fmt.decimal
//!
//! `parse_float` — sc03's shape test, re-homed with the function and
//! strengthened by what changed underneath it. sc03's version accumulated
//! digits with `acc * 10.0 + digit` and documented the result as "honest
//! rather than perfect"; this one is CORRECTLY ROUNDED, so the hard
//! inputs are assertions instead of caveats: 17-digit significands, the
//! exponent extremes, the halfway subnormal, and a value whose text is
//! thirty digits long.
//!
//! The accepted shape is still strict: no whitespace, no separators, no
//! `0x`, and no `inf`/`nan` spellings — those are values a program can
//! write, not text a caller should be able to smuggle.

use std.fmt.decimal
use std.math.float

fn main() -> !int {
    // Shapes that parse.
    if (decimal.parse_float("1.5") else 0.0) == 1.5 {} else { return 1 }
    if (decimal.parse_float("-2.25") else 0.0) == -2.25 {} else { return 2 }
    if (decimal.parse_float("3") else 0.0) == 3.0 {} else { return 3 }
    if (decimal.parse_float("+3") else 0.0) == 3.0 {} else { return 4 }
    if (decimal.parse_float("0.5") else 0.0) == 0.5 {} else { return 5 }
    if (decimal.parse_float(".5") else 0.0) == 0.5 {} else { return 6 }
    if (decimal.parse_float("5.") else 0.0) == 5.0 {} else { return 7 }
    if (decimal.parse_float("1e2") else 0.0) == 100.0 {} else { return 8 }
    if (decimal.parse_float("1E2") else 0.0) == 100.0 {} else { return 9 }
    if (decimal.parse_float("5e-1") else 0.0) == 0.5 {} else { return 10 }
    if (decimal.parse_float("5e+1") else 0.0) == 50.0 {} else { return 11 }
    if (decimal.parse_float("0") else 1.0) == 0.0 {} else { return 12 }
    if (decimal.parse_float("0.0") else 1.0) == 0.0 {} else { return 13 }
    // Shapes that miss.
    if (decimal.parse_float("") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 14 }
    if (decimal.parse_float("x") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 15 }
    if (decimal.parse_float("1.2.3") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 16 }
    if (decimal.parse_float(" 1.5") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 17 }
    if (decimal.parse_float("1.5 ") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 18 }
    if (decimal.parse_float("1e") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 19 }
    if (decimal.parse_float(".") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 20 }
    if (decimal.parse_float("1_000.0") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 21 }
    if (decimal.parse_float("inf") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 22 }
    if (decimal.parse_float("nan") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 23 }
    if (decimal.parse_float("é") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 24 }
    // Overflow is a row (`overflow`); underflow is IEEE's signed zero.
    if (decimal.parse_float("1e400") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 25 }
    if (decimal.parse_float("-1e400") else 0.0 - 1.0) == 0.0 - 1.0 {} else { return 26 }
    if (decimal.parse_float("1e-400") else 1.0) == 0.0 {} else { return 27 }
    let tiny = decimal.parse_float("-1e-400") else 1.0
    if float.is_sign_negative(tiny) {} else { return 28 }
    // Correctly rounded, asserted through the bits.
    if float.to_bits(decimal.parse_float("0.1") else 0.0) == float.to_bits(0.1) {} else {
        return 29
    }
    if float.to_bits(decimal.parse_float("1e23") else 0.0) == float.to_bits(9.999999999999999e22) {} else {
        return 30
    }
    if float.to_bits(decimal.parse_float("5e-324") else 0.0) == 1 {} else { return 31 }
    if float.to_bits(decimal.parse_float("2.4703282292062327e-324") else 0.0) == 0 {} else {
        return 32
    }
    if float.to_bits(decimal.parse_float("2.4703282292062328e-324") else 0.0) == 1 {} else {
        return 33
    }
    if float.to_bits(decimal.parse_float("1.7976931348623157e308") else 0.0) == 9218868437227405311 {} else {
        return 34
    }
    // A significand longer than any double can hold, and a 9007199254740993
    // that rounds to its even neighbour.
    if float.to_bits(decimal.parse_float("123456789012345678901234567890") else 0.0) ==
        float.to_bits(1.2345678901234568e29) {} else { return 35 }
    if float.to_bits(decimal.parse_float("9007199254740993") else 0.0) ==
        float.to_bits(9007199254740992.0) {} else { return 36 }
    0
}
