//! check: run(exit=0, stdout="1 2 3 | 3 1 2\n-1 0 2.5 | 2.5\n2 | 1 2\n")
//! phase: run
//! conforms: std.sort, mem.list.slice
//!
//! wolf-std#23's returning combinators, executing: each `sorted_*`
//! answers its in-place twin's order and leaves its argument alone,
//! which is the whole difference between the two families and the only
//! thing a chain needs from them.
//!
//! Line 3 is the chain the Wolf Book's §5.2 has promised since bs00,
//! with the prefix spelled the way the language spells it — `[..2]`, a
//! slice, not a `take`. `fn take` is `E0008` on both machines (the
//! ownership verb owns the word), and the slice runs on all three lanes,
//! so there is nothing for a std function to add.
//!
//! `sorted_strs` is not exercised here: `<` on `str` is unsupported in
//! the native rung's string lowering and `tests/sort/strs_bytewise.lu`
//! already carries that lane's row.

use std.sort

fn main() -> !int {
    var xs = List[int]()
    (mut xs).push(3)
    (mut xs).push(1)
    (mut xs).push(2)
    let si = sort.sorted_ints(xs)
    print("{si[0]} {si[1]} {si[2]} | {xs[0]} {xs[1]} {xs[2]}")
    var fs = List[f64]()
    (mut fs).push(2.5)
    (mut fs).push(-1.0)
    (mut fs).push(0.0)
    let sf = sort.sorted_floats(fs)
    print("{sf[0]} {sf[1]} {sf[2]} | {fs[0]}")
    let top = sort.sorted_ints(xs)[..2]
    print("{top.len} | {top[0]} {top[1]}")
    0
}
