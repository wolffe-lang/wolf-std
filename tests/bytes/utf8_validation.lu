//! check: run(exit=0)
//! phase: run
//! conforms: std.bytes
//!
//! `is_utf8` — the predicate half of `to_str`, and the only function in std
//! that reads bytes as text in wolf source. It was the border post's
//! question without the border post's answer for four sprints; the answer
//! landed at sc13 (`to_str`, over s81's `str_from_utf8`) and the predicate
//! stayed hand-written, because it keeps a third lane the primitive has
//! not got (F-0075). `to_str_border.lu` is where the two are held to the
//! same answers; this file is where the wolf-source decoder is held to
//! the standard.
//!
//! Every rejection class the standard names gets a row, built byte by byte
//! because `str` cannot express any of them (that is the point): a stray
//! continuation byte, a truncated sequence, an OVERLONG form, a surrogate,
//! a scalar above U+10FFFF, and the bytes that begin no sequence at all
//! (C0, C1, F5..FF). A validator that only checked lengths would pass five
//! of these six.

use std.bytes

fn seq2(a: int, b: int) -> List[byte] {
    var out = List[byte]()
    (mut out).push(a as byte)
    (mut out).push(b as byte)
    out
}

fn seq3(a: int, b: int, c: int) -> List[byte] {
    var out = List[byte]()
    (mut out).push(a as byte)
    (mut out).push(b as byte)
    (mut out).push(c as byte)
    out
}

fn seq4(a: int, b: int, c: int, d: int) -> List[byte] {
    var out = List[byte]()
    (mut out).push(a as byte)
    (mut out).push(b as byte)
    (mut out).push(c as byte)
    (mut out).push(d as byte)
    out
}

fn main() -> !int {
    // Everything a `str` can hold is valid, by construction (D24).
    if bytes.is_utf8(bytes.from_str("")) {} else { return 1 }
    if bytes.is_utf8(bytes.from_str("wolf")) {} else { return 2 }
    if bytes.is_utf8(bytes.from_str("héllo 🐺")) {} else { return 3 }
    if bytes.is_utf8(bytes.from_str("\u{80}\u{7ff}\u{800}\u{ffff}\u{10000}\u{10ffff}")) {} else {
        return 4
    }
    // The shortest legal form of each width, spelled by hand.
    if bytes.is_utf8(seq2(194, 128)) {} else { return 5 }
    if bytes.is_utf8(seq3(224, 160, 128)) {} else { return 6 }
    if bytes.is_utf8(seq4(240, 144, 128, 128)) {} else { return 7 }
    if bytes.is_utf8(seq4(244, 143, 191, 191)) {} else { return 8 }
    // A stray continuation byte, alone and after a complete sequence.
    var stray = List[byte]()
    (mut stray).push(169 as byte)
    if bytes.is_utf8(stray) { return 9 }
    if bytes.is_utf8(seq3(195, 169, 169)) { return 10 }
    // Truncation: a lead byte whose continuations are missing.
    var lead_alone = List[byte]()
    (mut lead_alone).push(195 as byte)
    if bytes.is_utf8(lead_alone) { return 11 }
    if bytes.is_utf8(seq2(226, 130)) { return 12 }
    if bytes.is_utf8(seq3(240, 159, 144)) { return 13 }
    // A continuation slot filled by a non-continuation byte.
    if bytes.is_utf8(seq2(195, 65)) { return 14 }
    if bytes.is_utf8(seq3(226, 130, 65)) { return 15 }
    // Overlong forms: the same scalar encoded in more bytes than it needs.
    if bytes.is_utf8(seq2(192, 128)) { return 16 }
    if bytes.is_utf8(seq2(193, 191)) { return 17 }
    if bytes.is_utf8(seq3(224, 128, 128)) { return 18 }
    if bytes.is_utf8(seq3(224, 159, 191)) { return 19 }
    if bytes.is_utf8(seq4(240, 128, 128, 128)) { return 20 }
    if bytes.is_utf8(seq4(240, 143, 191, 191)) { return 21 }
    // Surrogates: U+D800..U+DFFF have no UTF-8 encoding at all.
    if bytes.is_utf8(seq3(237, 160, 128)) { return 22 }
    if bytes.is_utf8(seq3(237, 191, 191)) { return 23 }
    // The last code point before the surrogate block is fine.
    if bytes.is_utf8(seq3(237, 159, 191)) {} else { return 24 }
    // Above U+10FFFF.
    if bytes.is_utf8(seq4(244, 144, 128, 128)) { return 25 }
    if bytes.is_utf8(seq4(245, 128, 128, 128)) { return 26 }
    // Bytes that begin no sequence.
    var never = List[byte]()
    (mut never).push(255 as byte)
    if bytes.is_utf8(never) { return 27 }
    var also_never = List[byte]()
    (mut also_never).push(254 as byte)
    if bytes.is_utf8(also_never) { return 28 }
    // The two cases that used to sit here — an element above 255 and a
    // negative one — RETIRE at sc35 and their retirement is the point.
    // `is_utf8` answered `false` for a non-byte rather than trapping,
    // because a predicate a caller must guard is not a predicate. Its
    // parameter is `List[byte]` now, so there is no such element to
    // offer: the clause is unreachable rather than untested, and a test
    // that spelled one would not compile (E0401). `is_utf8`'s doc says
    // so, and the class has its own static witnesses elsewhere in the
    // tree (`tests/hex/encode_non_byte_refused.lu` and the six crypto
    // and TLS `non_byte_refused.lu` files).
    // A valid prefix followed by garbage is invalid as a whole.
    var mixed = List[byte]()
    (mut mixed).push(104 as byte)
    (mut mixed).push(195 as byte)
    (mut mixed).push(169 as byte)
    (mut mixed).push(192 as byte)
    if bytes.is_utf8(mixed) { return 31 }
    0
}
