//! check: run(exit=0, stdout="checked=16416\nmismatches=0\nold_modes_stay_old=true\nflow_bit=8\nextended_bit=16")
//! phase: run
//! conforms: std.term, os.term.mode
//!
//! **sc61: `pack(unpack(v)) == v` for every mode the runtime reports.**
//! The runtime reports bits 0..4 (canonical, echo, signals and, since wolf
//! 0.2.30, flow and extended) and `min` and `time` in 0..255: every flag
//! combination with every `min`, with every `time`, and with both at 255.
//! A mode without bits 3 and 4 (all wolf 0.2.29 reports) packs back
//! without them, so a round trip never writes a bit 0.2.29 refuses.

use std.term

fn miss(v: int) -> int {
    if term.pack(term.unpack(v)) == v {
        return 0
    }
    1
}

fn gains(v: int) -> bool {
    term.pack(term.unpack(v)) / 8 % 4 != 0
}

fn main() -> !int {
    var checked = 0
    var bad = 0
    var old_ok = true
    var flags = 0
    while flags < 32 {
        var n = 0
        while n < 256 {
            let a = flags + n * 256
            let b = flags + n * 65536
            checked = checked + 2
            bad = bad + miss(a) + miss(b)
            if flags < 8 && (gains(a) || gains(b)) {
                old_ok = false
            }
            n = n + 1
        }
        checked = checked + 1
        bad = bad + miss(flags + 255 * 256 + 255 * 65536)
        flags = flags + 1
    }
    print("checked={checked}")
    print("mismatches={bad}")
    print("old_modes_stay_old={old_ok}")
    let f = term.unpack(8)
    let e = term.unpack(16)
    let only_flow = f.flow && !f.extended && !f.canonical && !f.echo && !f.signals
    let only_ext = e.extended && !e.flow && !e.canonical && !e.echo && !e.signals
    var fb = -1
    if only_flow {
        fb = term.pack(f)
    }
    var eb = -1
    if only_ext {
        eb = term.pack(e)
    }
    print("flow_bit={fb}")
    print("extended_bit={eb}")
    0
}
