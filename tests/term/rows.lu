//! check: run(exit=0, stdout="packed=260\nround_trip=true\nraw_keeps_signals=true\nraw_clears_flow=true\nclamped=16776991")
//! phase: run
//! conforms: std.term, os.term.mode, err.row
//!
//! **s219: `std.term`'s pure half, on every host.** `raw` of a canonical
//! mode with echo, signals, flow and extended is not canonical, no echo,
//! signals kept, flow and extended cleared (sc61 R1, as `cfmakeraw(3)`),
//! `min` 1, `time` 0 — packed, 4 + 256 = 260, the mode wolf-lang's
//! `raw.lu` witness sets; `unpack` of a pack is the mode again (sc61:
//! flow and extended included); fields outside 0..255 are clamped, so
//! `pack` never makes an `invalid` mode.
//! A terminal itself is witnessed in wolf-lang's `ctrl_c_lanes.rs`.

use std.term

fn main() -> !int {
    let cooked = term.Mode {
        canonical: true,
        echo: true,
        signals: true,
        flow: true,
        extended: true,
        min: 1,
        time: 0,
    }
    let r = term.raw(cooked)
    let p = term.pack(r)
    print("packed={p}")
    let back = term.unpack(p)
    let three = back.canonical == r.canonical && back.echo == r.echo && back.signals == r.signals
    let flags = three && back.flow == r.flow && back.extended == r.extended
    let same = flags && back.min == r.min && back.time == r.time
    print("round_trip={same}")
    print("raw_keeps_signals={r.signals}")
    print("raw_clears_flow={!r.flow && !r.extended}")
    let wild = term.Mode {
        canonical: true,
        echo: true,
        signals: true,
        flow: true,
        extended: true,
        min: 999,
        time: 999,
    }
    print("clamped={term.pack(wild)}")
    0
}
